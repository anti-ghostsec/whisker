import { ListView, ScrollView, Palette, TextEdit, Switch, ComboBox } from "std-widgets.slint";
import { Theme, Prefs, TextTools, Avatar, AiBadge, Btn, IconBtn, Input, Pill } from "theme.slint";
import { SettingsPage, AccountForm, AgentForm, NavItem, ModelInfo, DeviceRow } from "settings.slint";
// Colour emoji for all text (a trimmed Noto Color Emoji: no letters, digits
// or spaces, so text still comes from the normal fonts). See assets/fonts.
import "../assets/fonts/WhiskerEmoji.ttf";

export { AccountForm, AgentForm, NavItem, Prefs, TextTools, ModelInfo }

// `initial`/`hue`/`avatar` are worked out in Rust so a name looks the same everywhere.
// A reaction offered in a message's menu. Menus don't use the window's
// colour emoji font, so the emoji shows as its picture next to a word.
export struct QuickReaction {
    emoji: string,
    label: string,
    icon: image,
}

export struct AccountItem {
    id: string,
    name: string,
    user-id: string,
    tags: string,
    is-agent: bool,
    initial: string,
    hue: int,
    avatar: image,
    unread: int,
}

export struct RoomItem {
    id: string,
    name: string,
    invite: bool,
    initial: string,
    hue: int,
    avatar: image,
    preview: string,
    time: string,
    unread: int,
    encrypted: bool,
    pinned: bool,
    // Spaces are folders: `space` rows hold the rooms below them (shown when
    // `open`); `depth` is how deep in folders a row is.
    depth: int,
    space: bool,
    open: bool,
    // A heading over a part of the list (People, Rooms…): `name` is its title.
    header: bool,
}

// A room in a public directory.
export struct PublicItem {
    id: string,
    name: string,
    alias: string,
    topic: string,
    members: string,
    initial: string,
    hue: int,
    avatar: image,
    joined: bool,
}

// Someone whose read receipt is on a message.
export struct Reader {
    user-id: string,
    name: string,
    initial: string,
    hue: int,
    avatar: image,
}

// One line of a message: 0 text, 1 quote, 2 code, 3 heading, 4 blank.
export struct Block {
    kind: int,
    plain: string,
    // Text with web links in it: drawn with the links clickable (it can't
    // be selected then; Copy in the menu still copies it).
    linked: bool,
    rich: styled-text,
}

// A folder or file in Whisker's own file list (Android, see picker.rs).
export struct PickEntry {
    name: string,
    // Size and date, for files.
    info: string,
    dir: bool,
    picked: bool,
    // "Up a folder".
    up: bool,
    // 1 picture, 2 video, 3 sound, 0 other.
    kind: int,
    // A small picture of it (photos and videos), once it's made.
    thumb: image,
}

// An emoji reaction under a message: how many, and whether one is ours.
// One answer of a poll.
export struct PollOption {
    id: string,
    text: string,
    count: int,
    // Of everyone who voted, how many picked it (0 to 1).
    share: float,
    mine: bool,
    // Counts may be seen (always, or once it ended).
    show-count: bool,
    // Ended, and picked most.
    winner: bool,
}

export struct ReactionChip {
    key: string,
    count: int,
    mine: bool,
    who: string,
    // What the emoji is, in words ("joy (tears, laugh, lol)"); may be empty.
    name: string,
    // The emoji as a colour picture (empty: draw the key as text).
    picture: image,
    // A picture of the sender's own (the key is its mxc:// address), shown
    // once it's loaded and never as its address.
    custom: bool,
}

// A room in the "Forward to…" list.
// A room listed in a space (the space page): joined or one you can join.
export struct SpaceRoomItem {
    id: string,
    name: string,
    topic: string,
    members: string,
    initial: string,
    hue: int,
    avatar: image,
    joined: bool,
    space: bool,
    busy: bool,
}

// Three dots that light up in turn: something is loading.
component Dots inherits HorizontalLayout {
    in property <color> color: white;
    alignment: center;
    spacing: 4px;
    for i in 3: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.color;
            opacity: mod(animation-tick() / 300ms - i, 3) < 1 ? 1.0 : 0.3;
        }
    }
}

export struct ForwardItem {
    id: string,
    name: string,
    initial: string,
    hue: int,
    avatar: image,
    sent: bool,
}

// One row of the emoji picker.
// An @-mention or :emoji: suggestion above the composer.
export struct Suggestion {
    label: string,
    detail: string,
    insert: string,
    kind: int,
    // For emoji: its colour picture.
    picture: image,
}

// One of your stickers, in the sticker picker.
export struct StickerItem {
    name: string,
    picture: image,
    // One of your custom emoji (clicking puts :name: in the message).
    emoji: bool,
}

// An emoji in the picker, with its colour picture.
export struct EmojiCell {
    symbol: string,
    picture: image,
}

export struct EmojiRow {
    items: [EmojiCell],
}

export struct MessageItem {
    id: string,
    // A room event ("Alice joined"), drawn as a small grey line.
    notice: bool,
    // Developer mode: what a room event changed, the first few lines, and
    // how many more there are.
    details: string,
    more-details: int,
    sender: string,
    name: string,
    body: string,
    blocks: [Block],
    mine: bool,
    // 1 you verified the sender, 2 verified but their identity changed since.
    trust: int,
    // Encrypted by a device its owner didn't verify (1, grey) or worse (2, red).
    shield: int,
    shield-text: string,
    time: string,
    initial: string,
    hue: int,
    avatar: image,
    // First message of a run by the same sender: shows avatar and name.
    first: bool,
    // Date divider shown above this message ("Today", "Yesterday", …), or "".
    day: string,
    faint: bool,
    edited: bool,
    reply-name: string,
    reply-text: string,
    // 0 none, 1 image, 2 video, 3 audio, 4 file
    media: int,
    media-name: string,
    media-info: string,
    picture: image,
    // Its preview couldn't be loaded (click to try again).
    picture-failed: bool,
    // Animated GIF/WebP: every frame, shown in turn (looping).
    frames: [image],
    frame-ms: int,
    // A message of only emoji: their pictures, drawn big instead of the text.
    big-emoji: [image],
    // A file message whose body is a caption, shown under the file.
    caption: bool,
    picture-width: length,
    picture-height: length,
    links: [string],
    // People who have read up to here (at most 5), and how many more.
    readers: [Reader],
    // Everyone, for the list (`readers` is the first few).
    all-readers: [Reader],
    more-readers: int,
    reactions: [ReactionChip],
    // A poll: `body` is its question.
    poll: bool,
    poll-options: [PollOption],
    poll-note: string,
    poll-ended: bool,
    // Ours and still open.
    poll-can-end: bool,
    // A thread's first message: how many replies, and the newest ("Bob: hi").
    thread-replies: int,
    thread-last: string,
    // A web link's preview: 0 none, 1 offered (tap to load), 2 loading, 3 shown.
    link-card: int,
    link-url: string,
    link-site: string,
    link-title: string,
    link-text: string,
    link-picture: image,
    // A video (YouTube…): a play mark over the picture.
    link-video: bool,
}

// A red wavy line under a misspelled word, in the composer's coordinates.
export struct SpellMark {
    x: length,
    y: length,
    w: length,
    path: string,
}

export struct MemberItem {
    user-id: string,
    name: string,
    initial: string,
    hue: int,
    avatar: image,
    role: string,
}

/// A file sent in the room, for the room panel's list.
export struct FileItem {
    id: string,
    name: string,
    detail: string,
    kind: string,
    image: bool,
}

export struct PinnedItem {
    who: string,
    text: string,
}

export struct RoomDetails {
    id: string,
    name: string,
    topic: string,
    alias: string,
    initial: string,
    hue: int,
    avatar: image,
    encrypted: bool,
    join-rule: string,
    history: string,
    members: string,
    can-edit: bool,
    can-set-avatar: bool,
    can-invite: bool,
}

// A user's profile card.
// One of someone's logins (devices).
export struct SessionItem {
    name: string,
    id: string,
    verified: bool,
}

export struct Profile {
    user-id: string,
    name: string,
    initial: string,
    hue: int,
    avatar: image,
    role: string,
    is-me: bool,
    can-kick: bool,
    can-ban: bool,
    // Their power level in the room (-1: a creator, which can't change),
    // whether you may change it, and the highest you may give.
    level: int,
    can-set-level: bool,
    max-level: int,
    has-dm: bool,
    // They get your read receipts (in chats with nobody else).
    sees-reads: bool,
    // 0 = no encryption keys to verify, 1 = not verified, 2 = verified,
    // 3 = verified before but their identity changed, -1 = checking
    verified: int,
    sessions: [SessionItem],
}


export struct EmojiItem {
    symbol: string,
    name: string,
}


component Blocks inherits VerticalLayout {
    in property <[Block]> blocks;
    in property <bool> faint;
    // Exact width the text gets. Passed down so wrapped text measures its
    // height at the width it will really have.
    in property <length> avail;
    callback link(string);
    // Phones: text with links takes every touch on it (Slint's StyledText
    // keeps them), so the message under it never saw a hold and its menu
    // couldn't be opened. There a layer over the text takes the touch
    // instead: `press` hands it on to the message (a hold opens its menu),
    // and a tap is `tapped` (the message opens its link).
    callback press(PointerEvent);
    callback tapped();
    // Text with links got or lost a selection (the menu's Copy then copies it).
    callback styled(bool);
    // Names this message's text for selecting across messages ("list|id").
    in property <string> key;
    // The text selected in one of the blocks ("" when none is).
    callback selected(string);
    spacing: 2px;
    for b[i] in root.blocks: VerticalLayout {
        if b.linked && (b.kind == 0 || b.kind == 1): HorizontalLayout {
            spacing: 8px;
            if b.kind == 1: Rectangle { width: 3px; border-radius: 2px; background: Theme.accent.transparentize(0.4); }
            StyledText {
                width: b.kind == 1 ? root.avail - 11px : root.avail;
                text: b.rich;
                default-color: b.kind == 1 || root.faint ? Theme.muted : Theme.text;
                link-color: Theme.accent;
                link-clicked(l) => { root.link(l); }
                // Selectable with the mouse, like the rest of the text (a
                // click that doesn't drag still follows a link).
                selectable: !Prefs.touch;
                selection-background-color: Theme.accent.transparentize(0.55);
                property <int> copy-asked: TextTools.copy-styled;
                changed copy-asked => { if self.has-selection { self.copy(); } }
                changed has-selection => { root.styled(self.has-selection); }
                if Prefs.touch: TouchArea {
                    pointer-event(e) => { root.press(e); }
                    clicked => { root.tapped(); }
                }
            }
        }
        if !b.linked && b.kind == 0: TextInput {
            width: root.avail;
            text: b.plain;
            read-only: true;
            // Touch screens: left to the row, so press-and-hold opens its menu.
            enabled: !Prefs.touch;
            accessible-description: "sel|" + root.key + "|" + (i + 1);
            single-line: false;
            wrap: word-wrap;
            color: root.faint ? Theme.muted : Theme.text;
            font-italic: root.faint;
            selection-background-color: Theme.accent.transparentize(0.55);
            changed cursor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
            changed anchor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
        }
        if !b.linked && b.kind == 1: HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 3px; border-radius: 2px; background: Theme.accent.transparentize(0.4); }
            TextInput {
                width: root.avail - 11px;
                text: b.plain;
                read-only: true;
                // Touch screens: left to the row, so press-and-hold opens its menu.
                enabled: !Prefs.touch;
            accessible-description: "sel|" + root.key + "|" + (i + 1);
                single-line: false;
                wrap: word-wrap;
                color: Theme.muted;
                selection-background-color: Theme.accent.transparentize(0.55);
                changed cursor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
                changed anchor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
            }
        }
        if b.kind == 2: Rectangle {
            background: Theme.raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 8px;
                TextInput {
                    width: root.avail - 16px;
                    text: b.plain;
                    read-only: true;
                    // Touch screens: left to the row, so press-and-hold opens its menu.
                    enabled: !Prefs.touch;
            accessible-description: "sel|" + root.key + "|" + (i + 1);
                    single-line: false;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                    color: Theme.text;
                    selection-background-color: Theme.accent.transparentize(0.55);
                    changed cursor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
                    changed anchor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
                }
            }
        }
        if b.kind == 3: TextInput {
            width: root.avail;
            text: b.plain;
            read-only: true;
            // Touch screens: left to the row, so press-and-hold opens its menu.
            enabled: !Prefs.touch;
            accessible-description: "sel|" + root.key + "|" + (i + 1);
            single-line: false;
            wrap: word-wrap;
            font-size: 17px;
            font-weight: 700;
            color: Theme.text;
            selection-background-color: Theme.accent.transparentize(0.55);
            changed cursor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
            changed anchor-position-byte-offset => { root.selected(TextTools.slice(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset)); }
        }
        if b.kind == 4: Rectangle { height: 6px; }
    }
}

// The video playing inside a message (one at a time).
export global Player {
    // The message it's in ("" for none).
    in-out property <string> id;
    in-out property <image> frame;
    in-out property <bool> playing;
    // Fetching the video or starting up.
    in-out property <bool> loading;
    in-out property <bool> muted;
    // Sound level, 0–100 (kept between videos).
    in-out property <int> volume: 100;
    // It has subtitles, and they're drawn.
    in-out property <bool> has-subtitles;
    in-out property <bool> subtitles;
    // Shown big over the whole window.
    in-out property <bool> large;
    // Seconds.
    in-out property <float> position;
    in-out property <float> duration;
    // Starts over when it ends.
    in-out property <bool> looping;
    // Percent of the video downloaded so far (0: not known).
    in-out property <int> progress;
    callback toggle-loop();
    // Play or pause message `id`'s video.
    callback toggle(string);
    // Jump to a fraction (0–1) of the way through.
    callback seek(float);
    callback mute();
    // A new sound level (0–100), once the slider is let go.
    callback set-volume(int);
    // Keeps the controls up over a playing video while the sound level is
    // being set (they'd hide with the hover, taking the level with them).
    in-out property <bool> bar-hold;
    callback toggle-subtitles();
    callback set-large(bool);
}

// "1:05" from seconds.
component Clock inherits Text {
    in property <float> seconds;
    property <int> whole: floor(max(0, root.seconds));
    text: floor(self.whole / 60) + ":" + (mod(self.whole, 60) < 10 ? "0" : "") + mod(self.whole, 60);
    color: white;
    font-size: 11px;
    vertical-alignment: center;
}

// Where the video is, as a line: click anywhere on it to jump there.
component SeekTrack inherits Rectangle {
    Rectangle {
        height: 4px; border-radius: 2px;
        background: #ffffff50;
        Rectangle {
            x: 0;
            width: parent.width * (Player.duration > 0 ? min(1, Player.position / Player.duration) : 0);
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { Player.seek(self.mouse-x / max(1px, self.width)); } }
}

// A vertical sound level slider: drag (or tap) along it; the level is
// passed on when it's let go.
component VolumeSlider inherits Rectangle {
    in-out property <int> value;
    callback committed(int);
    // Any touch on it (to keep it open).
    callback touched();
    width: 36px;
    height: 130px;
    property <length> pad: 12px;
    property <length> track: self.height - 2 * self.pad;
    function at(y: length) {
        root.value = round(max(0, min(100, (1 - (y - root.pad) / root.track) * 100)));
    }
    Rectangle {
        x: (parent.width - 4px) / 2;
        y: root.pad;
        width: 4px;
        height: root.track;
        border-radius: 2px;
        background: #ffffff40;
        Rectangle {
            y: parent.height * (1 - root.value / 100);
            height: parent.height * root.value / 100;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        x: (parent.width - self.width) / 2;
        y: root.pad + root.track * (1 - root.value / 100) - self.height / 2;
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            root.touched();
            if e.kind == PointerEventKind.down {
                root.at(self.mouse-y);
            } else if e.kind == PointerEventKind.up {
                root.committed(root.value);
            }
        }
        moved => {
            if self.pressed { root.at(self.mouse-y); root.touched(); }
        }
    }
}

// Play/pause, time, seek bar, length, repeat, subtitles, sound and size, over a playing video.
component VideoBar inherits Rectangle {
    in property <string> id;
    // Narrow (upright phone videos): the seek bar gets a row of its own,
    // above the buttons, or it's too short to click.
    property <bool> stacked: self.width < 320px;
    // Narrower still: tighter, and the length goes (the seek bar shows it),
    // so the buttons all fit.
    property <bool> tight: self.width < 250px;
    height: self.stacked ? 54px : 30px;
    background: #000000a0;
    // Clicks on the bar itself don't pause.
    TouchArea {}
    // Lets the controls hide again a few seconds after the level was last touched.
    property <int> idle;
    Timer {
        interval: 1s;
        running: Player.bar-hold;
        triggered => {
            root.idle += 1;
            if root.idle >= 4 { Player.bar-hold = false; }
        }
    }
    if root.stacked: SeekTrack { x: 10px; y: 2px; width: parent.width - 20px; height: 24px; }
    HorizontalLayout {
        y: root.stacked ? 24px : 0px;
        height: 30px;
        padding-left: root.tight ? 5px : 8px;
        padding-right: root.tight ? 5px : 8px;
        spacing: root.tight ? 5px : 8px;
        Rectangle {
            width: 16px;
            if Player.playing: HorizontalLayout {
                alignment: center;
                spacing: 3px;
                padding-top: 9px;
                padding-bottom: 9px;
                Rectangle { width: 3px; background: white; }
                Rectangle { width: 3px; background: white; }
            }
            if !Player.playing: Text { text: "▶"; color: white; font-size: 13px; }
            TouchArea { mouse-cursor: pointer; clicked => { Player.toggle(root.id); } }
        }
        Clock { seconds: Player.position; }
        if !root.stacked: SeekTrack { horizontal-stretch: 1; }
        if root.stacked: Rectangle { horizontal-stretch: 1; }
        if !root.tight: Clock { seconds: Player.duration; }
        Rectangle {
            width: 18px;
            // Repeat: lit while videos start over at the end.
            Text { text: "⟳"; color: Player.looping ? Theme.accent : #ffffff90; font-size: 15px; font-weight: 700; }
            TouchArea { mouse-cursor: pointer; clicked => { Player.toggle-loop(); } }
        }
        if Player.has-subtitles: Rectangle {
            width: 22px;
            // "CC", lit while subtitles show.
            Rectangle {
                width: 20px; height: 14px; border-radius: 3px;
                border-width: 1.5px;
                border-color: Player.subtitles ? white : #ffffff70;
                Text { text: "CC"; color: Player.subtitles ? white : #ffffff70; font-size: 8px; font-weight: 700; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { Player.toggle-subtitles(); } }
        }
        Rectangle {
            width: 18px;
            // A speaker, with sound waves or a cross: opens the level.
            Path {
                width: 16px; height: 14px;
                viewbox-width: 16; viewbox-height: 14;
                fill: white;
                commands: "M 0 4 L 4 4 L 8 0 L 8 14 L 4 10 L 0 10 Z";
            }
            Path {
                width: 16px; height: 14px;
                viewbox-width: 16; viewbox-height: 14;
                stroke: white;
                stroke-width: 1.5px;
                commands: Player.muted ? "M 10.5 4.5 L 15 9.5 M 15 4.5 L 10.5 9.5" : "M 10.5 4.5 Q 12.5 7 10.5 9.5 M 12.5 2.5 Q 16 7 12.5 11.5";
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.idle = 0;
                    Player.bar-hold = true;
                    volume-popup.show();
                }
            }
            // The level, with the speaker below it to turn the sound off and on.
            volume-popup := PopupWindow {
                x: (parent.width - 44px) / 2;
                y: -186px;
                width: 44px;
                height: 180px;
                close-policy: close-on-click-outside;
                Rectangle {
                    border-radius: 10px;
                    background: #000000d0;
                    VerticalLayout {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        alignment: center;
                        Text { text: Player.muted ? "off" : Player.volume + "%"; color: white; font-size: 10px; horizontal-alignment: center; }
                        HorizontalLayout {
                            alignment: center;
                            VolumeSlider {
                                value: Player.muted ? 0 : Player.volume;
                                committed(v) => { Player.set-volume(v); }
                                touched => { root.idle = 0; }
                            }
                        }
                        Rectangle {
                            height: 22px;
                            Text { text: Player.muted ? "Unmute" : "Mute"; color: Player.muted ? Theme.accent : white; font-size: 10px; font-weight: 600; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.idle = 0; Player.mute(); } }
                        }
                    }
                }
            }
        }
        Rectangle {
            width: 16px;
            // Four corners: out to enlarge, in to shrink back.
            Path {
                width: 14px; height: 14px;
                viewbox-width: 14; viewbox-height: 14;
                stroke: white;
                stroke-width: 1.5px;
                commands: Player.large
                    ? "M 5 1 L 5 5 L 1 5 M 9 1 L 9 5 L 13 5 M 5 13 L 5 9 L 1 9 M 9 13 L 9 9 L 13 9"
                    : "M 1 5 L 1 1 L 5 1 M 9 1 L 13 1 L 13 5 M 1 9 L 1 13 L 5 13 M 13 9 L 13 13 L 9 13";
            }
            TouchArea { mouse-cursor: pointer; clicked => { Player.set-large(!Player.large); } }
        }
    }
}


component MessageRow inherits Rectangle {
    in property <MessageItem> item;
    // Which list it's in ("m" the room, "t" a thread), for drag selection.
    in property <string> list: "m";
    in property <bool> can-moderate;
    in property <string> room-id;
    in property <[QuickReaction]> quick-reactions;
    callback action(string, string);
    callback copy(string);
    callback link(string);
    // Open the emoji picker to react to this message.
    callback pick-reaction();
    // Clicked the read receipts: everyone who read up to here.
    callback show-readers([Reader]);
    // Phones: held down, for the big menu that slides up (see MessageSheet).
    callback hold(MessageItem);
    // Held long enough: the menu is up, and the tap that ends it is dropped
    // (until the next press).
    property <bool> held;
    // A finger down on one of the row's own touch areas (a link card, a
    // reply quote, a name…), which take the touch so the row can't see it.
    property <bool> pressing;
    function press(e: PointerEvent) {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.held = false;
            root.pressing = true;
        } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
            root.pressing = false;
        }
    }
    // Taps do nothing when they end a hold.
    function act(a: string, id: string) { if !root.held { root.action(a, id); } }
    function go(l: string) { if !root.held { root.link(l); } }
    // Sound playing (or loading) in this message, in the window: a voice message, say.
    property <bool> sounding: root.item.media == 3 && Player.id == root.item.id;
    // Text selected in the message, for the menu's Copy.
    property <string> selection;
    // Text with links selected in the message (it copies itself).
    property <bool> styled-selection;
    // Lit for a moment: a click on a reply to it just scrolled here.
    in property <bool> flash;
    // Scrolled well out of view. Nothing of it is drawn then (without the
    // clip, every part of every loaded message is gone through on each
    // frame), and its animated pictures stop stepping: left running, they
    // had the whole window redrawn many times a second for nothing, which
    // is what made a room slow, then stuck, the further back it went.
    in property <bool> away;
    clip: root.away;

    background: area.has-hover ? Theme.hover : transparent;
    if root.flash: Rectangle { background: Theme.accent.transparentize(0.75); }
    // Wraps the whole row, so it keeps its hover over names, pictures,
    // links and chips too (their own touch areas sit inside it).
    // Phones: a press held still for a moment opens the big menu. (Moving
    // the finger scrolls instead, which lets go of the press.)
    Timer {
        interval: 450ms;
        running: Prefs.touch && (area.pressed || root.pressing) && !root.held;
        triggered => { root.held = true; root.hold(root.item); }
    }
    // The message as the right-click menu sees it: as it was when the
    // pointer came to it, and kept up while the pointer is on it. A message
    // changing under an open menu (someone read it, say) made the menu
    // number its entries afresh, and the submenu being opened then came up
    // empty (React showed a thin bar with nothing in it) or a click on an
    // entry did nothing.
    property <MessageItem> shown: root.item;
    changed item => { if area.has-hover { root.shown = root.item; } }
    area := TouchArea {
        pointer-event(e) => { root.press(e); }
        changed has-hover => { if self.has-hover { root.shown = root.item; } }
        cm := ContextMenuArea {
            // Phones get the big menu instead.
            enabled: !Prefs.touch;
            Menu {
                if root.selection != "" || root.styled-selection || TextTools.spanning: MenuItem { title: "Copy"; activated => { if root.styled-selection && !TextTools.spanning { TextTools.copy-styled += 1; } else { TextTools.copy-selection(root.selection); } } }
                if root.selection != "" || root.styled-selection || TextTools.spanning: MenuSeparator {}
                if root.shown.media == 1: MenuItem { title: "Save image…"; activated => { root.action("save", root.shown.id); } }
                if root.shown.media == 1: MenuItem { title: "Save as sticker…"; activated => { root.action("save-sticker", root.shown.id); } }
                if root.shown.media == 1: MenuItem { title: "Save as emoji…"; activated => { root.action("save-emoji", root.shown.id); } }
                if Prefs.menu-open-media && (root.shown.media == 2 || root.shown.media == 3): MenuItem { title: "Play"; activated => { root.action("play", root.shown.id); } }
                if root.shown.media == 2: MenuItem { title: "Save video…"; activated => { root.action("save", root.shown.id); } }
                if root.shown.media == 3: MenuItem { title: "Save audio…"; activated => { root.action("save", root.shown.id); } }
                // Phones: hand it to another app (it's saved to Download first).
                if Prefs.touch && root.shown.media > 0 && root.shown.media < 4: MenuItem { title: "Share…"; activated => { root.action("share", root.shown.id); } }
                if Prefs.menu-open-media && root.shown.media == 1: MenuItem { title: "Open image"; activated => { root.action("view", root.shown.id); } }
                if Prefs.menu-copy-file && root.shown.media > 0: MenuItem { title: "Copy file link"; activated => { root.action("copy-file", root.shown.id); } }
                if root.shown.media > 0 && root.shown.media < 4: MenuSeparator {}
                if Prefs.menu-react: Menu {
                    title: "React";
                    for r in root.quick-reactions: MenuItem { title: r.label; icon: r.icon; activated => { root.action("react:" + r.emoji, root.shown.id); } }
                    MenuItem { title: "More emoji…"; activated => { root.pick-reaction(); } }
                }
                if Prefs.menu-reply: MenuItem { title: "Reply"; activated => { root.action("reply", root.shown.id); } }
                if Prefs.menu-thread: MenuItem { title: "Reply in thread"; activated => { root.action("thread", root.shown.id); } }
                if Prefs.menu-forward: MenuItem { title: "Forward…"; activated => { root.action("forward", root.shown.id); } }
                if Prefs.menu-quote: MenuItem { title: "Quote"; activated => { root.action("quote", root.shown.id); } }
                if Prefs.menu-copy: MenuItem { title: "Copy whole message"; activated => { root.copy(root.shown.body); } }
                if root.shown.media > 3: MenuItem { title: "Save file…"; activated => { root.action("save", root.shown.id); } }
                if Prefs.touch && root.shown.media > 3: MenuItem { title: "Share…"; activated => { root.action("share", root.shown.id); } }
                if Prefs.menu-open-links: Menu {
                    title: "Open link";
                    enabled: root.shown.links.length > 0;
                    for l in root.shown.links: MenuItem { title: l; activated => { root.link(l); } }
                }
                if Prefs.menu-copy-link: MenuItem { title: "Copy link to message"; activated => { root.copy("https://matrix.to/#/" + root.room-id + "/" + root.shown.id); } }
                if root.shown.mine && !root.shown.poll: MenuItem { title: root.shown.media == 0 ? "Edit" : root.shown.caption ? "Edit caption" : "Add a caption"; activated => { root.action("edit", root.shown.id); } }
                if root.shown.poll-can-end: MenuItem { title: "End poll"; activated => { root.action("end-poll", root.shown.id); } }
                MenuSeparator {}
                if root.shown.mine || root.can-moderate: MenuItem { title: "Delete"; activated => { root.action("delete", root.shown.id); } }
                if !root.shown.mine && root.can-moderate: Menu {
                    title: "Moderate " + root.shown.name;
                    MenuItem { title: "Kick"; activated => { root.action("kick", root.shown.id); } }
                    MenuItem { title: "Ban"; activated => { root.action("ban", root.shown.id); } }
                }
                if Prefs.menu-profile: MenuItem { title: "View profile"; activated => { root.action("profile", root.shown.id); } }
                if Prefs.menu-copy-id: MenuItem { title: "Copy user id"; activated => { root.copy(root.shown.sender); } }
                if Prefs.menu-source: MenuItem { title: "Show source"; activated => { root.action("source", root.shown.id); } }
            }

            VerticalLayout {
                if root.item.day != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 4px;
                    spacing: 10px;
                    Rectangle { height: 1px; y: 8px; background: Theme.border; horizontal-stretch: 1; }
                    Text { text: root.item.day; font-size: 11px; font-weight: 700; color: Theme.muted; }
                    Rectangle { height: 1px; y: 8px; background: Theme.border; horizontal-stretch: 1; }
                }
                if root.item.notice: HorizontalLayout {
                    padding-left: 64px;
                    padding-right: 16px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        // A set width, so wrapped lines count in the row's height.
                        // Click for the person's profile (their full address, server…).
                        Text {
                            text: root.item.body; font-size: 12px; color: notice-ta.has-hover ? Theme.text : Theme.muted; wrap: word-wrap; width: max(40px, root.width - 64px - 16px - 52px);
                            notice-ta := TouchArea { mouse-cursor: pointer; clicked => { root.act("profile", root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                        }
                        // Developer mode: each value it changed.
                        if Prefs.dev-mode && root.item.details != "": Text {
                            text: root.item.details; font-size: 11px; font-family: "monospace"; color: Theme.muted; wrap: word-wrap; width: max(40px, root.width - 64px - 16px - 52px);
                        }
                        if Prefs.dev-mode && root.item.more-details > 0: Text {
                            text: "Show " + root.item.more-details + " more " + (root.item.more-details == 1 ? "change" : "changes");
                            font-size: 11px; color: more-ta.has-hover ? Theme.text : Theme.accent;
                            more-ta := TouchArea { mouse-cursor: pointer; clicked => { root.act("changes", root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                        }
                    }
                    Text { text: root.item.time; visible: area.has-hover; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
                }
                if !root.item.notice: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: root.item.first ? 10px : 1px;
                    padding-bottom: 2px;
                    spacing: 12px;
                    VerticalLayout {
                        width: 36px;
                        alignment: start;
                        if root.item.first: Avatar {
                            initial: root.item.initial; hue: root.item.hue; image: root.item.avatar; size: 36px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.act("profile", root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                        }
                        // Always there (shown on hover), so hovering or touching
                        // a message doesn't change its height.
                        if !root.item.first: Text { text: root.item.time; visible: area.has-hover; font-size: 9px; color: Theme.muted; horizontal-alignment: right; height: 18px; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        if root.item.first: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            TextInput {
                                text: root.item.name;
                                read-only: true;
                                // Touch screens: left to the row, so press-and-hold opens its menu.
                                enabled: !Prefs.touch;
                                accessible-description: "sel|" + root.list + "|" + root.item.id + "|0";
                                selection-background-color: Theme.accent.transparentize(0.55);
                                font-weight: 700;
                                color: root.item.mine ? Theme.accent : Theme.text;
                                font-size: 14px;
                                // Click a name to reply to this message.
                                TouchArea { mouse-cursor: pointer; clicked => { root.act("reply", root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                            }
                            if root.item.trust == 1: Text { text: "✓ Verified"; color: Theme.ok; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            if root.item.trust == 2: Text { text: "⚠ Identity changed"; color: Theme.danger; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: root.item.time; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        }
                        // What it answers: click to go to that message.
                        if root.item.reply-name != "": Rectangle {
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 2px; background: Theme.muted.transparentize(0.5); }
                                Text { text: root.item.reply-name; font-size: 12px; font-weight: 700; color: reply-area.has-hover ? Theme.text : Theme.muted; }
                                Text { text: root.item.reply-text; font-size: 12px; color: reply-area.has-hover ? Theme.text : Theme.muted; overflow: elide; horizontal-stretch: 1; }
                            }
                            reply-area := TouchArea { mouse-cursor: pointer; clicked => { root.act("jump", root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                        }
                        // Narrow chat (side panel open): shrink, keeping the shape.
                        // Pictures, and videos that came with a preview frame.
                        if root.item.media == 1 || (root.item.media == 2 && (root.item.picture.width > 0 || (Player.id == root.item.id && Player.frame.width > 0))): pic := Rectangle {
                            // A video sent without a preview takes the size of its frames.
                            property <length> pw: root.item.media == 1 || root.item.picture.width > 0 ? root.item.picture-width : Player.frame.width * 1px;
                            property <length> ph: root.item.media == 1 || root.item.picture.width > 0 ? root.item.picture-height : Player.frame.height * 1px;
                            property <float> fit: min(1, max(60px, root.width - 100px) / max(1px, self.pw));
                            // Animated pictures step through their frames, looping.
                            property <int> frame: 0;
                            width: self.pw * self.fit;
                            height: self.ph * self.fit;
                            border-radius: 8px;
                            clip: true;
                            background: Theme.raised;
                            Timer {
                                interval: max(20, root.item.frame-ms) * 1ms;
                                running: root.item.frames.length > 1 && !root.away;
                                triggered => { parent.frame = mod(parent.frame + 1, root.item.frames.length); }
                            }
                            if root.item.picture.width > 0 && root.item.frames.length == 0: Image { source: root.item.picture; width: parent.width; height: parent.height; image-fit: cover; }
                            if root.item.frames.length > 0: Image { source: root.item.frames[min(parent.frame, root.item.frames.length - 1)]; width: parent.width; height: parent.height; image-fit: cover; }
                            if root.item.media == 1 && root.item.picture.width == 0: Text { text: root.item.picture-failed ? "Couldn't load the image.\nClick to try again." : "Loading image…"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
                            property <bool> here: root.item.media == 2 && Player.id == root.item.id;
                            if pic.here && !Player.large && Player.frame.width > 0: Image { source: Player.frame; width: parent.width; height: parent.height; image-fit: contain; }
                            if root.item.media == 2 && !(pic.here && Player.playing): Rectangle {
                                width: 48px; height: 48px; border-radius: 24px;
                                background: #000000a0;
                                Text { text: "▶"; color: white; font-size: 20px; }
                            }
                            if pic.here && Player.loading: Rectangle {
                                width: 48px; height: 48px; border-radius: 24px;
                                background: #000000a0;
                                if Player.progress > 0: Text { text: Player.progress + "%"; color: white; font-size: 13px; }
                                if Player.progress == 0: Dots {}
                            }
                            // Takes every button, so it opens the menu itself on right-click.
                            pic-area := TouchArea {
                                mouse-cursor: pointer;
                                double-clicked => {
                                    if pic.here { Player.set-large(true); }
                                }
                                clicked => {
                                    if root.held { return; }
                                    if root.item.media == 2 { Player.toggle(root.item.id); } else if root.item.picture-failed { root.act("retry-media", root.item.id); } else { root.act("view", root.item.id); }
                                }
                                pointer-event(e) => { root.press(e);
                                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); }
                                }
                                // Controls, while it plays (on hover) or is paused.
                                if pic.here && !Player.large && (pic-area.has-hover || !Player.playing || Player.bar-hold): VideoBar {
                                    id: root.item.id;
                                    y: parent.height - self.height;
                                }
                            }
                        }
                        if root.item.media > 2 || (root.item.media == 2 && root.item.picture.width == 0 && !(Player.id == root.item.id && Player.frame.width > 0)): Rectangle {
                            height: 52px;
                            max-width: 340px;
                            border-radius: 8px;
                            background: Theme.raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            // Under the contents, so the seek line above it gets its own taps.
                            TouchArea {
                                mouse-cursor: pointer;
                                // Videos and audio play; other files save.
                                clicked => { root.act(root.item.media == 2 || root.item.media == 3 ? "play" : "save", root.item.id); }
                                pointer-event(e) => { root.press(e);
                                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); }
                                }
                            }
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                Rectangle {
                                    width: 36px;
                                    border-radius: 6px;
                                    background: Theme.accent-soft;
                                    if root.sounding && Player.loading: Dots {}
                                    if !(root.sounding && Player.loading): Text {
                                        text: root.sounding && Player.playing ? "❚❚" : root.item.media == 2 || root.item.media == 3 ? "▶" : "FILE";
                                        font-size: root.item.media == 2 || root.item.media == 3 ? 16px : 9px; font-weight: 800; color: Theme.accent;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: root.item.media-name; color: Theme.text; overflow: elide; font-weight: 600; }
                                    if !root.sounding: Text { text: root.item.media-info; color: Theme.muted; font-size: 11px; }
                                    // Where it's got to: tap the line to jump there.
                                    if root.sounding: HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 14px;
                                            Rectangle {
                                                height: 4px;
                                                border-radius: 2px;
                                                background: Theme.border;
                                                Rectangle {
                                                    x: 0;
                                                    width: parent.width * (Player.duration > 0 ? min(1, Player.position / Player.duration) : 0);
                                                    border-radius: 2px;
                                                    background: Theme.accent;
                                                }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { if !root.held { Player.seek(self.mouse-x / max(1px, self.width)); } }
                                                pointer-event(e) => { root.press(e); }
                                            }
                                        }
                                        Clock { seconds: Player.position; color: Theme.muted; }
                                        Text { text: "/"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                        Clock { seconds: Player.duration; color: Theme.muted; }
                                        // It starts muted: the speaker opens the level and Unmute.
                                        Rectangle {
                                            width: 22px;
                                            Text { text: Player.muted ? "🔇" : "🔊"; font-size: 13px; }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { if !root.held { sound-popup.show(); } }
                                                pointer-event(e) => { root.press(e); }
                                            }
                                            sound-popup := PopupWindow {
                                                x: (parent.width - 44px) / 2;
                                                y: -186px;
                                                width: 44px;
                                                height: 180px;
                                                close-policy: close-on-click-outside;
                                                Rectangle {
                                                    border-radius: 10px;
                                                    background: #000000d0;
                                                    VerticalLayout {
                                                        padding-top: 6px;
                                                        padding-bottom: 6px;
                                                        alignment: center;
                                                        Text { text: Player.muted ? "off" : Player.volume + "%"; color: white; font-size: 10px; horizontal-alignment: center; }
                                                        HorizontalLayout {
                                                            alignment: center;
                                                            VolumeSlider {
                                                                value: Player.muted ? 0 : Player.volume;
                                                                committed(v) => { Player.set-volume(v); }
                                                            }
                                                        }
                                                        Rectangle {
                                                            height: 22px;
                                                            Text { text: Player.muted ? "Unmute" : "Mute"; color: Player.muted ? Theme.accent : white; font-size: 10px; font-weight: 600; }
                                                            TouchArea { mouse-cursor: pointer; clicked => { Player.mute(); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.item.big-emoji.length > 0: HorizontalLayout {
                            alignment: start;
                            spacing: 4px;
                            for pic in root.item.big-emoji: Image { source: pic; width: 40px; height: 40px; }
                        }
                        if (root.item.media == 0 || root.item.caption) && root.item.big-emoji.length == 0: Blocks { key: root.list + "|" + root.item.id; avail: root.width - 32px - 36px - 12px; blocks: root.item.blocks; faint: root.item.faint; link(l) => { root.go(l); } selected(t) => { root.selection = t; } styled(on) => { root.styled-selection = on; } press(e) => { root.press(e); }
                            // A tap on text with links: its one link opens, or the menu with them all.
                            tapped => { if !root.held { if root.item.links.length == 1 { root.link(root.item.links[0]); } else if root.item.links.length > 1 { root.held = true; root.hold(root.item); } } } }
                        if root.item.edited: Text { text: "(edited)"; font-size: 10px; color: Theme.muted; }
                        if root.item.link-card > 0: Rectangle {
                            property <length> card-w: min(400px, root.width - 32px - 36px - 12px);
                            width: card-w;
                            height: card-col.preferred-height;
                            border-radius: 10px;
                            clip: true;
                            background: card-ta.has-hover ? Theme.hover : Theme.raised;
                            Rectangle { x: 0; width: 3px; background: Theme.accent; }
                            card-ta := TouchArea {
                                mouse-cursor: pointer;
                                // Right-click: the message menu, as anywhere else on it.
                                pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } }
                                clicked => {
                                    if root.item.link-card == 1 { root.act("link-preview", root.item.id); }
                                    else if root.item.link-card == 3 && root.item.link-url != "" { root.go(root.item.link-url); }
                                }
                            }
                            card-col := VerticalLayout {
                                padding: 10px;
                                padding-left: 13px;
                                spacing: 4px;
                                if root.item.link-card == 1: Text { text: "Show a preview of " + root.item.link-site; font-size: 12px; color: Theme.accent; font-weight: 600; }
                                if root.item.link-card == 2: Text { text: "Loading a preview of " + root.item.link-site + "…"; font-size: 12px; color: Theme.muted; }
                                if root.item.link-card == 3: Text { text: root.item.link-site; font-size: 11px; color: Theme.muted; overflow: elide; }
                                if root.item.link-card == 3 && root.item.link-title != "": Text { text: root.item.link-title; font-size: 13px; font-weight: 700; color: Theme.accent; wrap: word-wrap; }
                                if root.item.link-card == 3 && root.item.link-text != "": Text { text: root.item.link-text; font-size: 12px; color: Theme.text; wrap: word-wrap; max-height: 48px; overflow: elide; }
                                if root.item.link-card == 3 && root.item.link-picture.width > 0: Rectangle {
                                    height: min(225px, (card-w - 23px) * root.item.link-picture.height / max(1, root.item.link-picture.width));
                                    border-radius: 6px;
                                    clip: true;
                                    // Typst (no address) is shown whole; a site's picture fills the space.
                                    Image { source: root.item.link-picture; width: parent.width; height: parent.height; image-fit: root.item.link-url == "" ? contain : cover; }
                                    // Playing here (YouTube through Invidious).
                                    property <bool> here: root.item.link-video && Player.id == root.item.id;
                                    if self.here && !Player.large && Player.frame.width > 0: Rectangle {
                                        background: black;
                                        Image { source: Player.frame; width: parent.width; height: parent.height; image-fit: contain; }
                                    }
                                    if root.item.link-video && !(self.here && (Player.playing || Player.loading)): Rectangle {
                                        width: 46px;
                                        height: 46px;
                                        border-radius: 23px;
                                        background: #000000aa;
                                        Text { text: "▶"; color: white; font-size: 20px; x: 16px; }
                                    }
                                    if self.here && Player.loading: Rectangle {
                                        width: 46px; height: 46px; border-radius: 23px;
                                        background: #000000aa;
                                        if Player.progress > 0: Text { text: Player.progress + "%"; color: white; font-size: 13px; }
                                        if Player.progress == 0: Dots {}
                                    }
                                    if root.item.link-video && Prefs.youtube-here: yt-area := TouchArea {
                                        mouse-cursor: pointer;
                                        // Right-click: the message menu, as anywhere else on it.
                                        pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } }
                                        clicked => { if !root.held { Player.toggle(root.item.id); } }
                                        double-clicked => { if parent.here { Player.set-large(true); } }
                                        if parent.here && !Player.loading && !Player.large && (yt-area.has-hover || !Player.playing || Player.bar-hold): VideoBar {
                                            id: root.item.id;
                                            y: parent.height - self.height;
                                        }
                                    }
                                }
                            }
                        }
                        // Who really sent it: the warning always, the reason on
                        // hover (or a tap) over it, laid over the messages so
                        // nothing moves.
                        if root.item.shield > 0: Rectangle {
                            height: 14px;
                            Text {
                                x: 0;
                                text: "⚠";
                                font-size: 10px;
                                color: root.item.shield == 2 ? Theme.danger : Theme.muted;
                                shield-ta := TouchArea { mouse-cursor: pointer; pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                            }
                            if shield-ta.has-hover: Rectangle {
                                x: 16px;
                                y: -6px;
                                width: min(360px, root.width - 100px);
                                height: shield-tip.preferred-height + 12px;
                                border-radius: 6px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.border;
                                shield-tip := Text {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    text: root.item.shield-text;
                                    font-size: 11px;
                                    color: root.item.shield == 2 ? Theme.danger : Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        // A poll: its answers (tap to vote, again to take it back),
                        // with the count once it may be seen.
                        if root.item.poll: VerticalLayout {
                            spacing: 4px;
                            padding-top: 4px;
                            for o in root.item.poll-options: Rectangle {
                                height: max(34px, ot.preferred-height + 14px);
                                min-width: 200px;
                                max-width: 420px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: o.mine || o.winner ? Theme.accent : Theme.border;
                                background: ot-ta.has-hover && !root.item.poll-ended ? Theme.hover : Theme.raised;
                                clip: true;
                                // How many picked it, as a bar behind the text.
                                Rectangle {
                                    x: 0;
                                    width: parent.width * o.share;
                                    background: Theme.accent-soft;
                                    animate width { duration: 200ms; }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: o.mine ? "☑" : "☐";
                                        color: o.mine ? Theme.accent : Theme.muted;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                    ot := Text {
                                        horizontal-stretch: 1;
                                        text: o.text + (o.winner ? "  🏆" : "");
                                        color: Theme.text;
                                        font-weight: o.mine || o.winner ? 700 : 400;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                    if o.show-count: Text {
                                        text: o.count;
                                        color: o.mine ? Theme.accent : Theme.muted;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                ot-ta := TouchArea {
                                    mouse-cursor: root.item.poll-ended ? default : pointer;
                                    clicked => { if !root.held && !root.item.poll-ended { root.act("vote:" + o.id, root.item.id); } }
                                    pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } }
                                }
                            }
                            Text { text: root.item.poll-note; font-size: 11px; color: Theme.muted; }
                        }
                        if root.item.thread-replies > 0: Rectangle {
                            height: 26px;
                            width: min(th.preferred-width + 16px, 360px);
                            border-radius: 8px;
                            background: th-ta.has-hover ? Theme.hover : Theme.raised;
                            th := HorizontalLayout {
                                x: 8px;
                                width: parent.width - 16px;
                                spacing: 6px;
                                Text {
                                    text: root.item.thread-replies == 1 ? "1 reply" : root.item.thread-replies + " replies";
                                    font-size: 12px; font-weight: 700; color: Theme.accent; vertical-alignment: center;
                                }
                                Text { text: root.item.thread-last; font-size: 12px; color: Theme.muted; overflow: elide; vertical-alignment: center; }
                            }
                            th-ta := TouchArea { mouse-cursor: pointer; clicked => { root.act("thread", root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                        }
                        if root.item.reactions.length > 0: HorizontalLayout {
                            alignment: start;
                            spacing: 4px;
                            padding-top: 2px;
                            for r in root.item.reactions: Rectangle {
                                height: 24px;
                                width: chip.preferred-width + 14px;
                                border-radius: 12px;
                                background: r.mine ? Theme.accent-soft : chip-ta.has-hover ? Theme.hover : Theme.raised;
                                border-width: 1px;
                                border-color: r.mine ? Theme.accent : Theme.border;
                                chip := HorizontalLayout {
                                    x: 7px;
                                    spacing: 4px;
                                    if r.picture.width > 0: Image { source: r.picture; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                                    if r.picture.width == 0: Text { text: r.custom ? "…" : r.key; font-size: 13px; vertical-alignment: center; }
                                    Text { text: r.count; font-size: 11px; font-weight: 700; color: r.mine ? Theme.accent : Theme.muted; vertical-alignment: center; }
                                }
                                chip-ta := TouchArea { mouse-cursor: pointer; clicked => { root.act("react:" + r.key, root.item.id); } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                                // On hover: the emoji large (small ones are hard to make
                                // out), what it is, and who reacted.
                                if chip-ta.has-hover: Rectangle {
                                    y: -50px;
                                    height: 44px;
                                    width: min(300px, tip.preferred-width + 16px);
                                    border-radius: 8px;
                                    background: Theme.panel;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    tip := HorizontalLayout {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        spacing: 8px;
                                        if r.picture.width > 0: Image { source: r.picture; width: 32px; height: 32px; y: (parent.height - self.height) / 2; }
                                        if r.picture.width == 0: Text { text: r.key; font-size: 24px; vertical-alignment: center; }
                                        VerticalLayout {
                                            alignment: center;
                                            if r.name != "": Text { text: r.name; font-size: 12px; font-weight: 700; color: Theme.text; overflow: elide; }
                                            Text { text: r.who; font-size: 11px; color: Theme.muted; overflow: elide; }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 24px;
                                width: 30px;
                                border-radius: 12px;
                                background: add-ta.has-hover ? Theme.hover : transparent;
                                Text { text: "+"; font-size: 14px; color: Theme.muted; }
                                add-ta := TouchArea { mouse-cursor: pointer; clicked => { if !root.held { root.pick-reaction(); } } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                            }
                        }
                    }
                }
                // Read receipts: who has read up to here.
                if root.item.readers.length > 0: HorizontalLayout {
                    alignment: end;
                    padding-right: 16px;
                    padding-bottom: 2px;
                    spacing: 2px;
                    Rectangle {
                        width: rd.preferred-width;
                        rd := HorizontalLayout {
                            spacing: 2px;
                            for r in root.item.readers: Avatar { initial: r.initial; hue: r.hue; image: r.avatar; size: 16px; }
                            if root.item.more-readers > 0: Text { text: "+" + root.item.more-readers; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { if !root.held { root.show-readers(root.item.all-readers); } } pointer-event(e) => { root.press(e); if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x, y: self.absolute-position.y - root.absolute-position.y + self.mouse-y }); } } }
                    }
                }
            }
        }
    }
}

component RailAccount inherits Rectangle {
    in property <AccountItem> item;
    in property <bool> selected;
    // Where this account is in the rail, and the drag going on there
    // (`drag-from` is -1 when nothing is being dragged).
    in property <int> index;
    in property <int> count;
    in property <int> drag-from: -1;
    in property <length> drag-dy;
    callback clicked;
    // Double-clicked: hides or shows the room list.
    callback double-clicked;
    callback menu(string);
    callback dragging(length);
    callback dropped(int);
    width: 64px;
    height: 54px;
    // Rows are 54px plus 2px spacing in the rail.
    property <length> drag-y: ta.pressed && abs(ta.mouse-y - ta.pressed-y) > 6px ? ta.mouse-y - ta.pressed-y : 0;
    changed drag-y => { root.dragging(self.drag-y); }
    // Where the dragged account would land, and whether this one makes room.
    property <int> target: max(0, min(root.count - 1, root.drag-from + round(root.drag-dy / 56px)));
    property <length> shift: root.drag-from < 0 || root.drag-from == root.index ? 0
        : root.drag-from < root.index && root.index <= root.target ? -56px
        : root.target <= root.index && root.index < root.drag-from ? 56px : 0;
    animate shift { duration: root.drag-from >= 0 ? 140ms : 0ms; easing: ease-out; }
    property <bool> lifted: root.drag-y != 0;
    z: root.lifted ? 10 : 0;
    cm := ContextMenuArea {
        Menu {
            MenuItem { title: "Move up"; activated => { root.menu("up"); } }
            MenuItem { title: "Move down"; activated => { root.menu("down"); } }
            MenuSeparator {}
            MenuItem { title: "Account settings"; activated => { root.menu("settings"); } }
            if root.item.is-agent: MenuItem { title: "AI settings"; activated => { root.menu("ai"); } }
            MenuItem { title: "Copy user id"; activated => { root.menu("copy"); } }
        }
    }
    Rectangle {
        y: root.shift + max(-root.index * 56px, min((root.count - 1 - root.index) * 56px, root.drag-y));
        Rectangle {
            x: 0;
            width: 4px;
            height: root.selected ? 36px : ta.has-hover && !root.lifted ? 16px : 0;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: Theme.text;
            animate height { duration: 120ms; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 46px;
            height: 46px;
            border-radius: 23px;
            background: root.lifted ? Theme.raised : transparent;
            drop-shadow-blur: root.lifted ? 10px : 0;
            drop-shadow-color: #00000070;
            Avatar {
                initial: root.item.initial;
                hue: root.item.hue;
                image: root.item.avatar;
                robot: root.item.is-agent && root.item.avatar.width == 0;
                size: 42px;
                opacity: root.selected || ta.has-hover || root.lifted ? 1 : 0.8;
            }
            // AI accounts with their own picture still say they're an AI.
            if root.item.is-agent && root.item.avatar.width > 0: AiBadge { avatar-size: 42px; x: parent.width - self.width + 2px; y: parent.height - self.height + 2px; }
        }
        if root.item.unread > 0: Pill { x: 38px; y: 6px; text: root.item.unread > 99 ? "99+" : root.item.unread; strong: true; }
        // Its tags, so accounts with the same picture can be told apart.
        if root.item.tags != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height;
            width: min(60px, tag.preferred-width + 8px);
            height: 13px;
            border-radius: 6px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            tag := Text {
                width: parent.width - 6px;
                text: root.item.tags;
                font-size: 9px;
                color: Theme.text;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // Drag up or down to reorder; the others slide aside like tabs. The
    // TouchArea takes every button, so it opens the right-click menu itself
    // (the menu area never sees it). It stays put while the picture moves,
    // so the drag distance is measured from where it started.
    ta := TouchArea {
        mouse-cursor: root.lifted ? MouseCursor.grabbing : MouseCursor.pointer;
        clicked => { if abs(self.mouse-y - self.pressed-y) <= 6px { root.clicked(); } }
        double-clicked => { if abs(self.mouse-y - self.pressed-y) <= 6px { root.double-clicked(); } }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                cm.show({ x: self.mouse-x, y: self.mouse-y });
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.dropped(abs(self.mouse-y - self.pressed-y) > 6px ? root.target - root.index : 0);
            }
        }
    }
}


// Shows or folds away the room list: a panel with its left part filled
// while the list shows.
component RoomsToggle inherits Rectangle {
    in property <bool> shown;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : transparent;
    Path {
        width: 18px;
        height: 16px;
        viewbox-width: 18;
        viewbox-height: 16;
        stroke: Theme.muted;
        stroke-width: 1.5px;
        commands: "M 1 1 L 17 1 L 17 15 L 1 15 Z M 6 1 L 6 15";
    }
    if root.shown: Rectangle {
        x: (parent.width - 18px) / 2 + 1px;
        y: (parent.height - 16px) / 2 + 1px;
        width: 5px;
        height: 14px;
        background: Theme.muted;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component RoomRow inherits Rectangle {
    in property <RoomItem> item;
    in property <bool> selected;
    // Rooms were dragged into an order (the menu can undo it).
    in property <bool> ordered;
    callback clicked;
    callback menu(string);
    // Dropped after a drag, this far below (or above) where it was.
    callback dropped(length);
    // Held still for a moment, then dragged: moves the room in the list.
    property <bool> held;
    property <bool> dragging;
    // The release that ends a drag isn't a click.
    property <bool> dragged;
    property <length> drag-dy;
    Timer {
        interval: 450ms;
        running: !root.item.header && ta.pressed && !root.held;
        triggered => {
            if abs(ta.mouse-y - ta.pressed-y) < 8px && abs(ta.mouse-x - ta.pressed-x) < 8px { root.held = true; }
        }
    }
    cm := ContextMenuArea {
        enabled: !root.item.header;
        Menu {
            if root.item.invite: MenuItem { title: "Accept invitation"; activated => { root.menu("accept"); } }
            if root.item.invite: MenuItem { title: "Decline invitation"; activated => { root.menu("leave"); } }
            if root.item.space: MenuItem { title: root.item.open ? "Fold" : "Unfold"; activated => { root.menu("toggle"); } }
            if !root.item.invite && !root.item.space: MenuItem { title: root.item.pinned ? "Unpin" : "Pin to top"; activated => { root.menu(root.item.pinned ? "unpin" : "pin"); } }
            if !root.item.invite && !root.item.space: MenuItem { title: "Mark as read"; activated => { root.menu("read"); } }
            if !root.item.invite && !root.item.space: MenuItem { title: "Room info"; activated => { root.menu("info"); } }
            if !root.item.invite: MenuItem { title: "Invite people…"; activated => { root.menu("info"); } }
            if !root.item.invite && root.item.space: MenuItem { title: "Space info"; activated => { root.menu("info"); } }
            MenuItem { title: root.item.space ? "Copy space address" : "Copy room address"; activated => { root.menu("copy"); } }
            if !root.item.invite: MenuItem { title: "Move up"; activated => { root.menu("move-up"); } }
            if !root.item.invite: MenuItem { title: "Move down"; activated => { root.menu("move-down"); } }
            if !root.item.invite && root.ordered: MenuItem { title: "Sort by newest activity again"; activated => { root.menu("sort-recent"); } }
            if !root.item.invite: MenuSeparator {}
            if !root.item.invite: MenuItem { title: root.item.space ? "Leave space" : "Leave room"; activated => { root.menu("leave"); } }
        }
    }
    height: root.item.header ? 28px : root.item.space ? 44px : 58px;
    border-radius: 10px;
    background: root.item.header ? transparent : selected || root.dragging ? Theme.active : ta.has-hover ? Theme.hover : transparent;
    border-width: root.dragging ? 1px : 0px;
    border-color: Theme.accent;
    if root.item.header: Text {
        x: 10px;
        text: root.item.name;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        vertical-alignment: center;
    }
    // Rooms in a space hang off a line under the folder.
    for d in root.item.depth: Rectangle { x: 20px + d * 16px; width: 1px; background: Theme.border; }
    if root.item.space && !root.item.header: HorizontalLayout {
        padding-left: 8px + root.item.depth * 16px;
        padding-right: 10px;
        spacing: 8px;
        Text { text: root.item.open ? "▾" : "▸"; width: 12px; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px; height: 28px; border-radius: 7px; clip: true;
                Avatar { initial: root.item.initial; hue: root.item.hue; image: root.item.avatar; size: 28px; }
            }
        }
        Text {
            text: root.item.name;
            overflow: elide;
            horizontal-stretch: 1;
            color: Theme.text;
            font-weight: 700;
            font-size: 13px;
            vertical-alignment: center;
        }
        if !root.item.open || root.item.unread == 0: Text { text: root.item.preview; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        if !root.item.open && root.item.unread > 0: VerticalLayout { alignment: center; Pill { text: root.item.unread > 99 ? "99+" : root.item.unread; strong: true; } }
    }
    if !root.item.space && !root.item.header: HorizontalLayout {
        padding-left: 8px + root.item.depth * 16px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout { alignment: center; Avatar { initial: root.item.initial; hue: root.item.hue; image: root.item.avatar; size: 40px; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                if root.item.pinned: Text { text: "▲"; font-size: 9px; color: Theme.accent; vertical-alignment: center; }
                Text {
                    text: root.item.name;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: Theme.text;
                    font-weight: root.item.unread > 0 || root.item.invite ? 700 : 600;
                    font-size: 14px;
                }
                Text { text: root.item.time; color: Theme.muted; font-size: 11px; }
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.invite ? "Invitation" : root.item.preview;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: root.item.invite ? Theme.accent : Theme.muted;
                    font-size: 12px;
                }
                if root.item.unread > 0: Pill { text: root.item.unread > 99 ? "99+" : root.item.unread; strong: true; }
            }
        }
    }
    ta := TouchArea {
        enabled: !root.item.header;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        clicked => {
            if root.dragged { root.dragged = false; return; }
            root.clicked();
        }
        moved => {
            if root.held && self.pressed {
                root.drag-dy = self.mouse-y - self.pressed-y;
                if abs(root.drag-dy) > 6px { root.dragging = true; }
            }
        }
        // This takes every button, so open the right-click menu from here.
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { cm.show({ x: self.mouse-x, y: self.mouse-y }); }
            if e.kind == PointerEventKind.down { root.held = false; root.dragging = false; root.dragged = false; root.drag-dy = 0; }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if root.dragging && e.kind == PointerEventKind.up { root.dropped(root.drag-dy); }
                root.dragged = root.dragging;
                root.dragging = false;
                root.held = false;
                root.drag-dy = 0;
            }
        }
    }
    // Where it will land, and its name, following the pointer.
    if root.dragging: Rectangle {
        y: root.height / 2 + root.drag-dy;
        height: 2px;
        background: Theme.accent;
    }
    if root.dragging: Rectangle {
        x: 40px;
        y: root.height / 2 + root.drag-dy - 26px;
        width: min(root.width - 50px, drag-name.preferred-width + 20px);
        height: 22px;
        border-radius: 11px;
        background: Theme.accent;
        drag-name := Text { text: root.item.name; color: white; font-size: 12px; font-weight: 600; overflow: elide; }
    }
}

component UnlockScreen inherits Rectangle {
    in property <bool> first-run;
    in property <string> error;
    in property <bool> busy;
    // What's waiting to be shared (from another app), if anything.
    in property <string> sharing;
    callback submit(string);
    background: Theme.bg;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(340px, root.width - 32px);
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    if Prefs.logo.width > 0: Image { source: Prefs.logo; width: 96px; height: 96px; image-fit: contain; }
                    if Prefs.logo.width == 0: Avatar { initial: "W"; hue: 0; size: 64px; }
                }
                Text { text: "Whisker"; font-size: 26px; font-weight: 800; horizontal-alignment: center; color: Theme.text; }
                Text {
                    text: root.first-run ? "Pick a passphrase. It encrypts every account on this device." : "Enter your passphrase";
                    wrap: word-wrap; horizontal-alignment: center; color: Theme.muted;
                }
                pass := Input {
                    password: true;
                    placeholder: "Passphrase";
                    enabled: !root.busy;
                    accepted(t) => { root.submit(t); self.text = ""; }
                }
                Btn {
                    text: root.busy ? "Unlocking…" : root.first-run ? "Create vault" : "Unlock";
                    primary: true;
                    enabled: !root.busy;
                    clicked => { root.submit(pass.text); pass.text = ""; }
                }
                if root.error != "": Text { text: root.error; color: Theme.danger; wrap: word-wrap; horizontal-alignment: center; }
                if root.sharing != "": Text { text: "Unlock to share " + root.sharing + "."; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center; }
            }
        }
    }
}

// Room the phone's status and navigation bars take at the top and bottom
// of the screen (zero on desktops), so nothing is drawn under them.
global Safe {
    in-out property <length> top;
    in-out property <length> bottom;
    // The sides: a phone on its side has its navigation bar (and camera
    // cut-out) there.
    in-out property <length> left;
    in-out property <length> right;
}

// The message box's "+": a file, or a poll.
component AttachBtn inherits Rectangle {
    callback file();
    callback poll();
    width: 38px;
    height: 38px;
    IconBtn { icon: "+"; size: 38px; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: 0;
        y: -96px;
        width: 190px;
        height: 88px;
        Rectangle {
            background: Theme.panel;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                for row[i] in ["Send a file…", "Create a poll…"]: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: row-ta.has-hover ? Theme.hover : transparent;
                    Text { x: 12px; text: row; color: Theme.text; vertical-alignment: center; }
                    row-ta := TouchArea { mouse-cursor: pointer; clicked => { if i == 0 { root.file(); } else { root.poll(); } } }
                }
            }
        }
    }
}

component Overlay inherits Rectangle {
    in property <length> card-width: 380px;
    callback dismiss;
    background: #000000b0;
    TouchArea { clicked => { root.dismiss(); } }
    VerticalLayout {
        alignment: center;
        padding-top: Safe.top;
        padding-bottom: Safe.bottom;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(root.card-width, root.width - 32px);
                background: Theme.panel;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border;
                TouchArea {}
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    @children
                }
            }
        }
    }
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: active ? Theme.active : ta.has-hover ? Theme.hover : transparent;
    Text { text: root.text; color: root.active ? Theme.text : Theme.muted; font-weight: 700; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component LoginDialog inherits Overlay {
    in property <string> error;
    in property <bool> busy;
    in property <bool> agent;
    in-out property <bool> register;
    // A sign-up step to do (see AppWindow's signup-step).
    in property <int> step;
    in property <image> picture;
    in property <string> stage;
    in property <string> note;
    callback answer(int, string);
    // Suggested servers, then "Other server…" last.
    in property <[string]> servers;
    property <int> pick: 0;
    property <bool> custom: root.pick >= root.servers.length - 1;
    property <string> hs-text;
    property <string> pw2-text;
    property <string> token-text;
    property <string> server: root.custom ? root.hs-text : root.servers[root.pick];
    // server, user, password, tags, proxy, is-ai, register, token
    callback login(string, string, string, string, string, bool, bool, string);
    property <bool> mismatch: root.register && root.pw2-text != "" && pw.text != root.pw2-text;
    function go() {
        if root.register && pw.text != root.pw2-text { return; }
        root.login(root.server, user.text, pw.text, tags.text, proxy.text, root.agent, root.register, root.register ? root.token-text : "");
    }
    Text { text: root.agent ? "Add an AI account" : "Add an account"; font-size: 18px; font-weight: 800; color: Theme.text; }
    HorizontalLayout {
        spacing: 4px;
        Tab { text: "Sign in"; active: !root.register; clicked => { root.register = false; } }
        Tab { text: "Create account"; active: root.register; clicked => { root.register = true; } }
    }
    if root.agent: Text {
        text: root.register ? "Create the Matrix account the AI will use. You'll set up its model next." : "Sign in to the Matrix account the AI will use. You'll set up its model next.";
        wrap: word-wrap; color: Theme.muted; font-size: 12px;
    }
    Text { text: "Server"; font-size: 12px; color: Theme.muted; }
    ComboBox {
        model: root.servers;
        current-index <=> root.pick;
    }
    if root.custom: Input { text <=> root.hs-text; placeholder: "Server address, e.g. matrix.org"; }
    user := Input { placeholder: root.register ? "Pick a username" : "Username"; }
    if !root.custom && user.text != "": Text {
        text: "Your address: @" + user.text + ":" + root.server;
        font-size: 11px; color: Theme.muted; wrap: char-wrap;
    }
    pw := Input { placeholder: root.register ? "Pick a password" : "Password"; password: true; accepted => { root.go(); } }
    if root.register: Input { text <=> root.pw2-text; placeholder: "Repeat password"; password: true; accepted => { root.go(); } }
    if root.register: Input { text <=> root.token-text; placeholder: "Registration token (if you have one)"; }
    tags := Input { placeholder: "Tags (optional), e.g. alt, work"; }
    proxy := Input { placeholder: "Proxy (optional), e.g. socks5h://127.0.0.1:9050"; }
    if root.mismatch: Text { text: "The passwords don't match."; color: Theme.danger; }
    if root.error != "": Text { text: root.error; color: Theme.danger; wrap: char-wrap; }
    // The server's captcha, shown here (nothing else is fetched for it).
    if root.step == 1: VerticalLayout {
        spacing: 6px;
        Text { text: "Type what the picture says."; color: Theme.text; font-weight: 700; }
        Rectangle {
            height: 120px;
            border-radius: 6px;
            background: #ffffff;
            clip: true;
            Image { source: root.picture; width: parent.width; height: parent.height; image-fit: contain; }
        }
        if root.note != "": Text { text: root.note; color: Theme.danger; wrap: word-wrap; }
        captcha-answer := Input { placeholder: "Answer"; accepted => { root.answer(1, self.text); } }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { text: "New picture"; clicked => { root.answer(2, ""); } }
            Btn { text: "Continue"; primary: true; enabled: captcha-answer.text != ""; clicked => { root.answer(1, captcha-answer.text); } }
        }
    }
    // The server's terms, agreed to here.
    if root.step == 3: VerticalLayout {
        spacing: 6px;
        Text { text: "To create an account on this server you agree to:"; color: Theme.text; font-weight: 700; wrap: word-wrap; }
        Text { text: root.stage; color: Theme.muted; font-size: 12px; wrap: char-wrap; }
        if root.note != "": Text { text: root.note; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { text: "Copy links"; clicked => { root.answer(4, ""); } }
            Btn { text: "Read"; clicked => { root.answer(5, ""); } }
            Btn { text: "I agree"; primary: true; clicked => { root.answer(3, ""); } }
        }
    }
    // A step Whisker can't do itself, done on the server's own page.
    if root.step == 2: VerticalLayout {
        spacing: 6px;
        Text {
            text: "This server's sign-up needs " + root.stage + ", done on its own page. Open it in a browser, finish there, then press Done.";
            color: Theme.text; wrap: word-wrap;
        }
        if root.note != "": Text { text: root.note; color: Theme.danger; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { text: "Copy link"; clicked => { root.answer(4, ""); } }
            Btn { text: "Open page"; clicked => { root.answer(5, ""); } }
            Btn { text: "Done"; primary: true; clicked => { root.answer(3, ""); } }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Btn { text: "Cancel"; clicked => { root.dismiss(); } }
        Btn {
            text: root.busy ? (root.register ? "Creating…" : "Signing in…") : (root.register ? "Create account" : "Sign in");
            primary: true;
            enabled: !root.busy && !root.mismatch;
            clicked => { root.go(); }
        }
    }
}

// What a file in the chooser is: its picture when there is one, else a sign
// of its kind (folder, picture, video, sound, file).
component PickThumb inherits Rectangle {
    in property <PickEntry> entry;
    in property <length> size: 48px;
    width: size;
    height: size;
    border-radius: 6px;
    clip: true;
    background: entry.thumb.width > 0 ? transparent : Theme.raised;
    if root.entry.thumb.width > 0: Image { source: root.entry.thumb; width: root.size; height: root.size; image-fit: cover; }
    if root.entry.thumb.width == 0: Text {
        text: root.entry.up ? "⬆" : root.entry.dir ? "📁" : root.entry.kind == 1 ? "🖼" : root.entry.kind == 2 ? "▶" : root.entry.kind == 3 ? "♪" : "📄";
        font-size: root.size * 0.45;
        color: Theme.muted;
    }
    if root.entry.kind == 2 && root.entry.thumb.width > 0: Rectangle {
        width: root.size * 0.42; height: self.width; border-radius: self.width / 2;
        background: #000000a0;
        Text { text: "▶"; color: white; font-size: root.size * 0.2; }
    }
}

// One big row in the phone menu.
component SheetRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 50px;
    border-radius: 10px;
    background: sta.pressed ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text { text: root.text; font-size: 16px; color: root.danger ? Theme.danger : Theme.text; vertical-alignment: center; overflow: elide; }
    }
    sta := TouchArea { clicked => { root.clicked(); } }
}

// Phones: a message's menu as big rows sliding up from the bottom (the
// right-click menu's entries, finger-sized), with quick reactions on top.
component MessageSheet inherits Rectangle {
    in property <MessageItem> item;
    in property <bool> can-moderate;
    in property <string> room-id;
    in property <[QuickReaction]> quick-reactions;
    callback action(string, string);
    callback copy(string);
    callback link(string);
    callback pick-reaction();
    callback close();
    property <bool> links-open;
    property <bool> mod-open;
    function run(a: string) { root.action(a, root.item.id); root.close(); }
    background: #00000099;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        y: root.height - self.height;
        height: min(body.preferred-height + Safe.bottom + 24px, root.height * 0.85);
        background: Theme.panel;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        TouchArea {}
        VerticalLayout {
            padding-top: 8px;
            padding-bottom: Safe.bottom + 8px;
            HorizontalLayout { alignment: center; Rectangle { width: 40px; height: 4px; border-radius: 2px; background: Theme.border; } }
            Flickable {
                content-width: self.width;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    spacing: 2px;
                    if Prefs.menu-react && !root.item.notice: HorizontalLayout {
                        alignment: space-around;
                        padding-bottom: 6px;
                        for r in root.quick-reactions: Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: qta.pressed ? Theme.hover : Theme.raised;
                            if r.icon.width > 0: Image { source: r.icon; width: 28px; height: 28px; }
                            if r.icon.width == 0: Text { text: r.emoji; font-size: 24px; }
                            qta := TouchArea { clicked => { root.run("react:" + r.emoji); } }
                        }
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: pta.pressed ? Theme.hover : Theme.raised;
                            Text { text: "+"; font-size: 24px; color: Theme.text; }
                            pta := TouchArea { clicked => { root.pick-reaction(); root.close(); } }
                        }
                    }
                    if root.links-open: VerticalLayout {
                        spacing: 2px;
                        SheetRow { text: "‹ Back"; clicked => { root.links-open = false; } }
                        for l in root.item.links: SheetRow { text: l; clicked => { root.link(l); root.close(); } }
                    }
                    if root.mod-open: VerticalLayout {
                        spacing: 2px;
                        SheetRow { text: "‹ Back"; clicked => { root.mod-open = false; } }
                        SheetRow { text: "Kick " + root.item.name; danger: true; clicked => { root.run("kick"); } }
                        SheetRow { text: "Ban " + root.item.name; danger: true; clicked => { root.run("ban"); } }
                    }
                    if !root.links-open && !root.mod-open: VerticalLayout {
                        spacing: 2px;
                        if Prefs.menu-reply && !root.item.notice: SheetRow { text: "Reply"; clicked => { root.run("reply"); } }
                        if Prefs.menu-thread && !root.item.notice: SheetRow { text: "Reply in thread"; clicked => { root.run("thread"); } }
                        if Prefs.menu-copy: SheetRow { text: "Copy text"; clicked => { root.copy(root.item.body); root.close(); } }
                        if Prefs.menu-forward && !root.item.notice: SheetRow { text: "Forward…"; clicked => { root.run("forward"); } }
                        if Prefs.menu-quote && !root.item.notice: SheetRow { text: "Quote"; clicked => { root.run("quote"); } }
                        if root.item.media > 0: SheetRow { text: "Share…"; clicked => { root.run("share"); } }
                        if root.item.media == 1: SheetRow { text: "Save image"; clicked => { root.run("save"); } }
                        if root.item.media == 1: SheetRow { text: "Save as sticker"; clicked => { root.run("save-sticker"); } }
                        if root.item.media == 1: SheetRow { text: "Save as emoji"; clicked => { root.run("save-emoji"); } }
                        if root.item.media == 2: SheetRow { text: "Save video"; clicked => { root.run("save"); } }
                        if root.item.media == 3: SheetRow { text: "Save audio"; clicked => { root.run("save"); } }
                        if root.item.media > 3: SheetRow { text: "Save file"; clicked => { root.run("save"); } }
                        if Prefs.menu-open-media && root.item.media == 1: SheetRow { text: "Open image"; clicked => { root.run("view"); } }
                        if Prefs.menu-open-media && (root.item.media == 2 || root.item.media == 3): SheetRow { text: "Play"; clicked => { root.run("play"); } }
                        if root.item.links.length == 1: SheetRow { text: "Open link"; clicked => { root.link(root.item.links[0]); root.close(); } }
                        if root.item.links.length > 1: SheetRow { text: "Open link ›"; clicked => { root.links-open = true; } }
                        if Prefs.menu-copy-file && root.item.media > 0: SheetRow { text: "Copy file link"; clicked => { root.run("copy-file"); } }
                        if Prefs.menu-copy-link: SheetRow { text: "Copy link to message"; clicked => { root.copy("https://matrix.to/#/" + root.room-id + "/" + root.item.id); root.close(); } }
                        if root.item.mine && !root.item.notice && !root.item.poll: SheetRow { text: root.item.media == 0 ? "Edit" : root.item.caption ? "Edit caption" : "Add a caption"; clicked => { root.run("edit"); } }
                        if root.item.poll-can-end: SheetRow { text: "End poll"; clicked => { root.run("end-poll"); } }
                        if Prefs.menu-profile: SheetRow { text: "View profile"; clicked => { root.run("profile"); } }
                        if Prefs.menu-copy-id: SheetRow { text: "Copy user id"; clicked => { root.copy(root.item.sender); root.close(); } }
                        if Prefs.menu-source: SheetRow { text: "Show source"; clicked => { root.run("source"); } }
                        if !root.item.mine && root.can-moderate && !root.item.notice: SheetRow { text: "Moderate " + root.item.name + " ›"; danger: true; clicked => { root.mod-open = true; } }
                        if (root.item.mine || root.can-moderate) && !root.item.notice: SheetRow { text: "Delete"; danger: true; clicked => { root.run("delete"); } }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Whisker";
    // Emoji first: otherwise a text font with plain black-and-white emoji
    // shapes (DejaVu Sans has some) wins over the colour emoji font.
    default-font-family: "Whisker Emoji";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 14px;

    // 0 = unlock, 1 = main, 2 = settings
    in-out property <int> screen: 0;
    // 0 = dark (default), 1 = light, 2 = follow system
    in-out property <int> theme: 0;
    in-out property <int> auto-lock: 0;
    in property <bool> first-run;
    in-out property <string> error;
    in-out property <bool> busy;
    in-out property <string> status;
    // A download someone asked for is going on (the ✕ by the status stops it).
    in-out property <bool> downloading;
    callback cancel-downloads();
    // Files being sent (from a chat or shared from another app).
    in-out property <bool> uploading;
    callback cancel-uploads();
    // Choosing files on Android, in Whisker's own list (see picker.rs).
    in-out property <bool> picker-open;
    in property <string> picker-title;
    in property <string> picker-dir;
    in property <[PickEntry]> picker-entries;
    in property <[string]> picker-places;
    in property <bool> picker-multi;
    in property <int> picker-count;
    // What Android lets Whisker see: 0 nothing yet, 1 photos, videos and music, 2 every file.
    in property <int> picker-access;
    callback picker-tap(int);
    callback picker-place(int);
    callback picker-refresh();
    callback picker-finish(bool);
    callback picker-all-files();
    // Pictures in a grid (folders of mostly photos and videos) or a list.
    in-out property <bool> picker-grid;

    in property <[AccountItem]> accounts;
    in property <[string]> tags;
    in property <[RoomItem]> rooms;
    in property <[MessageItem]> messages;
    in-out property <string> tag-filter;
    in-out property <string> current-account;
    in-out property <string> current-room;
    in property <string> current-room-name;
    in property <string> current-room-topic;
    // The whole description, and the window showing it with its formatting.
    in property <string> current-room-topic-full;
    in-out property <bool> topic-open;
    in property <string> topic-title;
    in property <string> topic-text;
    in property <[Block]> topic-blocks;
    callback open-topic();
    // Stickers: saving a picture as one (asking its name), and the picker.
    in-out property <bool> sticker-save-open;
    in-out property <string> sticker-name;
    in property <string> sticker-error;
    // The save dialog is for a custom emoji, and what to know first.
    in property <bool> sticker-as-emoji;
    in property <string> sticker-note;
    callback save-sticker(string);
    in-out property <bool> stickers-open;
    in property <[StickerItem]> stickers;
    callback open-stickers();
    callback send-sticker(string);
    callback remove-sticker(string);
    // The sticker or emoji whose row asks "Remove?" (held, or right-clicked).
    property <string> sticker-confirm;
    in property <string> current-account-name;
    in property <string> current-account-user;
    in property <bool> loading-rooms;
    in property <bool> loading-history;
    // The open room is an invitation: show Accept / Decline instead of chat.
    in property <bool> current-invite;
    // The open room is only being previewed (not joined): a Join bar
    // replaces the message box.
    in property <bool> current-preview;
    in property <string> preview-info;
    in property <string> preview-note;
    in property <bool> preview-busy;
    callback preview-join();
    callback preview-close();
    callback space-preview(string);
    callback explore-preview(string);
    in property <string> invite-from;
    in property <bool> has-older;
    // Suggested servers for sign-in / sign-up, then "Other server…".
    in property <[string]> login-servers;
    in property <bool> can-moderate;

    // Composer
    in-out property <string> draft;
    // Voice messages: whether this device can record them, and the one
    // being recorded (its time so far and recent loudness, 0–1).
    in-out property <bool> voice-available;
    in-out property <bool> recording;
    in-out property <string> record-time: "0:00";
    in-out property <[float]> record-levels;
    callback voice-start();
    callback voice-cancel();
    callback voice-send();
    // An empty message box: the microphone where Send would be (as in Element X).
    property <bool> show-mic: Prefs.voice-messages && root.voice-available && root.draft == "" && root.pending-files.length == 0 && root.editing == "" && root.current-room != "";
    // The spell check looks again once typing pauses.
    changed draft => { root.spell-refresh(); }
    // The screen's edges (status and navigation bars), and on phones the
    // on-screen keyboard: what it covers is kept clear, so the message box
    // sits above it while you type.
    // Only while something is being typed in: leaving a room took the
    // message box away at once, but the phone says its keyboard has gone
    // only a while later, and until then the room list was laid out short
    // with a black band where the keyboard had been.
    function fit-insets() {
        Safe.top = self.safe-area-insets.top;
        Safe.left = self.safe-area-insets.left;
        Safe.right = self.safe-area-insets.right;
        Safe.bottom = max(self.safe-area-insets.bottom,
            self.typing-in && self.virtual-keyboard-size.height > 0 ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px);
    }
    property <bool> typing-in: TextInputInterface.text-input-focused;
    changed typing-in => { root.fit-insets(); }
    changed safe-area-insets => { root.fit-insets(); }
    changed virtual-keyboard-size => { root.fit-insets(); }
    changed virtual-keyboard-position => { root.fit-insets(); }
    changed height => { root.fit-insets(); }
    in-out property <string> reply-to;
    in property <string> reply-label;
    in-out property <string> editing;
    in-out property <bool> stick-bottom: true;
    // "Bob is typing…" for the open room, or "".
    in property <string> typing-text;
    // Offered while typing @name or :emoji (kind 0 person, 1 emoji).
    in property <[Suggestion]> suggestions;
    callback draft-edited(string);
    callback pick-suggestion(string, string);
    // Bumping `cursor-request` puts the composer's cursor at byte
    // `cursor-at` (after Rust changes the draft).
    in-out property <int> cursor-request;
    in-out property <int> cursor-at;
    // Bumping it puts the typing cursor back in the composer.
    in-out property <int> focus-request;
    changed reply-to => { if root.reply-to != "" { root.focus-request += 1; } }
    changed editing => { root.focus-request += 1; }
    // On a phone the keyboard only comes up when you tap the message box:
    // opening a chat, scrolling and looking at pictures or videos put it away.
    changed current-room => { if Prefs.touch { root.blur-request += 1; } else { root.focus-request += 1; } }
    in-out property <int> blur-request;
    changed blur-request => { if Prefs.touch { back-keys.focus(); } }
    changed viewer-open => { if root.viewer-open { root.blur-request += 1; } root.viewer-menu = false; }
    // Phones: the open picture's menu (after holding it) is up.
    property <bool> viewer-menu;
    property <bool> video-large: Player.large;
    changed video-large => { if root.video-large { root.blur-request += 1; } }
    changed emoji-open => { if !root.emoji-open { root.focus-request += 1; } }
    // The highlighted @/:emoji: suggestion (arrow keys move it).
    property <int> sug-index;
    changed suggestions => { root.sug-index = 0; }
    // The highlighted emoji in the picker: row and column.
    property <int> emoji-row;
    property <int> emoji-col;
    changed emoji-rows => { root.emoji-row = 0; root.emoji-col = 0; }
    function pick-emoji(symbol: string, close: bool) {
        if root.emoji-for == "" {
            root.draft = root.draft + symbol;
            root.cursor-at = TextTools.bytes(root.draft);
            root.cursor-request += 1;
            if close { root.emoji-open = false; }
        } else {
            root.message-action("react:" + symbol, root.emoji-for);
            root.emoji-open = false;
        }
    }

    // Overlays
    in-out property <string> select-text;
    in-out property <string> select-title: "Select text";
    // The read-receipt list: who read up to a message.
    in-out property <[Reader]> readers-list;
    in-out property <bool> readers-open;
    in-out property <image> viewer-image;
    // Animated pictures in the viewer: frames shown in turn, looping.
    in property <[image]> viewer-frames;
    in property <int> viewer-frame-ms;
    property <int> viewer-frame;
    in-out property <bool> viewer-open;
    in-out property <int> viewer-percent;
    // The message a reply was clicked for: scrolled to and lit, then cleared.
    in-out property <string> jump-id;
    Timer { interval: 1.8s; running: root.jump-id != ""; triggered => { root.jump-id = ""; } }
    // The message the viewer shows (for Save / Forward).
    in property <string> viewer-id;
    // Forward to…
    in-out property <bool> forward-open;
    in-out property <string> forward-query;
    in property <string> forward-status;
    in property <[ForwardItem]> forward-rooms;
    callback forward-search(string);
    callback forward-to(string);
    // Which account sends it (any signed-in one; the message's own at first).
    in property <[AccountItem]> forward-accounts;
    in property <string> forward-account;
    callback forward-pick-account(string);
    // The open room is a space: its page lists the rooms in it.
    in property <bool> current-space;
    in property <[SpaceRoomItem]> space-rooms;
    in property <bool> space-loading;
    in property <string> space-status;
    callback space-join(string);
    // Sharing files or text from another app: pick an account (step 0),
    // then a room (step 1). The rooms are `forward-rooms`.
    in-out property <bool> share-open;
    in property <string> share-what;
    in property <int> share-step;
    in property <string> share-account-name;
    in property <[AccountItem]> share-accounts;
    in-out property <string> share-query;
    in property <string> share-status;
    in property <bool> share-busy;
    callback share-pick-account(string);
    callback share-search(string);
    callback share-to(string);
    callback share-back();
    callback share-cancel();
    // Emoji picker: `emoji-for` is the message to react to, or "" to type into the composer.
    in-out property <bool> emoji-open;
    in-out property <string> emoji-for;
    in property <[EmojiRow]> emoji-rows;
    in property <[QuickReaction]> quick-reactions;
    callback emoji-search(string);
    // Account being dragged in the rail (-1: none) and how far.
    property <int> rail-drag-from: -1;
    property <length> rail-drag-dy;
    in-out property <bool> profile-open;
    in-out property <bool> room-info-open;
    // Phones: the big menu of the message held down (see MessageSheet).
    property <bool> sheet-open;
    property <MessageItem> sheet-item;
    // Which list it's from: "m" the room, "t" a thread.
    property <string> sheet-list;
    property <bool> panel-open: root.profile-open || root.room-info-open || root.thread-open;
    // Thread panel: the thread's messages, and sending into it.
    in-out property <bool> thread-open;
    in property <[MessageItem]> thread-messages;
    callback thread-send(string);
    in-out property <string> confirm-mod;
    // Verification
    in-out property <bool> verify-open;
    in property <string> verify-state;
    in property <string> verify-name;
    in property <bool> verify-self;
    in property <string> verify-message;
    in property <[EmojiItem]> verify-emojis;
    callback verify-action(string);
    in property <RoomDetails> room-details;
    in property <[MemberItem]> members;
    in property <[PinnedItem]> pinned;
    // The room panel's list of files sent in the room.
    in property <[FileItem]> files;
    in property <bool> files-shown;
    in property <bool> files-loading;
    in property <bool> files-more;
    in property <string> files-note;
    in property <bool> members-loading;
    in-out property <string> room-info-status;
    in-out property <bool> create-open;
    in-out property <bool> create-public: false;
    in-out property <bool> create-encrypted: true;
    in-out property <bool> info-editing;
    in-out property <string> create-error;
    in property <bool> profile-loading;
    in-out property <Profile> profile;

    // Settings
    in property <[NavItem]> nav;
    in-out property <string> nav-selected;
    in property <AccountForm> account-form;
    // The open account's sessions, and how loading them went.
    in property <[DeviceRow]> devices;
    in property <string> devices-status;
    in property <AgentForm> agent-form;
    in property <[string]> models;
    in property <[string]> image-models;
    in property <string> default-model;
    in property <string> default-image-model;
    in-out property <string> settings-message;
    in-out property <string> detect-status;
    in-out property <string> test-status;
    in property <string> encryption-summary;

    in-out property <bool> exploring;
    in property <[PublicItem]> public-rooms;
    in property <bool> explore-busy;
    in property <bool> explore-has-more;
    in property <string> explore-status;
    in-out property <bool> show-login;
    in-out property <bool> login-agent;
    in-out property <string> login-error;
    // A sign-up step waiting for the person: 0 none, 1 the server's
    // captcha (picture, answer), 2 a step done on the server's own page.
    in property <int> signup-step;
    in property <image> signup-picture;
    in property <string> signup-stage;
    in property <string> signup-note;
    // 0 cancel, 1 answer (text), 2 new picture, 3 done, 4 copy link, 5 open page
    callback signup-answer(int, string);
    in-out property <string> room-search;

    // On phones one pane shows at a time: 1 rooms, 2 chat.
    in-out property <int> pane: 1;
    // The room list is folded away (double-clicking an account toggles it).
    in-out property <bool> rooms-hidden;
    // Remembered for next time.
    callback rooms-hidden-changed(bool);
    // Rooms were dragged into an order of their own.
    in property <bool> rooms-ordered;
    // A room or space dropped this many pixels below (above, if negative) where it was.
    callback move-room(string, float);
    changed rooms-hidden => { root.rooms-hidden-changed(root.rooms-hidden); }
    property <bool> narrow: root.width < 760px;

    callback unlock(string);
    callback unlock-more(string);
    callback lock-hidden();
    callback create-hidden(string);
    callback lock();
    callback filter-tag(string);
    callback select-account(string);
    callback select-room(string);
    callback search-rooms(string);
    callback send(string);
    callback attach();
    // "Create a poll" dialog.
    in-out property <bool> poll-open;
    in-out property <string> poll-question;
    in-out property <string> poll-answers;
    in-out property <bool> poll-disclosed: true;
    in-out property <bool> poll-multi;
    in-out property <string> poll-error;
    callback create-poll(string, string, bool, bool);
    function open-poll() {
        root.poll-question = "";
        root.poll-answers = "";
        root.poll-disclosed = true;
        root.poll-multi = false;
        root.poll-error = "";
        root.poll-open = true;
    }
    // Files picked to go with the next message (names), and taking one off.
    in property <[string]> pending-files;
    callback remove-pending-file(int);
    // The reply bar was closed: the next message isn't a reply.
    callback cancel-reply();
    callback load-older();
    callback message-action(string, string);
    callback open-link(string);
    callback login(string, string, string, string, string, bool, bool, string);
    callback account-menu(string, string);
    callback room-menu(string, string);
    callback explore-search(string, string);
    callback explore-more();
    callback explore-join(string);
    callback open-settings(string);
    callback set-theme(int);
    callback set-auto-lock(int);
    callback save-account(AccountForm);
    callback recover(string);
    callback logout(string);
    callback detect-api(string, string);
    callback save-agent(AgentForm);
    callback test-agent(AgentForm);
    callback remove-agent();
    callback change-passphrase(string, string);
    callback activity();
    callback profile-action(string, string);
    callback profile-requested(string);
    callback profile-edit(string, string, string);
    callback open-room-info();
    callback room-files(string);
    callback room-invite(string);
    callback room-edit(string, string);
    callback room-avatar(string);
    in property <image> card-picture;
    callback card-action(string, AgentForm);
    callback filter-models(string);
    callback filter-image-models(string);
    callback create-room(string, string, bool, string, bool, string);

    callback to-background();
    // Closes what's on top (Back on Android); false when nothing is.
    function go-back() -> bool {
        if root.sheet-open { root.sheet-open = false; return true; }
        if root.recording { root.voice-cancel(); return true; }
        if Player.large && Player.id != "" { Player.set-large(false); return true; }
        if root.viewer-menu { root.viewer-menu = false; return true; }
        if root.viewer-open { root.viewer-open = false; return true; }
        if root.emoji-open { root.emoji-open = false; return true; }
        if root.picker-open { root.picker-finish(false); return true; }
        if root.select-text != "" { root.select-text = ""; return true; }
        if root.sticker-save-open { root.sticker-save-open = false; return true; }
        if root.poll-open { root.poll-open = false; return true; }
        if root.stickers-open { root.stickers-open = false; return true; }
        if root.topic-open { root.topic-open = false; return true; }
        if root.readers-open { root.readers-open = false; return true; }
        if root.clear-open { root.clear-open = false; return true; }
        if root.forward-open { root.forward-open = false; return true; }
        if root.share-open { if !root.share-busy { root.share-cancel(); } return true; }
        if root.create-open { root.create-open = false; return true; }
        if root.verify-open { root.verify-open = false; return true; }
        if root.show-login { root.show-login = false; return true; }
        if root.screen == 2 { root.settings-message = ""; root.screen = 1; return true; }
        if root.screen != 1 { return false; }
        if root.narrow && root.panel-open { root.close-panel(); return true; }
        if root.narrow && root.pane == 2 { root.pane = 1; return true; }
        if root.exploring { root.exploring = false; return true; }
        false
    }
    // Back on a phone works after unlocking too (the passphrase box had the focus).
    changed screen => { if Prefs.touch { back-keys.focus(); } }

    // Closes the side panel (profile, room info, thread).
    function close-panel() {
        root.profile-open = false;
        root.room-info-open = false;
        root.info-editing = false;
        root.thread-open = false;
    }
    // Opens a profile card at once with what we already know; Rust fills in the rest.
    public function show-profile(user: string, name: string, initial: string, hue: int, avatar: image) {
        root.profile = { user-id: user, name: name, initial: initial, hue: hue, avatar: avatar, verified: -1 };
        root.confirm-mod = "";
        root.pane = 2;
        root.profile-open = true;
        root.profile-requested(user);
    }
    callback set-show-events(bool);
    callback set-show-hidden(bool);
    callback set-allow-screenshots(bool);
    callback set-typst(bool);
    callback set-forward-as-is(bool);
    callback set-twin-keys(bool);
    callback set-auto-update(bool);
    callback check-update();
    callback install-update();
    callback set-dev-mode(bool);
    callback set-notify-level(int);
    callback set-key-sharing(int);
    callback set-link-previews(int);
    callback set-invidious(string);
    callback set-send-typing(bool);
    callback set-voice-messages(bool);
    callback set-autocorrect(bool);
    callback set-spell-check(bool);
    // Spell check: red lines under misspelled words in the composer, and
    // for the word right-clicked, suggestions (set just before the menu opens).
    in property <[SpellMark]> spell-marks;
    in property <string> spell-word;
    in property <[string]> spell-suggestions;
    callback spell-refresh();
    callback spell-replace(string);
    callback spell-add();
    callback set-link-posters(bool);
    callback set-ask-file-servers(bool);
    callback set-ask-room-servers(bool);
    callback set-upload(string, int);
    callback set-clear-command(string);
    // "Clear messages" dialog: open, and delete the newest `n` (0 = all).
    in-out property <bool> clear-open;
    // The dialog is for your own messages only (you can't delete others').
    in-out property <bool> clear-own;
    callback clear-messages(int);
    callback set-menu-entry(string, bool);

    function apply-theme() {
        Palette.color-scheme = root.theme == 0 ? ColorScheme.dark : root.theme == 1 ? ColorScheme.light : ColorScheme.unknown;
        Theme.dark = root.theme == 0 || (root.theme == 2 && Palette.color-scheme == ColorScheme.dark);
    }
    init => { root.apply-theme(); root.fit-insets(); }
    changed theme => { root.apply-theme(); }

    // Copies to the system clipboard through a hidden text field.
    clip := TextInput { width: 0; height: 0; opacity: 0; read-only: true; }
    public function copy-text(t: string) {
        clip.text = t;
        clip.select-all();
        clip.copy();
        root.status = "Copied";
    }

    function do-send() {
        if root.draft != "" || (root.pending-files.length > 0 && root.editing == "") {
            root.activity();
            root.send(root.draft);
            root.draft = "";
            root.stick-bottom = true;
        }
    }

    // Android's Back button closes what's open (a picture, a dialog, the
    // settings, a chat on a phone) instead of Whisker, which would lock it.
    // With nothing open it sends Whisker to the background, still unlocked.
    // (It reaches only what has the keyboard focus and the elements around
    // it, so this wraps everything and takes the focus back when it's lost.)
    back-keys := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        init => { if Prefs.touch { self.focus(); } }
        capture-key-pressed(e) => {
            // Any key counts as use for auto-lock, not only clicks.
            root.activity();
            if e.text != Key.Back { return reject; }
            if !root.go-back() { root.to-background(); }
            self.focus();
            accept
        }

        if root.screen == 0: UnlockScreen {
            y: Safe.top;
            height: root.height - Safe.top - Safe.bottom;
            first-run: root.first-run;
            error: root.error;
            busy: root.busy;
            sharing: root.share-what;
            submit(p) => { root.unlock(p); }
        }

        if root.screen == 1: HorizontalLayout {
            y: Safe.top;
            height: root.height - Safe.top - Safe.bottom;
            // Account rail (on phones, only with the room list: a chat gets the whole width)
            if !root.narrow || (root.pane == 1 && !root.panel-open): Rectangle {
                width: 64px;
                background: Theme.rail;
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 2px;
                    Flickable {
                        vertical-stretch: 1;
                        content-height: rail-list.preferred-height;
                        rail-list := VerticalLayout {
                            spacing: 2px;
                            for a[i] in root.accounts: RailAccount {
                                item: a;
                                index: i;
                                count: root.accounts.length;
                                drag-from: root.rail-drag-from;
                                drag-dy: root.rail-drag-dy;
                                selected: a.id == root.current-account;
                                clicked => { root.activity(); root.current-account = a.id; root.select-account(a.id); root.pane = 1; if root.narrow { root.close-panel(); } }
                                double-clicked => { if !root.narrow { root.rooms-hidden = !root.rooms-hidden; } }
                                dragging(dy) => {
                                    root.rail-drag-from = dy != 0 ? i : -1;
                                    root.rail-drag-dy = dy;
                                }
                                dropped(steps) => {
                                    if steps != 0 { root.account-menu("move:" + steps, a.id); }
                                    root.rail-drag-from = -1;
                                    root.rail-drag-dy = 0;
                                }
                                menu(action) => {
                                    if action == "copy" { root.copy-text(a.user-id); } else { root.account-menu(action, a.id); }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                padding-top: 4px;
                                IconBtn { icon: "+"; size: 42px; clicked => { root.activity(); root.login-error = ""; root.login-agent = false; root.show-login = true; } }
                            }
                        }
                    }
                    if root.tags.length > 0: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 52px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.tag-filter == "" ? Theme.raised : Theme.accent-soft;
                            Text { text: root.tag-filter == "" ? "all" : root.tag-filter; font-size: 11px; color: Theme.text; overflow: elide; width: 46px; horizontal-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.filter-tag(root.tag-filter); } }
                        }
                    }
                    HorizontalLayout { alignment: center; IconBtn { gear: true; clicked => { root.activity(); root.open-settings(""); } } }
                    HorizontalLayout { alignment: center; IconBtn { padlock: true; clicked => { root.lock(); } } }
                }
            }

            // Rooms (the button at the top left of a chat, or a double-click on an
            // account, folds them away to just the rail)
            if (!root.narrow && !root.rooms-hidden) || (root.narrow && root.pane == 1): Rectangle {
                width: root.narrow ? root.width - 64px : 290px;
                background: Theme.panel;
                VerticalLayout {
                    Rectangle {
                        height: 60px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: root.current-account-name == "" ? "No account" : root.current-account-name; font-size: 16px; font-weight: 800; color: Theme.text; overflow: elide; }
                                if root.current-account-user != "": Text { text: root.current-account-user; font-size: 11px; color: Theme.muted; overflow: elide; }
                            }
                            if root.current-account != "": VerticalLayout {
                                alignment: center;
                                IconBtn { icon: "+"; clicked => { root.activity(); root.create-error = ""; root.create-open = true; } }
                            }
                            if root.current-account != "": VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    icon: "#";
                                    active: root.exploring;
                                    clicked => {
                                        root.activity();
                                        root.exploring = true;
                                        root.pane = 2;
                                        if root.public-rooms.length == 0 { root.explore-search("", ""); }
                                    }
                                }
                            }
                            if root.current-account != "": VerticalLayout {
                                alignment: center;
                                IconBtn { icon: "⋯"; clicked => { root.activity(); root.open-settings("account:" + root.current-account); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 8px;
                        Input { placeholder: "Search rooms"; text <=> root.room-search; edited(t) => { root.search-rooms(t); } }
                    }
                    if root.loading-rooms && root.rooms.length == 0: Text { text: "Syncing rooms…"; color: Theme.muted; horizontal-alignment: center; font-size: 12px; }
                    if !root.loading-rooms && root.current-account != "" && root.rooms.length == 0: Text {
                        text: root.room-search == "" ? "No rooms yet" : "No rooms match"; color: Theme.muted; horizontal-alignment: center; font-size: 12px;
                    }
                    if root.current-account == "": VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        padding: 20px;
                        spacing: 12px;
                        Text { text: "No accounts yet"; color: Theme.text; font-weight: 700; horizontal-alignment: center; }
                        Btn { text: "Add an account"; primary: true; clicked => { root.login-error = ""; root.login-agent = false; root.show-login = true; } }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for r in root.rooms: HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            RoomRow {
                                item: r;
                                selected: r.id == root.current-room && !root.exploring;
                                clicked => {
                                    root.activity();
                                    root.exploring = false; root.current-room = r.id; root.select-room(r.id); root.pane = 2; root.stick-bottom = true;
                                    // Phones: the chat shows, not a profile left open.
                                    if root.narrow { root.close-panel(); }
                                }
                                ordered: root.rooms-ordered;
                                menu(action) => { root.activity(); root.room-menu(action, r.id); }
                                dropped(dy) => { root.activity(); root.move-room(r.id, dy / 1px); }
                            }
                        }
                    }
                }
            }

            // Chat
            if (!root.narrow || root.pane == 2) && root.exploring: Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;
                VerticalLayout {
                    Rectangle {
                        height: 60px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            if root.narrow: VerticalLayout { alignment: center; IconBtn { icon: "‹"; clicked => { root.pane = 1; } } }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: "Public rooms"; font-size: 16px; font-weight: 800; color: Theme.text; }
                                Text { text: "Browse rooms anyone can join, on your server or another one."; font-size: 12px; color: Theme.muted; overflow: elide; }
                            }
                            VerticalLayout { alignment: center; IconBtn { icon: "✕"; clicked => { root.exploring = false; } } }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        q := Input {
                            placeholder: "Search rooms";
                            accepted => { root.explore-search(srv.text, q.text); }
                        }
                        srv := Input {
                            max-width: 220px;
                            horizontal-stretch: 0.5;
                            placeholder: "Server (yours)";
                            accepted => { root.explore-search(srv.text, q.text); }
                        }
                        Btn { text: "Search"; primary: true; height: 38px; clicked => { root.explore-search(srv.text, q.text); } }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        addr := Input { placeholder: "Or join by address, e.g. #room:matrix.org"; accepted => { root.explore-join(addr.text); } }
                        Btn { text: "Preview"; height: 38px; enabled: addr.text != ""; clicked => { root.explore-preview(addr.text); } }
                        Btn { text: "Join"; height: 38px; enabled: addr.text != ""; clicked => { root.explore-join(addr.text); } }
                        Btn { text: "Create a room"; height: 38px; clicked => { root.create-error = ""; root.create-open = true; } }
                    }
                    if root.explore-status != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-bottom: 6px;
                        Text { text: root.explore-status; color: Theme.muted; font-size: 12px; wrap: char-wrap; }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for p in root.public-rooms: Rectangle {
                            height: 76px;
                            background: pta.has-hover ? Theme.hover : transparent;
                            pta := TouchArea {}
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                VerticalLayout { alignment: center; Avatar { initial: p.initial; hue: p.hue; image: p.avatar; size: 44px; } }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: p.name; font-weight: 700; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: p.members; font-size: 11px; color: Theme.muted; }
                                    }
                                    if p.alias != "": Text { text: p.alias; font-size: 11px; color: Theme.muted; overflow: elide; }
                                    Text { text: p.topic; font-size: 12px; color: Theme.muted; overflow: elide; }
                                }
                                if !p.joined: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Preview"; enabled: !root.explore-busy; clicked => { root.explore-preview(p.id); } }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: p.joined ? "Open" : "Join";
                                        primary: !p.joined;
                                        enabled: !root.explore-busy;
                                        clicked => { root.explore-join(p.id); }
                                    }
                                }
                            }
                        }
                    }
                    if root.explore-has-more: HorizontalLayout {
                        padding: 10px;
                        alignment: center;
                        Btn { text: root.explore-busy ? "Loading…" : "Load more"; enabled: !root.explore-busy; clicked => { root.explore-more(); } }
                    }
                }
            }

            if (!root.narrow || root.pane == 2) && !root.exploring && !(root.narrow && root.panel-open): Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;
                VerticalLayout {
                    Rectangle {
                        height: 60px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            if root.narrow: VerticalLayout { alignment: center; IconBtn { icon: "‹"; clicked => { root.pane = 1; } } }
                            if !root.narrow: VerticalLayout { alignment: center; RoomsToggle { shown: !root.rooms-hidden; clicked => { root.rooms-hidden = !root.rooms-hidden; } } }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: root.current-room-name; font-size: 16px; font-weight: 800; color: Theme.text; overflow: elide; }
                                // A glimpse of the description; click it for all of it.
                                if root.current-room-topic != "": Text {
                                    text: root.current-room-topic;
                                    font-size: 12px; color: topic-ta.has-hover ? Theme.text : Theme.muted; overflow: elide;
                                    topic-ta := TouchArea { mouse-cursor: pointer; clicked => { root.activity(); root.open-topic(); } }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { if root.current-room != "" && !root.current-preview { root.open-room-info(); } } }
                            }
                            if root.current-room != "" && !root.current-preview: VerticalLayout {
                                alignment: center;
                                IconBtn { icon: "i"; clicked => { root.activity(); root.open-room-info(); } }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    if root.current-room != "" && root.current-invite: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 14px;
                        padding: 24px;
                        Text { text: root.current-room-name; font-size: 20px; font-weight: 800; color: Theme.text; horizontal-alignment: center; wrap: char-wrap; }
                        Text {
                            text: root.invite-from != "" ? root.invite-from + " invited you to this room." : "You've been invited to this room.";
                            color: Theme.muted; horizontal-alignment: center; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            Btn { text: "Accept"; primary: true; clicked => { root.activity(); root.room-menu("accept", root.current-room); } }
                            Btn { text: "Decline"; clicked => { root.activity(); root.room-menu("leave", root.current-room); } }
                        }
                    }
                    if root.current-room != "" && !root.current-invite && root.current-space: VerticalLayout {
                        vertical-stretch: 1;
                        padding: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Rooms in this space"; font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                            Btn { text: "Invite people…"; clicked => { root.activity(); root.open-room-info(); } }
                            Btn { text: "Space info"; clicked => { root.activity(); root.open-room-info(); } }
                        }
                        if root.space-status != "": Text { text: root.space-status; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if root.space-loading && root.space-rooms.length == 0: Text { text: "Loading rooms…"; color: Theme.muted; }
                        if !root.space-loading && root.space-rooms.length == 0: Text { text: "This space has no rooms yet."; color: Theme.muted; }
                        spsv := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: splist.preferred-height;
                            splist := VerticalLayout {
                                width: spsv.visible-width;
                                alignment: start;
                                spacing: 4px;
                                for sr in root.space-rooms: Rectangle {
                                    height: 60px;
                                    border-radius: 10px;
                                    background: spta.has-hover ? Theme.hover : transparent;
                                    ContextMenuArea {
                                        Menu {
                                            if sr.joined: MenuItem { title: "Open"; activated => { root.activity(); root.current-room = sr.id; root.select-room(sr.id); root.stick-bottom = true; } }
                                            if !sr.joined && !sr.space: MenuItem { title: "Preview"; activated => { root.activity(); root.space-preview(sr.id); } }
                                            if !sr.joined: MenuItem { title: "Join"; enabled: !sr.busy; activated => { root.activity(); root.space-join(sr.id); } }
                                            if sr.joined && !sr.space: MenuItem { title: "Mark as read"; activated => { root.activity(); root.room-menu("read", sr.id); } }
                                            if sr.joined: MenuItem { title: sr.space ? "Space info" : "Room info"; activated => { root.activity(); root.room-menu("info", sr.id); } }
                                            if sr.joined: MenuItem { title: "Invite people…"; activated => { root.activity(); root.room-menu("info", sr.id); } }
                                            MenuItem { title: sr.space ? "Copy space address" : "Copy room address"; activated => { root.room-menu("copy", sr.id); } }
                                            MenuItem { title: "Copy room id"; activated => { root.copy-text(sr.id); } }
                                            if sr.joined: MenuSeparator {}
                                            if sr.joined: MenuItem { title: sr.space ? "Leave space" : "Leave room"; activated => { root.activity(); root.room-menu("leave", sr.id); } }
                                        }
                                    }
                                    spta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.activity();
                                            if sr.joined { root.current-room = sr.id; root.select-room(sr.id); root.stick-bottom = true; } else if !sr.space { root.space-preview(sr.id); }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 10px;
                                        VerticalLayout { alignment: center; Avatar { initial: sr.initial; hue: sr.hue; image: sr.avatar; size: 40px; } }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Text { text: sr.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                                if sr.space: Text { text: "Space"; color: Theme.accent; font-size: 11px; vertical-alignment: center; }
                                            }
                                            Text { text: sr.topic != "" ? sr.members + " · " + sr.topic : sr.members; color: Theme.muted; font-size: 12px; overflow: elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            if sr.joined: Btn { text: "Open"; clicked => { root.activity(); root.current-room = sr.id; root.select-room(sr.id); root.stick-bottom = true; } }
                                            if !sr.joined && !sr.space: Btn { text: "Preview"; enabled: !sr.busy; clicked => { root.activity(); root.space-preview(sr.id); } }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            if !sr.joined: Btn { text: sr.busy ? "Joining…" : "Join"; primary: true; enabled: !sr.busy; clicked => { root.activity(); root.space-join(sr.id); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.current-room != "" && !root.current-invite && !root.current-space: Rectangle {
                        vertical-stretch: 1;
                        if root.loading-history && root.messages.length == 0: Text { text: "Loading messages…"; color: Theme.muted; }
                        if !root.loading-history && root.messages.length == 0: Text {
                            text: root.current-preview ? root.preview-note : "No messages yet. Say hi!";
                            color: Theme.muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            width: min(parent.width - 48px, 420px);
                        }
                        // A plain scroll area (not ListView): ListView sizes rows before
                        // they wrap, so long messages overlapped the next ones.
                        msgs := ScrollView {
                            content-width: self.visible-width;
                            content-height: col.preferred-height;
                            // Where you are, as the distance from the end of the
                            // conversation. Kept when things load: older messages
                            // added above and pictures growing as they arrive don't
                            // move what you're reading. At the end, it stays at the end.
                            property <length> from-bottom: 0px;
                            // The sizes the last time it was put in place.
                            property <length> seen-height: 0px;
                            property <length> seen-visible: 0px;
                            // Where a scroll by hand started (it puts the phone keyboard away
                            // once it has gone a little way).
                            property <length> blur-from: 0px;
                            // Keeps your place when the content or the view changes
                            // size. Where you are is read from the scroll position
                            // now (with the sizes it was at), not from the last drag:
                            // a fling or wheel keeps moving after that, and going by
                            // the old place made the view leap.
                            function settle() {
                                if !root.stick-bottom && self.seen-height > 0px {
                                    self.from-bottom = max(0px, self.seen-height + self.content-y - self.seen-visible);
                                }
                                self.content-y = min(0px, self.visible-height - self.content-height + (root.stick-bottom ? 0px : self.from-bottom));
                                self.seen-height = self.content-height;
                                self.seen-visible = self.visible-height;
                                self.blur-from = self.content-y;
                            }
                            // The message box got the focus: scrolling from here on puts it away.
                            property <int> typing: root.focus-request + root.cursor-request;
                            changed typing => { self.blur-from = self.content-y; }
                            changed content-height => { self.settle(); }
                            changed visible-height => { self.settle(); }
                            scrolled => {
                                // Reading counts as use for auto-lock.
                                root.activity();
                                if Prefs.touch && abs(self.content-y - self.blur-from) > 24px { root.blur-request += 1; }
                                root.stick-bottom = self.content-y <= self.visible-height - self.content-height + 40px;
                                self.from-bottom = max(0px, self.content-height + self.content-y - self.visible-height);
                            }
                            col := VerticalLayout {
                                width: msgs.visible-width;
                                padding-bottom: 16px;
                                for m in root.messages: MessageRow {
                                    item: m;
                                    // A click on a reply to this message: scroll it into view.
                                    flash: root.jump-id == m.id;
                                    away: self.y + self.height < -msgs.content-y - 600px || self.y > msgs.visible-height - msgs.content-y + 600px;
                                    changed flash => {
                                        if self.flash {
                                            root.stick-bottom = false;
                                            msgs.content-y = min(0px, max(msgs.visible-height - msgs.content-height, 80px - self.y));
                                            msgs.from-bottom = max(0px, msgs.content-height + msgs.content-y - msgs.visible-height);
                                        }
                                    }
                                    can-moderate: root.can-moderate;
                                    room-id: root.current-room;
                                    quick-reactions: root.quick-reactions;
                                    pick-reaction => { root.emoji-for = m.id; root.emoji-search(""); root.emoji-open = true; }
                                    show-readers(list) => { root.readers-list = list; root.readers-open = true; }
                                    hold(it) => { root.sheet-item = it; root.sheet-list = "m"; root.sheet-open = true; }
                                    action(a, id) => {
                                        root.activity();
                                        // Room events (joins, kicks…) ask the app: the profile is
                                        // the person it's about, who may not be who did it.
                                        if a == "profile" && !m.notice {
                                            root.show-profile(m.sender, m.name, m.initial, m.hue, m.avatar);
                                        } else {
                                            root.message-action(a, id);
                                        }
                                    }
                                    copy(t) => { root.copy-text(t); }
                                    link(l) => { root.open-link(l); }
                                }
                            }
                        }
                        if root.has-older && msgs.content-y > -30px && !root.loading-history: Rectangle {
                            y: 8px;
                            height: 30px;
                            width: older.preferred-width + 24px;
                            border-radius: 15px;
                            background: Theme.raised;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000060;
                            older := Text { text: "Load older messages"; font-size: 12px; color: Theme.text; }
                            TouchArea { mouse-cursor: pointer; clicked => { msgs.from-bottom = max(0px, msgs.content-height + msgs.content-y - msgs.visible-height); root.stick-bottom = false; root.load-older(); } }
                        }
                        if !root.stick-bottom: Rectangle {
                            x: parent.width - 52px;
                            y: parent.height - 52px;
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.raised;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000060;
                            Text { text: "↓"; font-size: 18px; color: Theme.text; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.stick-bottom = true; msgs.content-y = min(0px, msgs.visible-height - msgs.content-height); }
                            }
                        }
                    }
                    if root.current-room == "": VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text { text: "Pick a room"; horizontal-alignment: center; color: Theme.muted; }
                    }

                    if root.typing-text != "" && root.current-room != "": HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        Text { text: root.typing-text; font-size: 11px; font-italic: true; color: Theme.muted; overflow: elide; }
                    }

                    if root.suggestions.length > 0 && root.current-room != "": HorizontalLayout {
                        padding-left: 60px;
                        padding-right: 120px;
                        Rectangle {
                            background: Theme.panel;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 4px;
                                for g[i] in root.suggestions: Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: i == root.sug-index ? Theme.accent-soft : sg-ta.has-hover ? Theme.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 10px;
                                        if g.picture.width > 0: VerticalLayout { alignment: center; Image { source: g.picture; width: 20px; height: 20px; } }
                                        if g.picture.width == 0: Text { text: g.label; color: Theme.text; font-size: g.kind == 1 ? 18px : 13px; font-weight: 600; vertical-alignment: center; }
                                        Text { text: g.detail; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        if i == root.sug-index: Text { text: "Tab"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                                    }
                                    sg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick-suggestion(g.insert, g.kind == 0 ? g.detail : ""); } }
                                }
                            }
                        }
                    }

                    // Reply / edit bar
                    if root.reply-to != "" || root.editing != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        padding-top: 6px;
                        spacing: 8px;
                        Rectangle { width: 3px; border-radius: 2px; background: Theme.accent; }
                        Text {
                            text: root.editing != "" ? "Editing your message" : "Replying to " + root.reply-label;
                            color: Theme.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
                        }
                        IconBtn { icon: "✕"; size: 24px; clicked => { if root.reply-to != "" { root.cancel-reply(); } root.reply-to = ""; if root.editing != "" { root.editing = ""; root.draft = ""; } } }
                    }

                    // Files waiting to go with the next message.
                    if root.pending-files.length > 0 && !root.current-preview: Flickable {
                        height: 40px;
                        content-width: max(self.width, pend-row.preferred-width);
                        pend-row := HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            padding-top: 8px;
                            spacing: 6px;
                            alignment: start;
                            for f[i] in root.pending-files: Rectangle {
                                height: 30px;
                                border-radius: 8px;
                                background: Theme.raised;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 2px;
                                    spacing: 4px;
                                    Text { text: "📎 " + f; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; max-width: 220px; }
                                    IconBtn { icon: "✕"; size: 26px; clicked => { root.remove-pending-file(i); } }
                                }
                            }
                            Text {
                                text: root.pending-files.length == 1 ? "Type a caption, or press Enter to send" : "Type a caption, or press Enter to send them";
                                color: Theme.muted; font-size: 11px; vertical-alignment: center;
                            }
                        }
                    }

                    // Looking at a room before joining it: Join instead of the composer.
                    if root.current-preview && root.current-room != "": Rectangle {
                        background: Theme.panel;
                        Rectangle { y: 0; height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            padding: 12px;
                            padding-left: 16px;
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Preview: you haven't joined this room"; color: Theme.text; font-weight: 700; overflow: elide; }
                                Text {
                                    text: root.messages.length > 0 && root.preview-note != "" ? root.preview-note : root.preview-info;
                                    color: Theme.muted; font-size: 12px; overflow: elide;
                                }
                            }
                            VerticalLayout { alignment: center; Btn { text: "Close"; clicked => { root.activity(); root.preview-close(); } } }
                            VerticalLayout { alignment: center; Btn { text: root.preview-busy ? "Joining…" : "Join"; primary: true; enabled: !root.preview-busy; clicked => { root.activity(); root.preview-join(); } } }
                        }
                    }
                    // Recording a voice message: in place of the message box.
                    if root.recording: HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout { alignment: center; IconBtn { icon: "🗑"; size: 40px; clicked => { root.activity(); root.voice-cancel(); } } }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 44px;
                            border-radius: 12px;
                            background: Theme.raised;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.danger; } }
                                Text { text: root.record-time; color: Theme.text; font-weight: 700; vertical-alignment: center; }
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    alignment: end;
                                    spacing: 2px;
                                    for l in root.record-levels: VerticalLayout {
                                        alignment: center;
                                        Rectangle { width: 3px; height: max(3px, l * 30px); border-radius: 1.5px; background: Theme.accent; }
                                    }
                                }
                            }
                        }
                        VerticalLayout { alignment: center; Btn { text: "Send"; primary: true; height: 40px; clicked => { root.activity(); root.voice-send(); } } }
                    }
                    // Composer
                    // (On phones the box gets the whole width; its buttons go in a row under it.)
                    if (!root.current-space || root.current-room == "") && !root.current-preview && !root.recording: HorizontalLayout {
                        padding: 12px;
                        padding-bottom: root.narrow ? 4px : 12px;
                        spacing: 8px;
                        alignment: stretch;
                        if !root.narrow: VerticalLayout {
                            alignment: end;
                            AttachBtn { file => { root.activity(); root.attach(); } poll => { root.activity(); root.open-poll(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            // Grows with what's typed (on phones up to 40% of the
                            // screen), then scrolls.
                            property <length> tallest: root.narrow ? max(160px, (root.height - Safe.top - Safe.bottom) * 0.4) : 160px;
                            // Tall enough for the cursor's line too: a word the phone's
                            // keyboard is still composing isn't in the text the box is
                            // measured by, and one that wrapped to a new line was hidden
                            // under the box's edge until it was finished.
                            height: min(self.tallest, max(40px, max(compose.preferred-height, compose-flick.cursor-bottom) + 20px));
                            border-radius: 12px;
                            background: Theme.raised;
                            border-width: compose.has-focus ? 1px : 0px;
                            border-color: Theme.accent;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                              compose-flick := Flickable {
                                // Scrolled by keeping the cursor in view (below), and by dragging on phones;
                                // a mouse drag selects text instead.
                                mouse-drag-pan-enabled: Prefs.touch;
                                content-width: self.width;
                                content-height: max(self.height, max(compose.preferred-height, self.cursor-bottom));
                                // The bottom of the cursor's line, in the text.
                                property <length> cursor-bottom: 0px;
                                // The cursor is on the last line: what's typed there stays
                                // in view as the text grows. Going by cursor moves alone
                                // missed text still being composed by a phone's keyboard,
                                // and a scroll position left over from before the box grew
                                // or shrank kept part of the text out of sight.
                                property <bool> at-end: true;
                                function settle() {
                                    if self.at-end {
                                        self.content-y = min(0px, self.height - self.content-height);
                                    } else {
                                        self.content-y = max(min(0px, self.height - self.content-height), min(0px, self.content-y));
                                    }
                                }
                                changed content-height => { self.settle(); }
                                changed height => { self.settle(); }
                                ContextMenuArea {
                                    width: compose-flick.width;
                                    height: compose-flick.content-height;
                                    Menu {
                                        for w in root.spell-suggestions: MenuItem { title: w; activated => { root.spell-replace(w); } }
                                        if root.spell-word != "" && root.spell-suggestions.length == 0: MenuItem { title: "No suggestions"; enabled: false; }
                                        if root.spell-word != "": MenuItem { title: "Add \"" + root.spell-word + "\" to dictionary"; activated => { root.spell-add(); } }
                                        if root.spell-word != "": MenuSeparator {}
                                        MenuItem { title: "Cut"; activated => { compose.cut(); root.draft-edited(compose.text); } }
                                        MenuItem { title: "Copy"; activated => { compose.copy(); } }
                                        MenuItem { title: "Paste"; activated => { compose.paste(); root.draft-edited(compose.text); } }
                                        MenuSeparator {}
                                        MenuItem { title: "Select all"; activated => { compose.focus(); compose.select-all(); } }
                                    }
                                    compose := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        // Found by the spell check (see spell_marks.rs).
                                        accessible-description: "composer";
                                        changed width => { root.spell-refresh(); }
                                        text <=> root.draft;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                        font-size: 14px;
                                        enabled: root.current-room != "";
                                        selection-background-color: Theme.accent-soft;
                                        edited => { root.draft-edited(self.text); }
                                        // Long messages: what you're typing stays in view.
                                        cursor-position-changed(p) => {
                                            compose-flick.cursor-bottom = p.y + 20px;
                                            compose-flick.at-end = p.y + 30px >= max(self.preferred-height, compose-flick.cursor-bottom);
                                            if p.y + compose-flick.content-y < 0px {
                                                compose-flick.content-y = -p.y;
                                            } else if p.y + 20px + compose-flick.content-y > compose-flick.height {
                                                compose-flick.content-y = min(0px, compose-flick.height - p.y - 20px);
                                            }
                                        }
                                        property <int> cursor-wanted: root.cursor-request;
                                        changed cursor-wanted => {
                                            self.set-selection-offsets(root.cursor-at, root.cursor-at);
                                            self.focus();
                                        }
                                        property <int> focus-wanted: root.focus-request;
                                        changed focus-wanted => { self.focus(); }
                                        key-pressed(e) => {
                                            if root.suggestions.length > 0 && e.text == Key.DownArrow {
                                                root.sug-index = mod(root.sug-index + 1, root.suggestions.length);
                                                return accept;
                                            }
                                            if root.suggestions.length > 0 && e.text == Key.UpArrow {
                                                root.sug-index = mod(root.sug-index - 1 + root.suggestions.length, root.suggestions.length);
                                                return accept;
                                            }
                                            if root.suggestions.length > 0 && (e.text == Key.Tab || (e.text == Key.Return && !e.modifiers.shift)) {
                                                root.pick-suggestion(root.suggestions[min(root.sug-index, root.suggestions.length - 1)].insert, root.suggestions[min(root.sug-index, root.suggestions.length - 1)].kind == 0 ? root.suggestions[min(root.sug-index, root.suggestions.length - 1)].detail : "");
                                                return accept;
                                            }
                                            if e.text == Key.Return && !e.modifiers.shift {
                                                root.do-send();
                                                return accept;
                                            }
                                            if e.text == Key.Escape {
                                                if root.reply-to != "" { root.cancel-reply(); }
                                                root.reply-to = "";
                                                if root.editing != "" { root.editing = ""; root.draft = ""; }
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                              }
                            }
                            // Red lines under misspelled words; places are in the
                            // text box's coordinates, which start at the padding
                            // (and move as it scrolls).
                            for m in root.spell-marks: Rectangle {
                                visible: m.y + compose-flick.content-y >= 0px && m.y + compose-flick.content-y < compose-flick.height;
                                x: 14px + m.x;
                                y: 10px + m.y + compose-flick.content-y;
                                width: m.w;
                                height: 2px;
                                border-radius: 1px;
                                background: #e5484d;
                            }
                            if root.draft == "": Text {
                                x: 14px;
                                y: 10px;
                                width: parent.width - 28px;
                                text: root.current-room == "" ? "" : "Message " + root.current-room-name + "   (Shift+Enter for a new line)";
                                overflow: elide;
                                color: Theme.muted;
                                font-size: 14px;
                            }
                        }
                        if !root.narrow: VerticalLayout {
                            alignment: end;
                            IconBtn {
                                icon: "🖼";
                                size: 40px;
                                active: root.stickers-open;
                                clicked => { root.activity(); root.open-stickers(); }
                            }
                        }
                        // Phones' keyboards have their own emoji key.
                        if !root.narrow && !Prefs.touch: VerticalLayout {
                            alignment: end;
                            IconBtn {
                                icon: "☺";
                                size: 40px;
                                active: root.emoji-open && root.emoji-for == "";
                                clicked => { root.activity(); root.emoji-for = ""; root.emoji-search(""); root.emoji-open = !root.emoji-open; }
                            }
                        }
                        if !root.narrow && root.show-mic: VerticalLayout {
                            alignment: end;
                            IconBtn { icon: "🎤"; size: 40px; clicked => { root.activity(); root.voice-start(); } }
                        }
                        if !root.narrow && !root.show-mic: VerticalLayout {
                            alignment: end;
                            Btn { text: root.editing != "" ? "Save" : "Send"; primary: true; height: 40px; enabled: root.current-room != "" && (root.draft != "" || root.pending-files.length > 0); clicked => { root.do-send(); } }
                        }
                    }
                    // Phones: the message box's buttons, under it.
                    if root.narrow && (!root.current-space || root.current-room == "") && !root.current-preview && !root.recording: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 10px;
                        spacing: 6px;
                        AttachBtn { file => { root.activity(); root.attach(); } poll => { root.activity(); root.open-poll(); } }
                        IconBtn { icon: "🖼"; size: 38px; active: root.stickers-open; clicked => { root.activity(); root.open-stickers(); } }
                        if !Prefs.touch: IconBtn {
                            icon: "☺";
                            size: 38px;
                            active: root.emoji-open && root.emoji-for == "";
                            clicked => { root.activity(); root.emoji-for = ""; root.emoji-search(""); root.emoji-open = !root.emoji-open; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.show-mic: IconBtn { icon: "🎤"; size: 38px; clicked => { root.activity(); root.voice-start(); } }
                        if !root.show-mic: Btn { text: root.editing != "" ? "Save" : "Send"; primary: true; height: 38px; enabled: root.current-room != "" && (root.draft != "" || root.pending-files.length > 0); clicked => { root.do-send(); } }
                    }
                    if root.status != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        Text { text: root.status; font-size: 11px; color: Theme.muted; wrap: char-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                        // Stops the downloads going on.
                        if root.downloading || root.uploading: IconBtn {
                            icon: "✕";
                            size: Prefs.touch ? 32px : 20px;
                            clicked => {
                                if root.downloading { root.cancel-downloads(); }
                                if root.uploading { root.cancel-uploads(); }
                            }
                        }
                    }
                }
            }

            // Side panel: a person's profile, or the room's details (Element-style).
            // Phones: the whole width (the account rail is hidden then).
            if root.panel-open && (!root.narrow || root.pane == 2): Rectangle {
                width: root.narrow ? root.width : 340px;
                background: Theme.panel;
                Rectangle { x: 0; width: 1px; background: Theme.border; }
                VerticalLayout {
                    Rectangle {
                        height: 60px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            if root.profile-open && root.room-info-open: VerticalLayout {
                                alignment: center;
                                IconBtn { icon: "‹"; clicked => { root.profile-open = false; } }
                            }
                            // Phones: back to the chat, as on the other panes.
                            if root.narrow && !(root.profile-open && root.room-info-open): VerticalLayout {
                                alignment: center;
                                IconBtn { icon: "‹"; clicked => { root.close-panel(); } }
                            }
                            Text {
                                text: root.profile-open ? "Profile" : root.room-info-open ? (root.current-space ? "Space info" : "Room info") : "Thread";
                                font-size: 16px; font-weight: 800; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn { icon: "✕"; clicked => { root.close-panel(); } }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    sv := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: panel-col.preferred-height;
                        panel-col := VerticalLayout {
                            width: sv.visible-width;
                            alignment: start;
                            padding: 16px;
                            spacing: 10px;

                            // ---- a person ----
                            if root.profile-open: VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                HorizontalLayout { alignment: center; Avatar { initial: root.profile.initial; hue: root.profile.hue; image: root.profile.avatar; size: 112px; } }
                                Text { text: root.profile.name; font-size: 20px; font-weight: 800; color: Theme.text; horizontal-alignment: center; wrap: char-wrap; }
                                ContextMenuArea {
                                    Menu {
                                        MenuItem { title: "Copy"; activated => { puid.copy(); } }
                                        MenuItem { title: "Select all"; activated => { puid.focus(); puid.select-all(); } }
                                    }
                                    puid := TextInput {
                                        text: root.profile.user-id;
                                        read-only: true; horizontal-alignment: center; font-size: 13px; color: Theme.muted; vertical-stretch: 0;
                                        selection-background-color: Theme.accent.transparentize(0.55);
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    if root.profile.role != "": Pill { text: root.profile.role; }
                                    if root.profile.verified == 2: Rectangle {
                                        height: 18px; width: vt.preferred-width + 12px; border-radius: 9px; background: Theme.ok.transparentize(0.75);
                                        vt := Text { text: "✓ Verified"; font-size: 10px; font-weight: 700; color: Theme.ok; }
                                    }
                                    if root.profile.verified == 1: Rectangle {
                                        height: 18px; width: nt.preferred-width + 12px; border-radius: 9px; background: Theme.raised;
                                        nt := Text { text: "Not verified"; font-size: 10px; font-weight: 700; color: Theme.muted; }
                                    }
                                    if root.profile.verified == 3: Rectangle {
                                        height: 18px; width: ct.preferred-width + 12px; border-radius: 9px; background: Theme.danger.transparentize(0.75);
                                        ct := Text { text: "⚠ Identity changed"; font-size: 10px; font-weight: 700; color: Theme.danger; }
                                    }
                                }
                                if root.profile.verified == 3: Text {
                                    text: "You verified this person before, but their encryption identity has changed since. Verify them again before trusting new messages.";
                                    font-size: 11px; color: Theme.danger; wrap: word-wrap; horizontal-alignment: center;
                                }
                                if root.profile-loading: Text { text: "Loading…"; color: Theme.muted; horizontal-alignment: center; font-size: 12px; }
                                Rectangle { height: 4px; }
                                if !root.profile.is-me: Btn {
                                    text: root.profile.has-dm ? "Message" : "Start a chat";
                                    primary: true;
                                    clicked => { root.profile-action("message", root.profile.user-id); }
                                }
                                if root.profile.verified == 1 || root.profile.verified == 3: Btn {
                                    text: root.profile.is-me ? "Verify this session" : root.profile.verified == 3 ? "Verify again" : "Verify";
                                    clicked => { root.profile-action("verify", root.profile.user-id); }
                                }
                                if root.profile.verified == 0 && !root.profile.is-me: Text {
                                    text: "This user hasn't set up encryption keys, so they can't be verified yet.";
                                    font-size: 11px; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center;
                                }
                                if root.profile.sessions.length > 0: VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "SESSIONS"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    for d in root.profile.sessions: HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: d.verified ? "✓" : "⚠"; color: d.verified ? Theme.ok : Theme.muted; font-size: 12px; width: 14px; }
                                        Text { text: d.name; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: d.id; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { text: "Mention"; horizontal-stretch: 1; clicked => { root.profile-action("mention", root.profile.user-id); } }
                                    Btn { text: "Copy address"; horizontal-stretch: 1; clicked => { root.copy-text(root.profile.user-id); } }
                                }
                                if !root.profile.is-me: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: "Send them read receipts"; color: Theme.text; font-size: 12px; }
                                        Text {
                                            text: "They see when you've read their messages, in chats with nobody else (or only others you've turned this on for). Everyone else still sees nothing.";
                                            font-size: 11px; color: Theme.muted; wrap: word-wrap;
                                        }
                                    }
                                    Switch {
                                        checked: root.profile.sees-reads;
                                        toggled => { root.profile-action(self.checked ? "reads-on" : "reads-off", root.profile.user-id); }
                                    }
                                }
                                if !root.profile.is-me && (root.profile.can-kick || root.profile.can-ban): VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    Text { text: "MODERATION"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        if root.profile.can-kick: Btn {
                                            text: root.confirm-mod == "kick" ? "Really kick?" : "Kick";
                                            danger: true;
                                            horizontal-stretch: 1;
                                            clicked => { if root.confirm-mod == "kick" { root.confirm-mod = ""; root.profile-action("kick", root.profile.user-id); } else { root.confirm-mod = "kick"; } }
                                        }
                                        if root.profile.can-ban: Btn {
                                            text: root.confirm-mod == "ban" ? "Really ban?" : "Ban";
                                            danger: true;
                                            horizontal-stretch: 1;
                                            clicked => { if root.confirm-mod == "ban" { root.confirm-mod = ""; root.profile-action("ban", root.profile.user-id); } else { root.confirm-mod = "ban"; } }
                                        }
                                    }
                                }
                                if root.profile.can-set-level: VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    Text { text: "ROLE IN THIS ROOM"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        for r in [{ name: "Member", level: 0 }, { name: "Moderator", level: 50 }, { name: "Admin", level: 100 }]: Btn {
                                            // Giving your own level (or lowering your own) can't be undone by you.
                                            property <bool> final: r.level != root.profile.level && (r.level >= root.profile.max-level || root.profile.is-me);
                                            property <string> key: "level:" + r.level;
                                            enabled: r.level <= root.profile.max-level;
                                            text: root.confirm-mod == self.key ? "Really?" : r.name;
                                            primary: r.level == root.profile.level;
                                            danger: root.confirm-mod == self.key;
                                            horizontal-stretch: 1;
                                            clicked => {
                                                if r.level == root.profile.level { return; }
                                                if !self.final || root.confirm-mod == self.key {
                                                    root.confirm-mod = "";
                                                    root.profile-action(self.key, root.profile.user-id);
                                                } else {
                                                    root.confirm-mod = self.key;
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        plevel := Input { placeholder: "Custom level (now " + root.profile.level + ")"; }
                                        Btn {
                                            property <string> key: "level:" + plevel.text.to-float().round();
                                            property <bool> final: plevel.text.to-float() >= root.profile.max-level || root.profile.is-me;
                                            text: root.confirm-mod == self.key ? "Really?" : "Set";
                                            danger: root.confirm-mod == self.key;
                                            enabled: plevel.text.is-float() && plevel.text.to-float() <= root.profile.max-level;
                                            clicked => {
                                                if !self.final || root.confirm-mod == self.key {
                                                    root.confirm-mod = "";
                                                    root.profile-action(self.key, root.profile.user-id);
                                                    plevel.text = "";
                                                } else {
                                                    root.confirm-mod = self.key;
                                                }
                                            }
                                        }
                                    }
                                    if root.confirm-mod != "" && root.confirm-mod != "kick" && root.confirm-mod != "ban": Text {
                                        text: root.profile.is-me ? "You're lowering your own level. You won't be able to raise it again yourself." : "They'll have as much power as you, and you won't be able to lower it again. Click again to confirm.";
                                        font-size: 11px; color: Theme.danger; wrap: word-wrap;
                                    }
                                }
                                if !root.profile.is-me: Text {
                                    text: "Ignore this user";
                                    font-size: 11px; color: Theme.muted; horizontal-alignment: center;
                                    TouchArea { mouse-cursor: pointer; clicked => { root.profile-action("ignore", root.profile.user-id); } }
                                }
                            }

                            // ---- a thread ----
                            if !root.profile-open && !root.room-info-open && root.thread-open: VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                for m in root.thread-messages: MessageRow {
                                    item: m;
                                    list: "t";
                                    can-moderate: root.can-moderate;
                                    room-id: root.current-room;
                                    quick-reactions: root.quick-reactions;
                                    pick-reaction => { root.emoji-for = m.id; root.emoji-search(""); root.emoji-open = true; }
                                    show-readers(list) => { root.readers-list = list; root.readers-open = true; }
                                    hold(it) => { root.sheet-item = it; root.sheet-list = "t"; root.sheet-open = true; }
                                    action(a, id) => {
                                        root.activity();
                                        // Room events (joins, kicks…) ask the app: the profile is
                                        // the person it's about, who may not be who did it.
                                        if a == "profile" && !m.notice {
                                            root.show-profile(m.sender, m.name, m.initial, m.hue, m.avatar);
                                        } else if a != "thread" {
                                            root.message-action(a, id);
                                        }
                                    }
                                    copy(t) => { root.copy-text(t); }
                                    link(l) => { root.open-link(l); }
                                }
                                if root.thread-messages.length <= 1: Text {
                                    text: "No replies yet.";
                                    font-size: 12px; color: Theme.muted; horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    treply := Input {
                                        placeholder: "Reply in thread";
                                        accepted(t) => { root.activity(); root.thread-send(t); self.text = ""; }
                                    }
                                    Btn { text: "Send"; primary: true; enabled: treply.text != ""; clicked => { root.activity(); root.thread-send(treply.text); treply.text = ""; } }
                                }
                            }

                            // ---- the room ----
                            if !root.profile-open && root.room-info-open: VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                HorizontalLayout {
                                    alignment: center;
                                    Avatar {
                                        initial: root.room-details.initial; hue: root.room-details.hue; image: root.room-details.avatar; size: 96px;
                                        if root.room-details.can-set-avatar: Rectangle {
                                            border-radius: self.width / 2;
                                            background: pic-ta.has-hover ? #00000080 : transparent;
                                            if pic-ta.has-hover: Text { text: "Change"; color: white; font-size: 12px; font-weight: 700; }
                                            pic-ta := TouchArea { mouse-cursor: pointer; clicked => { root.room-avatar("change"); } }
                                        }
                                    }
                                }
                                if root.room-details.can-set-avatar: HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Btn { text: "Change picture"; clicked => { root.room-avatar("change"); } }
                                    if root.room-details.avatar.width > 0: Btn { text: "Remove"; clicked => { root.room-avatar("remove"); } }
                                }
                                Text { text: root.room-details.name; font-size: 20px; font-weight: 800; color: Theme.text; horizontal-alignment: center; wrap: char-wrap; }
                                if root.room-details.alias != "": ContextMenuArea {
                                    Menu {
                                        MenuItem { title: "Copy"; activated => { ralias.copy(); } }
                                        MenuItem { title: "Select all"; activated => { ralias.focus(); ralias.select-all(); } }
                                    }
                                    ralias := TextInput {
                                        text: root.room-details.alias; read-only: true; horizontal-alignment: center; font-size: 12px; color: Theme.muted; vertical-stretch: 0;
                                        selection-background-color: Theme.accent.transparentize(0.55);
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    if root.room-details.encrypted: Pill { text: "Encrypted"; }
                                    Pill { text: root.room-details.join-rule; }
                                    Pill { text: root.room-details.members; }
                                }
                                if !root.info-editing: VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "DESCRIPTION"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    // Descriptions can be pages long (big rooms keep
                                    // their rules there): the first few lines here,
                                    // all of it, formatted, in a window of its own.
                                    // The fixed width keeps long lines from pushing
                                    // the panel off the screen.
                                    Rectangle {
                                        height: min(topic-peek.preferred-height, 90px);
                                        clip: true;
                                        topic-peek := Text {
                                            x: 0; y: 0;
                                            width: parent.width;
                                            text: root.room-details.topic == "" ? "No description." : root.room-details.topic;
                                            wrap: char-wrap; color: root.room-details.topic == "" ? Theme.muted : Theme.text;
                                        }
                                    }
                                    if root.room-details.topic != "": HorizontalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        Btn { text: "Read the full description"; clicked => { root.open-topic(); } }
                                        Btn { text: "Copy"; clicked => { root.copy-text(root.room-details.topic); } }
                                    }
                                }
                                if root.room-details.history != "" && !root.info-editing: Text { text: root.room-details.history; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                if root.pinned.length > 0 && !root.info-editing: VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "PINNED (RULES USUALLY LIVE HERE)"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    for p in root.pinned: Rectangle {
                                        background: Theme.raised;
                                        border-radius: 8px;
                                        VerticalLayout {
                                            padding: 8px;
                                            Text { text: p.who; font-size: 11px; font-weight: 700; color: Theme.muted; }
                                            ContextMenuArea {
                                                Menu {
                                                    MenuItem { title: "Copy"; activated => { ptext.copy(); } }
                                                    MenuItem { title: "Select all"; activated => { ptext.focus(); ptext.select-all(); } }
                                                }
                                                ptext := TextInput { text: p.text; read-only: true; single-line: false; wrap: word-wrap; color: Theme.text; selection-background-color: Theme.accent.transparentize(0.55); }
                                            }
                                        }
                                    }
                                }
                                if root.info-editing: VerticalLayout {
                                    spacing: 6px;
                                    ename := Input { text: root.room-details.name; placeholder: "Room name"; }
                                    etopic := TextEdit { text: root.room-details.topic; height: 110px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;
                                        Btn { text: "Cancel"; clicked => { root.info-editing = false; } }
                                        Btn { text: "Save"; primary: true; clicked => { root.room-edit(ename.text, etopic.text); root.info-editing = false; } }
                                    }
                                }
                                if root.room-details.can-edit && !root.info-editing: Btn { text: "Edit name and description"; clicked => { root.info-editing = true; } }
                                if root.room-details.can-invite: VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "INVITE"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        inv := Input { placeholder: "@name:server, @other:server"; accepted => { root.room-invite(inv.text); inv.text = ""; } }
                                        Btn { text: "Invite"; primary: true; height: 38px; enabled: inv.text != ""; clicked => { root.room-invite(inv.text); inv.text = ""; } }
                                    }
                                }
                                if root.room-info-status != "": Text { text: root.room-info-status; font-size: 12px; color: Theme.muted; wrap: char-wrap; }
                                if !root.current-space && !root.info-editing: VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "FILES"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                    if !root.files-shown: HorizontalLayout {
                                        alignment: start;
                                        Btn { text: "Show files"; clicked => { root.activity(); root.room-files("load"); } }
                                    }
                                    for f in root.files: Rectangle {
                                        height: 48px;
                                        border-radius: 8px;
                                        background: file-ta.has-hover ? Theme.hover : transparent;
                                        // Pictures open in the viewer; anything else is shown where it was sent.
                                        file-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.activity(); root.message-action(f.image ? "view" : "show-in-chat", f.id); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 38px;
                                                    height: 30px;
                                                    border-radius: 6px;
                                                    background: Theme.raised;
                                                    Text { text: f.kind; font-size: 9px; font-weight: 800; color: Theme.muted; }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                Text { text: f.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                                Text { text: f.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Btn { text: "Save"; clicked => { root.activity(); root.message-action("save", f.id); } }
                                            }
                                        }
                                    }
                                    if root.files-loading: Text { text: "Looking for files…"; font-size: 12px; color: Theme.muted; }
                                    if root.files-shown && !root.files-loading && root.files-note != "": Text { text: root.files-note; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    if root.files-shown && root.files-more && !root.files-loading: HorizontalLayout {
                                        alignment: start;
                                        Btn { text: "Look further back"; clicked => { root.activity(); root.room-files("more"); } }
                                    }
                                }
                                Text { text: "MEMBERS"; font-size: 10px; font-weight: 800; color: Theme.muted; }
                                if root.members-loading: Text { text: "Loading members…"; font-size: 12px; color: Theme.muted; }
                                for mem in root.members: Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    background: mta.has-hover ? Theme.hover : transparent;
                                    mta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.show-profile(mem.user-id, mem.name, mem.initial, mem.hue, mem.avatar); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 10px;
                                        VerticalLayout { alignment: center; Avatar { initial: mem.initial; hue: mem.hue; image: mem.avatar; size: 32px; } }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: mem.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                            Text { text: mem.user-id; color: Theme.muted; font-size: 11px; overflow: elide; }
                                        }
                                        if mem.role != "": VerticalLayout { alignment: center; Pill { text: mem.role; } }
                                    }
                                }
                                Rectangle { height: 6px; }
                                if !root.current-space: Btn { text: root.can-moderate ? "Clear messages…" : "Clear my messages…"; danger: true; clicked => { root.clear-own = !root.can-moderate; root.clear-open = true; } }
                                Btn { text: root.current-space ? "Leave space" : "Leave room"; danger: true; clicked => { root.room-menu("leave", root.room-details.id); root.room-info-open = false; } }
                            }
                        }
                    }
                }
            }
        }

        if root.screen == 2: SettingsPage {
            y: Safe.top;
            height: root.height - Safe.top - Safe.bottom;
            narrow: root.narrow;
            theme <=> root.theme;
            auto-lock <=> root.auto-lock;
            nav: root.nav;
            selected <=> root.nav-selected;
            account: root.account-form;
            devices: root.devices;
            devices-status: root.devices-status;
            agent: root.agent-form;
            models: root.models;
            image-models: root.image-models;
            default-model: root.default-model;
            default-image-model: root.default-image-model;
            message <=> root.settings-message;
            detect-status <=> root.detect-status;
            test-status <=> root.test-status;
            encryption-summary: root.encryption-summary;
            close => { root.settings-message = ""; root.screen = 1; }
            navigate(id) => { root.activity(); root.open-settings(id); }
            set-theme(t) => { root.set-theme(t); }
            set-auto-lock(i) => { root.set-auto-lock(i); }
            set-show-events(b) => { root.set-show-events(b); }
            set-show-hidden(b) => { root.set-show-hidden(b); }
            set-allow-screenshots(b) => { root.set-allow-screenshots(b); }
            set-typst(b) => { root.set-typst(b); }
            set-forward-as-is(b) => { root.set-forward-as-is(b); }
            set-twin-keys(b) => { root.set-twin-keys(b); }
            set-auto-update(b) => { root.set-auto-update(b); }
            check-update => { root.check-update(); }
            install-update => { root.install-update(); }
            set-dev-mode(b) => { root.set-dev-mode(b); }
            set-notify-level(i) => { root.set-notify-level(i); }
            set-key-sharing(i) => { root.set-key-sharing(i); }
            set-link-previews(i) => { root.set-link-previews(i); }
            set-invidious(t) => { root.set-invidious(t); }
            set-send-typing(b) => { root.set-send-typing(b); }
            set-voice-messages(b) => { root.set-voice-messages(b); }
            set-autocorrect(b) => { root.set-autocorrect(b); }
            set-spell-check(b) => { root.set-spell-check(b); }
            set-link-posters(b) => { root.set-link-posters(b); }
            set-ask-file-servers(b) => { root.set-ask-file-servers(b); }
            set-ask-room-servers(b) => { root.set-ask-room-servers(b); }
            set-upload(k, v) => { root.set-upload(k, v); }
            set-clear-command(t) => { root.set-clear-command(t); }
            set-menu-entry(k, b) => { root.set-menu-entry(k, b); }
            save-account(f) => { root.activity(); root.save-account(f); }
            profile-edit(a, id, v) => { root.activity(); root.profile-edit(a, id, v); }
            recover(k) => { root.activity(); root.recover(k); }
            logout(id) => { root.logout(id); }
            new-ai => { root.login-error = ""; root.login-agent = true; root.show-login = true; }
            detect-api(u, k) => { root.activity(); root.detect-api(u, k); }
            save-agent(f) => { root.activity(); root.save-agent(f); }
            test-agent(f) => { root.activity(); root.test-agent(f); }
            remove-agent => { root.remove-agent(); }
            card-picture: root.card-picture;
            card-action(a, f) => { root.activity(); root.card-action(a, f); }
            filter-models(q) => { root.filter-models(q); }
            filter-image-models(q) => { root.filter-image-models(q); }
            change-passphrase(o, n) => { root.activity(); root.change-passphrase(o, n); }
            unlock-hidden(p) => { root.unlock-more(p); }
            lock-hidden => { root.activity(); root.lock-hidden(); }
            create-hidden(p) => { root.create-hidden(p); }
        }

        if root.show-login: LoginDialog {
            error: root.login-error;
            busy: root.busy;
            agent: root.login-agent;
            servers: root.login-servers;
            login(hs, u, p, t, px, ag, reg, tok) => { root.login(hs, u, p, t, px, ag, reg, tok); }
            step: root.signup-step;
            picture: root.signup-picture;
            stage: root.signup-stage;
            note: root.signup-note;
            answer(k, t) => { root.signup-answer(k, t); }
            dismiss => { root.signup-answer(0, ""); root.show-login = false; }
        }

        if root.select-text != "": Overlay {
            card-width: 640px;
            dismiss => { root.select-text = ""; root.select-title = "Select text"; }
            Text { text: root.select-title; font-size: 16px; font-weight: 800; color: Theme.text; }
            TextEdit { text: root.select-text; read-only: true; height: min(400px, root.height - 200px); wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: "Copy all"; clicked => { root.copy-text(root.select-text); } }
                Btn { text: "Close"; primary: true; clicked => { root.select-text = ""; root.select-title = "Select text"; } }
            }
        }

        if root.poll-open: Overlay {
            dismiss => { root.poll-open = false; }
            Text { text: "Create a poll"; font-size: 18px; font-weight: 800; color: Theme.text; }
            Input { text <=> root.poll-question; placeholder: "Question"; }
            Text { text: "Answers, one per line (2 to 20)"; color: Theme.muted; font-size: 12px; }
            TextEdit { text <=> root.poll-answers; height: 140px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "Show results while it's open"; color: Theme.text; }
                    Text { text: "Off: everyone sees the count only once you end it."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                }
                Switch { checked <=> root.poll-disclosed; }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "Allow more than one answer"; color: Theme.text; }
                }
                Switch { checked <=> root.poll-multi; }
            }
            if root.poll-error != "": Text { text: root.poll-error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Btn { text: "Cancel"; clicked => { root.poll-open = false; } }
                Btn { text: "Create"; primary: true; enabled: root.poll-question != "" && root.poll-answers != ""; clicked => { root.create-poll(root.poll-question, root.poll-answers, root.poll-disclosed, root.poll-multi); } }
            }
        }

        if root.sticker-save-open: Overlay {
            dismiss => { root.sticker-save-open = false; }
            Text { text: root.sticker-as-emoji ? "Save as emoji" : "Save as sticker"; font-size: 18px; font-weight: 800; color: Theme.text; }
            Text {
                text: root.sticker-as-emoji
                    ? "Give it a short name. Type :name: in a message to put it in the text, or pick it under React. Your list of emoji is kept in your vault, not on the server."
                    : "Give it a short name. Typing :name: then sends it, in any room. Your stickers are kept in your vault, not on the server.";
                color: Theme.muted; font-size: 12px; wrap: word-wrap;
            }
            if root.sticker-note != "": Text { text: root.sticker-note; color: Theme.text; font-size: 12px; wrap: word-wrap; }
            sname := Input {
                text <=> root.sticker-name;
                placeholder: "name (letters, numbers, - or _)";
                accepted(t) => { root.save-sticker(t); }
            }
            if root.sticker-error != "": Text { text: root.sticker-error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Btn { text: "Cancel"; clicked => { root.sticker-save-open = false; } }
                Btn { text: "Save"; primary: true; enabled: root.sticker-name != ""; clicked => { root.save-sticker(root.sticker-name); } }
            }
        }

        if root.stickers-open: Overlay {
            card-width: 460px;
            dismiss => { root.stickers-open = false; root.sticker-confirm = ""; }
            Text { text: "Stickers and emoji"; font-size: 18px; font-weight: 800; color: Theme.text; }
            if root.stickers.length == 0: Text {
                text: "No stickers or emoji yet. Right-click a picture in a chat and pick \"Save as sticker…\" or \"Save as emoji…\".";
                color: Theme.muted; font-size: 12px; wrap: word-wrap;
            }
            if root.stickers.length > 0: Text {
                text: (root.reply-to != "" ? "Click one to send it as your reply." : "Click one to send it, or type :name: in a message.")
                    + (Prefs.touch ? " Hold one to remove it." : " Right-click one (or ✕) to remove it.");
                color: Theme.muted; font-size: 12px; wrap: word-wrap;
            }
            Flickable {
                height: min(root.stickers.length * 72px, root.height - 240px);
                VerticalLayout {
                    for x in root.stickers: srow := Rectangle {
                        property <string> key: x.emoji ? "emoji:" + x.name : x.name;
                        property <bool> confirming: root.sticker-confirm == self.key;
                        height: 72px;
                        border-radius: 8px;
                        background: self.confirming ? Theme.danger.transparentize(0.85) : xta.has-hover ? Theme.hover : transparent;
                        // Phones: held still for a moment, it asks to be removed
                        // (and letting go then doesn't send it).
                        Timer {
                            interval: 450ms;
                            running: Prefs.touch && xta.pressed && !srow.confirming;
                            triggered => { root.sticker-confirm = srow.key; }
                        }
                        xta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.sticker-confirm == srow.key { return; }
                                root.sticker-confirm = "";
                                root.send-sticker(srow.key);
                            }
                            pointer-event(e) => {
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { root.sticker-confirm = srow.key; }
                            }
                        }
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 12px;
                            Rectangle {
                                width: 60px;
                                height: 60px;
                                if x.picture.width > 0: Image { source: x.picture; width: 60px; height: 60px; image-fit: contain; }
                                if x.picture.width == 0: Text { text: "…"; color: Theme.muted; }
                            }
                            Text { text: ":" + x.name + ":" + (x.emoji ? "  · emoji" : ""); color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if !srow.confirming: VerticalLayout { alignment: center; IconBtn { icon: "✕"; size: 28px; clicked => { root.sticker-confirm = srow.key; } } }
                            if srow.confirming: HorizontalLayout {
                                alignment: end;
                                spacing: 6px;
                                VerticalLayout { alignment: center; Btn { text: "Remove"; danger: true; clicked => { root.remove-sticker(root.sticker-confirm); root.sticker-confirm = ""; } } }
                                VerticalLayout { alignment: center; Btn { text: "Cancel"; clicked => { root.sticker-confirm = ""; } } }
                            }
                        }
                    }
                }
            }
            HorizontalLayout { alignment: end; Btn { text: "Close"; primary: true; clicked => { root.stickers-open = false; root.sticker-confirm = ""; } } }
        }

        if root.topic-open: Overlay {
            card-width: 720px;
            dismiss => { root.topic-open = false; }
            Text { text: root.topic-title == "" ? "Description" : root.topic-title; font-size: 16px; font-weight: 800; color: Theme.text; overflow: elide; }
            topic-sv := ScrollView {
                height: min(topic-col.preferred-height + 8px, root.height - 200px);
                content-width: self.visible-width;
                content-height: topic-col.preferred-height;
                topic-col := VerticalLayout {
                    width: topic-sv.visible-width;
                    padding-right: 8px;
                    Blocks {
                        key: "topic";
                        avail: topic-sv.visible-width - 8px;
                        blocks: root.topic-blocks;
                        link(l) => { root.open-link(l); }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Btn { text: "Copy"; clicked => { root.copy-text(root.topic-text); } }
                Btn { text: "Close"; primary: true; clicked => { root.topic-open = false; } }
            }
        }

        if root.sheet-open: MessageSheet {
            item: root.sheet-item;
            can-moderate: root.can-moderate;
            room-id: root.current-room;
            quick-reactions: root.quick-reactions;
            close => { root.sheet-open = false; }
            pick-reaction => { root.emoji-for = root.sheet-item.id; root.emoji-search(""); root.emoji-open = true; }
            action(a, id) => {
                root.activity();
                // As from the row itself (see MessageRow's action above).
                if a == "profile" && !root.sheet-item.notice {
                    root.show-profile(root.sheet-item.sender, root.sheet-item.name, root.sheet-item.initial, root.sheet-item.hue, root.sheet-item.avatar);
                } else if !(a == "thread" && root.sheet-list == "t") {
                    root.message-action(a, id);
                }
            }
            copy(t) => { root.copy-text(t); }
            link(l) => { root.open-link(l); }
        }

        if root.readers-open: Overlay {
            dismiss => { root.readers-open = false; }
            Text { text: root.readers-list.length == 1 ? "Read by 1 person" : "Read by " + root.readers-list.length + " people"; font-size: 16px; font-weight: 800; color: Theme.text; }
            Flickable {
                height: min(root.readers-list.length * 44px, root.height - 220px);
                VerticalLayout {
                    for r in root.readers-list: Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: rta.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Avatar { initial: r.initial; hue: r.hue; image: r.avatar; size: 30px; y: 7px; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                Text { text: r.user-id; color: Theme.muted; font-size: 11px; overflow: elide; }
                            }
                        }
                        rta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.readers-open = false; root.show-profile(r.user-id, r.name, r.initial, r.hue, r.avatar); }
                        }
                    }
                }
            }
            HorizontalLayout { alignment: end; Btn { text: "Close"; primary: true; clicked => { root.readers-open = false; } } }
        }

        if root.viewer-open: viewer := Rectangle {
            background: #000000e0;
            // A tap around the picture closes it. On phones it waits a moment
            // first: a second finger landing to pinch ends the first one's
            // touch, which counts as a tap, and so does the first tap of a
            // double tap; neither should close it.
            property <bool> closing;
            Timer {
                interval: 300ms;
                running: viewer.closing;
                triggered => {
                    viewer.closing = false;
                    if !zoomer.dragged && !pic.pressed && zoomer.zoom <= 1.01 && !root.viewer-menu { root.viewer-open = false; }
                }
            }
            TouchArea { clicked => { if Prefs.touch { viewer.closing = true; } else { root.viewer-open = false; } } }
            if root.viewer-image.width == 0: Text { text: root.viewer-percent > 0 ? "Loading… " + root.viewer-percent + "%" : "Loading…"; color: white; }
            vcm := ContextMenuArea {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width - 40px;
                height: parent.height - 80px;
                // Phones get the rows that slide up on a hold instead.
                enabled: !Prefs.touch;
                Menu {
                    MenuItem { title: "Save image…"; activated => { root.message-action("save", root.viewer-id); } }
                    if Prefs.touch: MenuItem { title: "Share…"; activated => { root.message-action("share", root.viewer-id); } }
                    MenuItem { title: "Forward…"; activated => { root.viewer-open = false; root.message-action("forward", root.viewer-id); } }
                    MenuItem { title: "Copy link to message"; activated => { root.copy-text("https://matrix.to/#/" + root.current-room + "/" + root.viewer-id); } }
                    MenuSeparator {}
                    MenuItem { title: "Close"; activated => { root.viewer-open = false; } }
                }
                Timer {
                    interval: max(20, root.viewer-frame-ms) * 1ms;
                    running: root.viewer-open && root.viewer-frames.length > 1;
                    triggered => { root.viewer-frame = mod(root.viewer-frame + 1, root.viewer-frames.length); }
                }
                // Zoom: pinch (two fingers, or a trackpad), the mouse wheel or a
                // double tap; one finger or the mouse drags a zoomed picture.
                zoomer := Rectangle {
                    property <float> zoom: 1;
                    property <length> pan-x;
                    property <length> pan-y;
                    property <float> base-zoom: 1;
                    property <length> base-x;
                    property <length> base-y;
                    property <bool> dragged;
                    // How far the zoomed picture may move before an edge shows.
                    property <length> room-x: max(0px, (self.width * self.zoom - self.width) / 2);
                    property <length> room-y: max(0px, (self.height * self.zoom - self.height) / 2);
                    function fit() {
                        self.pan-x = max(-self.room-x, min(self.room-x, self.pan-x));
                        self.pan-y = max(-self.room-y, min(self.room-y, self.pan-y));
                    }
                    // Zooms to `z`, keeping the picture's point at (cx, cy) (from the
                    // middle, where it was at `base-zoom` and `base-x/y`) under (nx, ny).
                    function zoom-about(z: float, cx: length, cy: length, nx: length, ny: length) {
                        self.zoom = max(1, min(8, z));
                        self.pan-x = nx - (cx - self.base-x) / self.base-zoom * self.zoom;
                        self.pan-y = ny - (cy - self.base-y) / self.base-zoom * self.zoom;
                        self.fit();
                    }
                    clip: true;
                    Image {
                        source: root.viewer-frames.length > 1 ? root.viewer-frames[min(root.viewer-frame, root.viewer-frames.length - 1)] : root.viewer-image;
                        width: parent.width * parent.zoom;
                        height: parent.height * parent.zoom;
                        x: (parent.width - self.width) / 2 + parent.pan-x;
                        y: (parent.height - self.height) / 2 + parent.pan-y;
                        image-fit: contain;
                    }
                    pic := TouchArea {
                        // How big the picture is drawn, fitted in here.
                        property <float> fit: root.viewer-image.width == 0 || root.viewer-image.height == 0 ? 0 : min(self.width / 1px / root.viewer-image.width, self.height / 1px / root.viewer-image.height);
                        property <bool> beside: abs(self.mouse-x - self.width / 2) > root.viewer-image.width * self.fit * 0.5px || abs(self.mouse-y - self.height / 2) > root.viewer-image.height * self.fit * 0.5px;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                parent.base-x = parent.pan-x;
                                parent.base-y = parent.pan-y;
                                parent.dragged = false;
                            }
                        }
                        moved => {
                            if self.pressed && parent.zoom > 1.01 {
                                parent.pan-x = parent.base-x + (self.mouse-x - self.pressed-x);
                                parent.pan-y = parent.base-y + (self.mouse-y - self.pressed-y);
                                parent.fit();
                            }
                            if abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 8px {
                                parent.dragged = true;
                            }
                        }
                        // A tap on the unzoomed picture closes it, as around it;
                        // on phones (where a tap on it is how a zoom or a hold
                        // begins) only a tap beside it does.
                        clicked => {
                            if !parent.dragged && parent.zoom <= 1.01 {
                                if !Prefs.touch { root.viewer-open = false; } else if self.beside { viewer.closing = true; }
                            }
                        }
                        // Phones: holding the picture brings up what can be done with it.
                        Timer {
                            interval: 450ms;
                            running: Prefs.touch && parent.pressed && !zoomer.dragged && !root.viewer-menu;
                            triggered => { root.viewer-menu = true; }
                        }
                        double-clicked => {
                            parent.base-zoom = parent.zoom;
                            parent.base-x = parent.pan-x;
                            parent.base-y = parent.pan-y;
                            parent.zoom-about(parent.zoom > 1.01 ? 1 : 2.5, self.mouse-x - parent.width / 2, self.mouse-y - parent.height / 2, self.mouse-x - parent.width / 2, self.mouse-y - parent.height / 2);
                        }
                        scroll-event(e) => {
                            if e.delta-y == 0 { return reject; }
                            parent.base-zoom = parent.zoom;
                            parent.base-x = parent.pan-x;
                            parent.base-y = parent.pan-y;
                            parent.zoom-about(parent.zoom * (e.delta-y > 0 ? 1.15 : 1 / 1.15), self.mouse-x - parent.width / 2, self.mouse-y - parent.height / 2, self.mouse-x - parent.width / 2, self.mouse-y - parent.height / 2);
                            return accept;
                        }
                    }
                    pinch := ScaleRotateGestureHandler {
                        property <length> start-x;
                        property <length> start-y;
                        started => {
                            parent.base-zoom = parent.zoom;
                            parent.base-x = parent.pan-x;
                            parent.base-y = parent.pan-y;
                            parent.dragged = true;
                            self.start-x = self.center.x - parent.width / 2;
                            self.start-y = self.center.y - parent.height / 2;
                        }
                        updated => {
                            parent.zoom-about(parent.base-zoom * self.scale, self.start-x, self.start-y, self.center.x - parent.width / 2, self.center.y - parent.height / 2);
                        }
                    }
                }
            }
            // Save / Forward / Close, top right. Drawn (not font characters,
            // which some phones don't have) on dark discs, so they show on a
            // light picture too.
            HorizontalLayout {
                x: parent.width - self.preferred-width - 12px;
                // Below a phone's status bar, where they can be tapped.
                y: Safe.top + 10px;
                width: self.preferred-width;
                height: 42px;
                spacing: 8px;
                for b in [
                    { tip: "save", shape: "M 12 4 V 15 M 7 11 L 12 16 L 17 11 M 5 20 H 19" },
                    { tip: "forward", shape: "M 14 6 L 20 12 L 14 18 M 20 12 H 9 A 5 5 0 0 0 4 17 V 19" },
                    { tip: "close", shape: "M 6 6 L 18 18 M 18 6 L 6 18" }
                ]: Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 21px;
                    background: vb.has-hover ? #000000d0 : #000000a0;
                    border-width: 1px;
                    border-color: #ffffff40;
                    Path {
                        width: 20px;
                        height: 20px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: white;
                        stroke-width: 2px;
                        commands: b.shape;
                    }
                    vb := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if b.tip == "save" { root.message-action("save", root.viewer-id); }
                            if b.tip == "forward" { root.viewer-open = false; root.message-action("forward", root.viewer-id); }
                            if b.tip == "close" { root.viewer-open = false; }
                        }
                    }
                }
            }
            // Phones: the picture's menu, after holding it.
            if root.viewer-menu: Rectangle {
                background: #00000080;
                TouchArea { clicked => { root.viewer-menu = false; } }
                Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: vmenu.preferred-height;
                    y: parent.height - self.height - Safe.bottom - 8px;
                    border-radius: 14px;
                    background: Theme.panel;
                    TouchArea {}
                    vmenu := VerticalLayout {
                        padding: 6px;
                        SheetRow { text: "Save image"; clicked => { root.viewer-menu = false; root.message-action("save", root.viewer-id); } }
                        SheetRow { text: "Share…"; clicked => { root.viewer-menu = false; root.message-action("share", root.viewer-id); } }
                        SheetRow { text: "Forward…"; clicked => { root.viewer-menu = false; root.viewer-open = false; root.message-action("forward", root.viewer-id); } }
                        SheetRow { text: "Copy link to message"; clicked => { root.viewer-menu = false; root.copy-text("https://matrix.to/#/" + root.current-room + "/" + root.viewer-id); } }
                        SheetRow { text: "Close picture"; clicked => { root.viewer-menu = false; root.viewer-open = false; } }
                    }
                }
            }
        }

        // A video shown big. Esc, the corners button or a double-click shrink it back.
        if Player.large && Player.id != "": Rectangle {
            background: black;
            big-keys := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if e.text == Key.Escape { Player.set-large(false); return accept; }
                    if e.text == " " { Player.toggle(Player.id); return accept; }
                    reject
                }
            }
            big-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { Player.toggle(Player.id); }
                double-clicked => { Player.set-large(false); }
            }
            // Clear of the phone's status and navigation bars (their buttons
            // were over the video's own).
            if Player.frame.width > 0: Image {
                x: Safe.left + 20px;
                y: Safe.top + 20px;
                width: parent.width - Safe.left - Safe.right - 40px;
                height: parent.height - Safe.top - Safe.bottom - 80px;
                source: Player.frame;
                image-fit: contain;
            }
            if Player.loading: Rectangle {
                width: 56px; height: 56px; border-radius: 28px;
                background: #000000a0;
                if Player.progress > 0: Text { text: Player.progress + "%"; color: white; font-size: 14px; }
                if Player.progress == 0: Dots {}
            }
            if !Player.playing && !Player.loading: Rectangle {
                width: 56px; height: 56px; border-radius: 28px;
                background: #000000a0;
                Text { text: "▶"; color: white; font-size: 22px; }
            }
            VideoBar {
                id: Player.id;
                x: Safe.left + 20px;
                width: parent.width - Safe.left - Safe.right - 40px;
                y: parent.height - Safe.bottom - self.height - 16px;
            }
            Rectangle {
                x: parent.width - Safe.right - self.width - 12px;
                y: Safe.top + 10px;
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: big-close.has-hover ? #ffffff30 : #ffffff14;
                Text { text: "✕"; color: white; font-size: 18px; }
                big-close := TouchArea { mouse-cursor: pointer; clicked => { Player.set-large(false); } }
            }
        }

        // Choosing files on Android.
        Timer {
            interval: 1500ms;
            // Listed again now and then: access may have just been allowed.
            running: root.picker-open;
            triggered => { root.picker-refresh(); }
        }
        if root.picker-open: Overlay {
            card-width: 520px;
            dismiss => { root.picker-finish(false); }
            Text { text: root.picker-title; font-size: 18px; font-weight: 800; color: Theme.text; }
            Text { text: root.picker-dir; font-size: 11px; color: Theme.muted; overflow: elide; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Go to"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                ComboBox { model: root.picker-places; selected => { root.picker-place(self.current-index); } }
            }
            if root.picker-access == 0: Text {
                text: "Whisker needs your permission to see the phone's files: allow it in the box Android shows (or in Settings → Apps → Whisker → Permissions).";
                color: Theme.danger; font-size: 12px; wrap: word-wrap;
            }
            if root.picker-access < 2: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Only photos, videos and music show. To see key files and other documents, let Whisker see all files.";
                    color: Theme.muted; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center;
                }
                VerticalLayout { alignment: center; Btn { text: "All files…"; clicked => { root.picker-all-files(); } } }
            }
            HorizontalLayout {
                alignment: end;
                Rectangle {
                    width: grid-label.preferred-width + 16px;
                    height: 26px;
                    border-radius: 13px;
                    background: grid-ta.has-hover ? Theme.hover : Theme.raised;
                    grid-label := Text { text: root.picker-grid ? "☰  List" : "▦  Grid"; font-size: 12px; color: Theme.text; }
                    grid-ta := TouchArea { mouse-cursor: pointer; clicked => { root.picker-grid = !root.picker-grid; } }
                }
            }
            if !root.picker-grid: ListView {
                height: min(440px, max(160px, root.height - Safe.top - Safe.bottom - 360px));
                for e[i] in root.picker-entries: Rectangle {
                    height: 60px;
                    border-radius: 8px;
                    background: e.picked ? Theme.accent-soft : pick-ta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            PickThumb { entry: e; size: 48px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: e.name; color: Theme.text; overflow: elide; font-weight: e.dir ? 700 : 400; }
                            if e.info != "": Text { text: e.info; color: Theme.muted; font-size: 11px; overflow: elide; }
                        }
                        if e.picked: Text { text: "✓"; color: Theme.accent; font-weight: 800; vertical-alignment: center; }
                    }
                    pick-ta := TouchArea { mouse-cursor: pointer; clicked => { root.picker-tap(i); } }
                }
            }
            // A gallery: three or more squares a row, folders first.
            if root.picker-grid: Flickable {
                property <int> cols: max(3, floor(self.width / 120px));
                property <length> cell: self.width / self.cols;
                height: min(480px, max(180px, root.height - Safe.top - Safe.bottom - 360px));
                content-height: ceil(root.picker-entries.length / self.cols) * self.cell;
                for e[i] in root.picker-entries: Rectangle {
                    x: mod(i, parent.cols) * parent.cell;
                    y: floor(i / parent.cols) * parent.cell;
                    width: parent.cell;
                    height: parent.cell;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        border-radius: 6px;
                        clip: true;
                        background: Theme.raised;
                        if e.thumb.width > 0: Image { source: e.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                        if e.thumb.width == 0: VerticalLayout {
                            alignment: center;
                            padding: 6px;
                            spacing: 4px;
                            HorizontalLayout { alignment: center; PickThumb { entry: e; size: 40px; } }
                            Text { text: e.name; color: Theme.text; font-size: 11px; horizontal-alignment: center; overflow: elide; font-weight: e.dir ? 700 : 400; }
                        }
                        if e.kind == 2 && e.thumb.width > 0: Rectangle {
                            x: 6px; y: parent.height - 26px; width: 20px; height: 20px; border-radius: 10px;
                            background: #000000a0;
                            Text { text: "▶"; color: white; font-size: 10px; }
                        }
                        if e.picked: Rectangle {
                            border-width: 3px;
                            border-color: Theme.accent;
                            border-radius: 6px;
                            background: Theme.accent.transparentize(0.75);
                            Rectangle {
                                x: parent.width - 28px; y: 6px; width: 22px; height: 22px; border-radius: 11px;
                                background: Theme.accent;
                                Text { text: "✓"; color: Theme.on-accent; font-weight: 800; font-size: 12px; }
                            }
                        }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.picker-tap(i); } }
                }
            }
            if root.picker-entries.length == 0: Text { text: "Nothing here."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: "Cancel"; clicked => { root.picker-finish(false); } }
                if root.picker-multi: Btn {
                    text: root.picker-count > 0 ? "Add " + root.picker-count : "Add";
                    primary: true;
                    enabled: root.picker-count > 0;
                    clicked => { root.picker-finish(true); }
                }
            }
        }

        // Emoji picker, above the composer (typing) or over the chat (reacting).
        if root.emoji-open: Rectangle {
            TouchArea { clicked => { root.emoji-open = false; } }
            Rectangle {
                width: min(root.width - 24px, 340px);
                // Clear of the screen's edges and the on-screen keyboard.
                height: min(root.height - Safe.top - Safe.bottom - (root.narrow ? 130px : 140px), 380px);
                x: root.width - self.width - (root.narrow ? 12px : 16px);
                y: root.height - Safe.bottom - self.height - (root.narrow ? 112px : 76px);
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000070;
                // Clicks on the card stay on the card.
                TouchArea {}
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.emoji-for == "" ? "Emoji" : "React"; font-size: 14px; font-weight: 800; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                        IconBtn { icon: "✕"; size: 26px; clicked => { root.emoji-open = false; } }
                    }
                    esearch := Input {
                        placeholder: "Search emoji, e.g. cat, heart, thumbs";
                        // Not on phones: that would open the keyboard over the emoji.
                        init => { if !Prefs.touch { self.take-focus(); } }
                        edited(t) => { root.emoji-search(t); }
                        // Arrows move the highlight, Enter takes it, Escape closes.
                        special-key(e) => {
                            if e.text == Key.Escape { root.emoji-open = false; return true; }
                            if root.emoji-rows.length == 0 { return false; }
                            if e.text == Key.Return {
                                root.pick-emoji(root.emoji-rows[root.emoji-row].items[min(root.emoji-col, root.emoji-rows[root.emoji-row].items.length - 1)].symbol, true);
                                return true;
                            }
                            if e.text == Key.RightArrow && root.emoji-col < root.emoji-rows[root.emoji-row].items.length - 1 { root.emoji-col += 1; return true; }
                            if e.text == Key.LeftArrow && root.emoji-col > 0 { root.emoji-col -= 1; return true; }
                            if e.text == Key.DownArrow && root.emoji-row < root.emoji-rows.length - 1 {
                                root.emoji-row += 1;
                                root.emoji-col = min(root.emoji-col, root.emoji-rows[root.emoji-row].items.length - 1);
                                esv.content-y = min(esv.content-y, esv.visible-height - (root.emoji-row + 1) * 38px);
                                return true;
                            }
                            if e.text == Key.UpArrow && root.emoji-row > 0 {
                                root.emoji-row -= 1;
                                esv.content-y = max(esv.content-y, -root.emoji-row * 38px);
                                return true;
                            }
                            return false;
                        }
                    }
                    if root.emoji-rows.length == 0: Text { text: "No emoji found."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
                    esv := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: egrid.preferred-height;
                        egrid := VerticalLayout {
                            width: esv.visible-width;
                            for row[r] in root.emoji-rows: HorizontalLayout {
                                alignment: start;
                                for e[c] in row.items: Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 8px;
                                    background: r == root.emoji-row && c == root.emoji-col ? Theme.accent-soft : eta.has-hover ? Theme.hover : transparent;
                                    if e.picture.width > 0: Image { source: e.picture; width: 26px; height: 26px; }
                                    if e.picture.width == 0: Text { text: e.symbol; font-size: 22px; }
                                    eta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pick-emoji(e.symbol, false); esearch.take-focus(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.clear-open: Overlay {
            dismiss => { root.clear-open = false; }
            Text { text: root.clear-own ? "Clear my messages" : "Clear messages"; font-size: 18px; font-weight: 800; color: Theme.text; }
            Text {
                text: (root.clear-own ? "Deletes the messages you sent in " : "Deletes messages in ") + root.current-room-name + " for everyone, newest first. Their text is gone from the server and every app; this can't be undone. " + (root.clear-own ? "Other people's messages stay; the numbers count yours only." : "Room events (joins, renames) stay.");
                color: Theme.muted; font-size: 12px; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Btn { text: "Last 50"; danger: true; clicked => { root.clear-open = false; root.clear-messages(50); } }
                Btn { text: "Last 500"; danger: true; clicked => { root.clear-open = false; root.clear-messages(500); } }
                Btn { text: "All"; danger: true; clicked => { root.clear-open = false; root.clear-messages(0); } }
            }
            Btn { text: "Cancel"; primary: true; clicked => { root.clear-open = false; } }
        }

        if root.forward-open: Overlay {
            card-width: 440px;
            dismiss => { root.forward-open = false; }
            Text { text: "Forward message"; font-size: 18px; font-weight: 800; color: Theme.text; }
            if root.forward-accounts.length > 1: Text { text: "Send it as:"; color: Theme.muted; font-size: 12px; }
            if root.forward-accounts.length > 1: Flickable {
                height: 40px;
                content-width: max(self.width, facc.preferred-width);
                facc := HorizontalLayout {
                    spacing: 6px;
                    for a in root.forward-accounts: Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: a.id == root.forward-account ? Theme.accent-soft : (faca.has-hover ? Theme.hover : transparent);
                        border-width: 1px;
                        border-color: a.id == root.forward-account ? Theme.accent : Theme.border;
                        faca := TouchArea { clicked => { root.forward-pick-account(a.id); } }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Avatar { initial: a.initial; hue: a.hue; image: a.avatar; size: 28px; } }
                            Text { text: a.name; color: Theme.text; vertical-alignment: center; overflow: elide; max-width: 160px; }
                        }
                    }
                }
            }
            Input { text <=> root.forward-query; placeholder: "Search rooms"; edited(t) => { root.forward-search(t); } }
            fsv := ScrollView {
                height: min(360px, root.height - 260px);
                content-width: self.visible-width;
                content-height: flist.preferred-height;
                flist := VerticalLayout {
                    width: fsv.visible-width;
                    spacing: 2px;
                    if root.forward-rooms.length == 0: Text { text: "No rooms found."; color: Theme.muted; horizontal-alignment: center; }
                    for f in root.forward-rooms: Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: fta.has-hover ? Theme.hover : transparent;
                        fta := TouchArea {}
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Avatar { initial: f.initial; hue: f.hue; image: f.avatar; size: 34px; } }
                            Text { text: f.name; color: Theme.text; font-weight: 600; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: f.sent ? "Sent" : "Send";
                                    primary: !f.sent;
                                    enabled: !f.sent;
                                    clicked => { root.forward-to(f.id); }
                                }
                            }
                        }
                    }
                }
            }
            if root.forward-status != "": Text { text: root.forward-status; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                Btn { text: "Done"; primary: true; clicked => { root.forward-open = false; } }
            }
        }

        if root.share-open: Overlay {
            card-width: 440px;
            dismiss => { if !root.share-busy { root.share-cancel(); } }
            Text { text: "Share " + root.share-what; font-size: 18px; font-weight: 800; color: Theme.text; overflow: elide; }
            Text {
                text: root.share-step == 0 ? "Which account should send it?" : "Pick a room for " + root.share-account-name + ".";
                color: Theme.muted;
                wrap: word-wrap;
            }
            if root.share-step == 1: Input { text <=> root.share-query; placeholder: "Search rooms"; edited(t) => { root.share-search(t); } }
            ssv := ScrollView {
                height: min(slist.preferred-height, 360px, root.height - 280px);
                content-width: self.visible-width;
                content-height: slist.preferred-height;
                slist := VerticalLayout {
                    width: ssv.visible-width;
                    spacing: 2px;
                    if root.share-step == 0 && root.share-accounts.length == 0: Text { text: "No accounts are signed in."; color: Theme.muted; horizontal-alignment: center; }
                    if root.share-step == 0: VerticalLayout {
                        spacing: 2px;
                        for a in root.share-accounts: Rectangle {
                            height: 52px;
                            border-radius: 8px;
                            background: sata.has-hover ? Theme.hover : transparent;
                            sata := TouchArea { clicked => { root.share-pick-account(a.id); } }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Avatar { initial: a.initial; hue: a.hue; image: a.avatar; size: 36px; } }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: a.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                    if a.user-id != a.name: Text { text: a.user-id; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                            }
                        }
                    }
                    if root.share-step == 1 && root.forward-rooms.length == 0: Text { text: root.share-query == "" ? "Loading rooms…" : "No rooms found."; color: Theme.muted; horizontal-alignment: center; }
                    if root.share-step == 1: VerticalLayout {
                        spacing: 2px;
                        for f in root.forward-rooms: Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            background: srta.has-hover && !root.share-busy ? Theme.hover : transparent;
                            srta := TouchArea { enabled: !root.share-busy; clicked => { root.share-to(f.id); } }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Avatar { initial: f.initial; hue: f.hue; image: f.avatar; size: 34px; } }
                                Text { text: f.name; color: Theme.text; font-weight: 600; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                if f.sent: Text { text: "Sending…"; color: Theme.muted; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
            if root.share-status != "": Text { text: root.share-status; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                if root.share-step == 1 && root.share-accounts.length > 1: Btn { text: "Back"; enabled: !root.share-busy; clicked => { root.share-back(); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "Cancel"; enabled: !root.share-busy; clicked => { root.share-cancel(); } }
            }
        }

        if root.create-open: Overlay {
            card-width: 420px;
            dismiss => { root.create-open = false; }
            Text { text: "Create a room"; font-size: 18px; font-weight: 800; color: Theme.text; }
            cname := Input { placeholder: "Room name"; }
            ctopic := Input { placeholder: "Description (optional)"; }
            HorizontalLayout {
                spacing: 4px;
                Tab { text: "Private (invite only)"; active: !root.create-public; clicked => { root.create-public = false; root.create-encrypted = true; } }
                Tab { text: "Public"; active: root.create-public; clicked => { root.create-public = true; root.create-encrypted = false; } }
            }
            if root.create-public: Text {
                text: "Anyone can find and join it, and it's listed in your server's room directory.";
                font-size: 11px; color: Theme.muted; wrap: word-wrap;
            }
            calias := Input { visible: root.create-public; height: root.create-public ? 38px : 0; placeholder: "Address, e.g. cats → #cats:yourserver"; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "End-to-end encrypted"; color: Theme.text; }
                    Text { text: "Can't be turned off later. Usually off for big public rooms."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                }
                Switch { checked <=> root.create-encrypted; }
            }
            cinvite := Input { placeholder: "Invite (optional): @friend:server, @other:server"; }
            if root.create-error != "": Text { text: root.create-error; color: Theme.danger; wrap: char-wrap; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: "Cancel"; clicked => { root.create-open = false; } }
                Btn {
                    text: root.busy ? "Creating…" : "Create";
                    primary: true;
                    enabled: cname.text != "" && !root.busy;
                    clicked => { root.create-room(cname.text, ctopic.text, root.create-public, calias.text, root.create-encrypted, cinvite.text); }
                }
            }
        }

        if root.verify-open: Overlay {
            card-width: 460px;
            dismiss => { }
            Text {
                text: root.verify-self ? "Verify this session" : "Verify " + root.verify-name;
                font-size: 18px; font-weight: 800; color: Theme.text; wrap: word-wrap;
            }
            if root.verify-state == "incoming": VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.verify-self
                        ? "One of your other sessions wants to verify this one. Accept only if you started this yourself."
                        : root.verify-name + " wants to verify you. Accept only if you expected it.";
                    wrap: word-wrap; color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn { text: "Decline"; clicked => { root.verify-action("cancel"); } }
                    Btn { text: "Accept"; primary: true; clicked => { root.verify-action("accept"); } }
                }
            }
            if root.verify-state == "waiting": VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.verify-self ? "Accept the request on one of your other sessions (e.g. Element)…" : "Waiting for " + root.verify-name + " to accept…";
                    wrap: word-wrap; color: Theme.muted;
                }
                HorizontalLayout { alignment: end; Btn { text: "Cancel"; clicked => { root.verify-action("cancel"); } } }
            }
            if root.verify-state == "emojis": VerticalLayout {
                spacing: 12px;
                Text { text: "Check that the other screen shows the same pictures, in the same order:"; wrap: word-wrap; color: Theme.muted; }
                // As many to a row as fit (all 7 on a wide screen, 4 and 3
                // on a phone), each row centred.
                Rectangle {
                    property <int> count: root.verify-emojis.length;
                    property <int> per: max(1, min(self.count, floor((self.width + 4px) / 62px)));
                    height: ceil(self.count / self.per) * 78px - 4px;
                    for e[i] in root.verify-emojis: Rectangle {
                        property <int> line: floor(i / parent.per);
                        property <int> in-row: min(parent.per, parent.count - self.line * parent.per);
                        x: (parent.width - (self.in-row * 62px - 4px)) / 2 + mod(i, parent.per) * 62px;
                        y: self.line * 78px;
                        width: 58px;
                        height: 74px;
                        border-radius: 8px;
                        background: Theme.raised;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: e.symbol; font-size: 26px; horizontal-alignment: center; }
                            Text { text: e.name; font-size: 10px; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn { text: "They don't match"; danger: true; clicked => { root.verify-action("mismatch"); } }
                    Btn { text: "They match"; primary: true; clicked => { root.verify-action("match"); } }
                }
            }
            if root.verify-state == "confirmed": VerticalLayout {
                spacing: 10px;
                Text { text: "Waiting for the other side to confirm…"; color: Theme.muted; }
                HorizontalLayout { alignment: end; Btn { text: "Cancel"; clicked => { root.verify-action("cancel"); } } }
            }
            if root.verify-state == "done": VerticalLayout {
                spacing: 10px;
                Text { text: "✓ Verified"; font-size: 18px; font-weight: 800; color: Theme.ok; }
                Text { text: root.verify-self ? "This session is now trusted by your other sessions." : root.verify-name + " is verified. You'll be warned if their keys ever change."; wrap: word-wrap; color: Theme.muted; }
                HorizontalLayout { alignment: end; Btn { text: "Done"; primary: true; clicked => { root.verify-action("close"); } } }
            }
            if root.verify-state == "cancelled": VerticalLayout {
                spacing: 10px;
                Text { text: "Verification stopped" + (root.verify-message == "" ? "." : ": " + root.verify-message); wrap: word-wrap; color: Theme.danger; }
                HorizontalLayout { alignment: end; Btn { text: "Close"; clicked => { root.verify-action("close"); } } }
            }
        }
    }
}
