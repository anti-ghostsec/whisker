import { ComboBox, SpinBox, Switch, TextEdit, ScrollView, ListView } from "std-widgets.slint";
import { Theme, Prefs, Avatar, Btn, IconBtn, Input } from "theme.slint";

// One entry in the settings sidebar. `id` is "general", "account:<id>" or "ai:<id>".
export struct NavItem {
    id: string,
    title: string,
    subtitle: string,
    section: string,
    initial: string,
    hue: int,
    avatar: image,
    robot: bool,
}

export struct AccountForm {
    id: string,
    user-id: string,
    display-name: string,
    initial: string,
    hue: int,
    avatar: image,
    is-agent: bool,
    label: string,
    tags: string,
    proxy: string,
    // This login: 2 verified, 1 not verified, 0 not signed in.
    session-verified: int,
    session-id: string,
    // The account has cross-signing keys on the server.
    has-identity: bool,
    // A recovery key is set up and unlocked here.
    recovery-on: bool,
    // A recovery key just made, to write down.
    recovery-key: string,
}

export struct AgentForm {
    account: string,
    exists: bool,
    enabled: bool,
    name: string,
    url: string,
    api-key-set: bool,
    api-key: string,
    model: string,
    service: string,
    max-tokens: int,
    extra-json: string,
    // 0 mention, 1 every message, 2 DMs only
    trigger: int,
    system-prompt: string,
    rooms: string,
    history: int,
    summarize: bool,
    summary-model: string,
    context-tokens: int,
    cooldown: int,
    max-steps: int,
    yield-secs: int,
    max-rapid: int,
    venice-system-prompt: bool,
    venice-web-search: bool,
    see-images: bool,
    image-model: string,
    reply-chars: int,
    g-reply: bool,
    g-redact: bool,
    g-kick: bool,
    g-ban: bool,
    g-unban: bool,
    g-invite: bool,
    g-power: bool,
    commanders: string,
    min-level: int,
    autonomous: bool,
    max-grant: int,
    protected: string,
    audit-room: string,
    // Character card (has-card false: none). Alternate greetings are
    // separated by a line holding just "---".
    has-card: bool,
    greet: bool,
    card-name: string,
    card-nickname: string,
    card-description: string,
    card-personality: string,
    card-scenario: string,
    card-first-mes: string,
    card-greetings: string,
    card-examples: string,
    card-system: string,
    card-post: string,
    card-tags: string,
    card-creator: string,
    card-notes: string,
    // "3 lorebook entries", or "".
    card-lore: string,
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Theme.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text { text: root.title; font-size: 15px; font-weight: 800; color: Theme.text; }
        if root.subtitle != "": Text { text: root.subtitle; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
        @children
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 4px;
    Text { text: root.label; font-size: 12px; font-weight: 600; color: Theme.muted; }
    @children
    if root.hint != "": Text { text: root.hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
}

component Toggle inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in-out property <bool> checked;
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.text; wrap: word-wrap; color: Theme.text; }
        if root.hint != "": Text { text: root.hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
    }
    Switch { checked <=> root.checked; }
}

component Number inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in-out property <int> value;
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.text; wrap: word-wrap; color: Theme.text; }
        if root.hint != "": Text { text: root.hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
    }
    SpinBox { width: 130px; value <=> root.value; minimum: root.minimum; maximum: root.maximum; }
}

component UpSwitch inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.text; wrap: word-wrap; color: Theme.text; }
        if root.hint != "": Text { text: root.hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
    }
    Switch { checked: root.checked; toggled => { root.toggled(self.checked); } }
}

component UpNumber inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <int> minimum: 0;
    in property <int> value;
    callback edited(int);
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.text; wrap: word-wrap; color: Theme.text; }
        if root.hint != "": Text { text: root.hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
    }
    SpinBox { width: 130px; value: root.value; minimum: root.minimum; maximum: 100; edited(v) => { root.edited(v); } }
}

component NavRow inherits Rectangle {
    in property <NavItem> item;
    in property <bool> selected;
    callback clicked;
    height: item.section == "" ? 40px : 48px;
    border-radius: 8px;
    background: selected ? Theme.active : ta.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        if root.item.section != "": VerticalLayout {
            alignment: center;
            Avatar { initial: root.item.initial; hue: root.item.hue; image: root.item.avatar; robot: root.item.robot && root.item.avatar.width == 0; size: 30px; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.title; color: Theme.text; font-weight: 600; overflow: elide; }
            if root.item.subtitle != "": Text { text: root.item.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component MenuToggle inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    in property <bool> checked;
    callback changed(string, bool);
    spacing: 8px;
    Text { text: root.label; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    Switch { checked: root.checked; toggled => { root.changed(root.key, self.checked); } }
}

component GeneralPage inherits VerticalLayout {
    in-out property <int> theme;
    callback set-rich-text(bool);
    callback set-show-events(bool);
    callback set-notify-level(int);
    callback set-send-typing(bool);
    callback set-autocorrect(bool);
    callback set-spell-check(bool);
    callback set-link-posters(bool);
    callback set-ask-file-servers(bool);
    callback set-ask-room-servers(bool);
    // An upload setting changed: (key, value; switches are 0 or 1).
    callback set-upload(string, int);
    callback set-clear-command(string);
    callback set-menu-entry(string, bool);
    in-out property <int> auto-lock;
    in property <string> encryption-summary;
    callback set-theme(int);
    callback set-auto-lock(int);
    callback change-passphrase(string, string);
    callback unlock-hidden(string);
    callback create-hidden(string);
    callback new-ai();
    spacing: 14px;

    Card {
        title: "AI";
        subtitle: "An AI chats as its own Matrix account. Add one (a new or existing account for the bot), or turn one of your accounts into an AI from its page under ACCOUNTS. Its settings, including the API service (OpenAI, Anthropic, Venice, a local server…), API key, model and Venice privacy options, then appear under AI on the left.";
        HorizontalLayout { alignment: start; Btn { text: "Add an AI account"; primary: true; clicked => { root.new-ai(); } } }
    }

    Card {
        title: "Appearance";
        Field {
            label: "Theme";
            ComboBox {
                model: ["Dark", "Light", "Follow system"];
                current-index <=> root.theme;
                selected => { root.set-theme(self.current-index); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Rich message text"; color: Theme.text; }
                Text {
                    text: "Shows bold, italic and clickable links. Rich text can't be selected with the mouse; leave this off to drag-select and copy parts of messages.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.rich-text;
                toggled => { root.set-rich-text(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Show room events"; color: Theme.text; }
                Text {
                    text: "Joins, leaves, invites, kicks and bans, name, description and picture changes, permission changes and the like, as small grey lines between messages.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.show-events;
                toggled => { root.set-show-events(self.checked); }
            }
        }
    }
    Card {
        title: "Notifications and typing";
        Field {
            label: "Desktop notifications";
            hint: "For direct messages, mentions and rooms set to notify. Notification text can stay on screen and in your desktop's notification history.";
            ComboBox {
                model: ["Off", "Just \"New message\"", "Who sent it and where", "Who, where and the message"];
                current-index: Prefs.notify-level;
                selected => { root.set-notify-level(self.current-index); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Let others see when I'm typing"; color: Theme.text; }
                Text {
                    text: "Others' typing always shows. Off by default: the server and everyone in the room learn when you're active.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.send-typing;
                toggled => { root.set-send-typing(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Fix common typos as I type"; color: Theme.text; }
                Text {
                    text: "\"teh\" becomes \"the\", \"dont\" becomes \"don't\", a lone \"i\" becomes \"I\". Press Backspace straight after a fix to keep what you typed.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.autocorrect;
                toggled => { root.set-autocorrect(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Underline spelling mistakes"; color: Theme.text; }
                Text {
                    text: "A red line goes under words that aren't in the dictionary once you stop typing. Right-click one for suggestions, or to add it to your dictionary (kept in your vault).";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.spell-check;
                toggled => { root.set-spell-check(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Preview frames for video links"; color: Theme.text; }
                Text {
                    text: "Sending a video's link (mxc://…) uploads one small still from it, so other apps show a picture instead of a blank box. The video itself is never uploaded again.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.link-posters;
                toggled => { root.set-link-posters(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Ask a file's own server"; color: Theme.text; }
                Text {
                    text: "When your server can't get an image or file from another server, ask that server for it directly. Fixes some pictures that won't load, but that server then sees your IP address (unless the account uses a proxy) and which file you opened. Your login is never sent to it.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.ask-file-servers;
                toggled => { root.set-ask-file-servers(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Ask other servers in the room for copies"; color: Theme.text; }
                Text {
                    text: "When nobody can give an image or file (often because its server shut down), ask up to 4 other servers in the room for the copy they keep. Brings back some lost pictures, but each server asked sees your IP address (unless the account uses a proxy) and which file you wanted. Your login is never sent to them.";
                    font-size: 11px; color: Theme.muted; wrap: word-wrap;
                }
            }
            Switch {
                checked: Prefs.ask-room-servers;
                toggled => { root.set-ask-room-servers(self.checked); }
            }
        }
    }
    Card {
        title: "Uploads";
        subtitle: "Applied to every file you send, so nothing asks each time.";
        UpSwitch {
            text: "Remove photo metadata (EXIF etc.)";
            hint: "Photos often carry where they were taken, the phone or camera, and when. This removes it from pictures (JPEG, PNG, WebP, GIF), and from videos and sound files when ffmpeg is installed. Nothing is re-encoded, so quality stays the same.";
            checked: Prefs.up-strip;
            toggled(b) => { root.set-upload("strip", b ? 1 : 0); }
        }
        UpSwitch {
            text: "Name files after their contents";
            hint: "Sends a code made from the file (like 3fa94c….jpg) instead of its own name, which can give away dates, names or folders.";
            checked: Prefs.up-hash;
            toggled(b) => { root.set-upload("hash", b ? 1 : 0); }
        }
        Field {
            label: "Convert pictures";
            hint: "Animations and see-through pictures (for JPEG) are always kept as they are.";
            ComboBox {
                model: ["Keep their format", "JPEG", "PNG"];
                current-index: Prefs.up-convert;
                selected => { root.set-upload("convert", self.current-index); }
            }
        }
        if Prefs.up-convert == 1 || Prefs.up-strip: UpNumber {
            text: "JPEG quality (1-100)";
            hint: "Used when a picture is converted, or turned upright.";
            minimum: 1;
            value: Prefs.up-quality;
            edited(v) => { root.set-upload("quality", v); }
        }
        UpSwitch {
            text: "Make previews of big pictures";
            hint: "A small copy, so others see the picture without downloading all of it.";
            checked: Prefs.up-thumbs;
            toggled(b) => { root.set-upload("thumbs", b ? 1 : 0); }
        }
        if Prefs.up-thumbs: Field {
            label: "Preview format";
            ComboBox {
                model: ["JPEG", "PNG"];
                current-index: Prefs.up-thumb-format;
                selected => { root.set-upload("thumb-format", self.current-index); }
            }
        }
        if Prefs.up-thumbs && Prefs.up-thumb-format == 0: UpNumber {
            text: "Preview quality (1-100)";
            minimum: 1;
            value: Prefs.up-thumb-quality;
            edited(v) => { root.set-upload("thumb-quality", v); }
        }
        UpSwitch {
            text: "Always encrypt files, even in rooms without encryption";
            hint: "The server's file store then only holds scrambled data. Everyone in the room can still open them (the key is in the message), and a few older apps may not show them.";
            checked: Prefs.up-encrypt;
            toggled(b) => { root.set-upload("encrypt", b ? 1 : 0); }
        }
    }
    Card {
        title: "Commands";
        subtitle: "Typed on its own in the message box. Only you see it: it isn't sent.";
        Field {
            label: "Clear messages";
            hint: "In a room where you can delete others' messages, this asks which recent messages to delete. Leave it empty to turn the command off (Room info keeps its button).";
            Input { text: Prefs.clear-command; placeholder: "e.g. /clear"; edited(t) => { root.set-clear-command(t); } }
        }
    }
    Card {
        title: "Message menu";
        subtitle: "What right-clicking (or long-pressing) a message offers. Saving files, editing, deleting and moderating are always there when they apply. To copy part of a message, or several, drag across them like in a web browser.";
        GridLayout {
            spacing: 8px;
            Row {
                MenuToggle { key: "react"; label: "React"; checked: Prefs.menu-react; changed(k, b) => { root.set-menu-entry(k, b); } }
                MenuToggle { key: "reply"; label: "Reply"; checked: Prefs.menu-reply; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
            Row {
                MenuToggle { key: "thread"; label: "Reply in thread"; checked: Prefs.menu-thread; changed(k, b) => { root.set-menu-entry(k, b); } }
                MenuToggle { key: "forward"; label: "Forward…"; checked: Prefs.menu-forward; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
            Row {
                MenuToggle { key: "quote"; label: "Quote"; checked: Prefs.menu-quote; changed(k, b) => { root.set-menu-entry(k, b); } }
                MenuToggle { key: "copy"; label: "Copy whole message"; checked: Prefs.menu-copy; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
            Row {
                MenuToggle { key: "open-media"; label: "Play / Open image"; checked: Prefs.menu-open-media; changed(k, b) => { root.set-menu-entry(k, b); } }
                MenuToggle { key: "open-links"; label: "Open links"; checked: Prefs.menu-open-links; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
            Row {
                MenuToggle { key: "copy-link"; label: "Copy link to message"; checked: Prefs.menu-copy-link; changed(k, b) => { root.set-menu-entry(k, b); } }
                MenuToggle { key: "profile"; label: "View profile"; checked: Prefs.menu-profile; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
            Row {
                MenuToggle { key: "copy-id"; label: "Copy user id"; checked: Prefs.menu-copy-id; changed(k, b) => { root.set-menu-entry(k, b); } }
                MenuToggle { key: "source"; label: "Show source"; checked: Prefs.menu-source; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
            Row {
                MenuToggle { key: "copy-file"; label: "Copy file link"; checked: Prefs.menu-copy-file; changed(k, b) => { root.set-menu-entry(k, b); } }
            }
        }
    }
    Card {
        title: "Security";
        subtitle: "Locking stops every account and AI and forgets the vault keys until you unlock again.";
        Field {
            label: "Lock automatically when idle";
            ComboBox {
                model: ["Never", "After 5 minutes", "After 15 minutes", "After 1 hour"];
                current-index <=> root.auto-lock;
                selected => { root.set-auto-lock(self.current-index); }
            }
        }
        Field {
            label: "Change passphrase";
            hint: "Changes the vault that holds the selected account.";
            old-pass := Input { password: true; placeholder: "Current passphrase"; }
            new-pass := Input { password: true; placeholder: "New passphrase (8+ characters)"; }
            new-pass2 := Input { password: true; placeholder: "Repeat new passphrase"; }
        }
        HorizontalLayout {
            alignment: start;
            Btn {
                text: "Change passphrase";
                enabled: old-pass.text != "" && new-pass.text != "" && new-pass.text == new-pass2.text;
                clicked => { root.change-passphrase(old-pass.text, new-pass.text); old-pass.text = ""; new-pass.text = ""; new-pass2.text = ""; }
            }
        }
    }
    Card {
        title: "Hidden vaults";
        subtitle: "Accounts in a hidden vault only appear after you enter its own passphrase, and disappear when you lock. Nothing in your main vault mentions them.";
        hidden-pass := Input { password: true; placeholder: "Hidden vault passphrase"; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn { text: "Unlock"; enabled: hidden-pass.text != ""; clicked => { root.unlock-hidden(hidden-pass.text); hidden-pass.text = ""; } }
            Btn { text: "Create new"; enabled: hidden-pass.text != ""; clicked => { root.create-hidden(hidden-pass.text); hidden-pass.text = ""; } }
        }
    }
    Card {
        title: "Privacy & encryption";
        Text { text: root.encryption-summary; wrap: word-wrap; font-size: 12px; color: Theme.text; }
    }
}

component AccountPage inherits VerticalLayout {
    in property <AccountForm> account;
    callback save-account(AccountForm);
    callback profile-edit(string, string, string);
    property <string> f-display: account.display-name;
    callback recover(string);
    callback logout(string);
    property <string> f-label: account.label;
    property <string> f-tags: account.tags;
    property <string> f-proxy: account.proxy;
    spacing: 14px;

    Card {
        title: "Your profile";
        subtitle: "What everyone in your rooms sees.";
        HorizontalLayout {
            spacing: 14px;
            Avatar { initial: root.account.initial; hue: root.account.hue; image: root.account.avatar; size: 72px; }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Btn { text: "Change picture"; clicked => { root.profile-edit("avatar", root.account.id, ""); } }
                    if root.account.avatar.width > 0: Btn { text: "Remove"; clicked => { root.profile-edit("remove-avatar", root.account.id, ""); } }
                }
            }
        }
        Field { label: "Display name"; Input { text <=> root.f-display; placeholder: root.account.user-id; } }
        HorizontalLayout {
            alignment: start;
            Btn { text: "Save display name"; primary: true; clicked => { root.profile-edit("name", root.account.id, root.f-display); } }
        }
    }
    Card {
        title: "On this device";
        subtitle: root.account.user-id;
        Field { label: "Nickname"; hint: "Only shown on this device."; Input { text <=> root.f-label; placeholder: "Same as server name"; } }
        Field { label: "Tags"; hint: "Comma separated. Used to filter the account rail."; Input { text <=> root.f-tags; placeholder: "e.g. main, alt, work"; } }
        Field { label: "Proxy"; hint: "Applies the next time you unlock. Give alts different proxies so a server can't link them by IP."; Input { text <=> root.f-proxy; placeholder: "None, e.g. socks5h://127.0.0.1:9050"; } }
        HorizontalLayout {
            alignment: start;
            Btn {
                text: "Save";
                primary: true;
                clicked => {
                    root.save-account({ id: root.account.id, user-id: root.account.user-id, display-name: root.account.display-name,
                        is-agent: root.account.is-agent, label: root.f-label, tags: root.f-tags, proxy: root.f-proxy });
                }
            }
        }
    }
    Card {
        title: "Verify this session";
        subtitle: root.account.has-identity
            ? "Confirms this Whisker login is really you, with one of your other sessions (e.g. Element) or your recovery key. People then stop seeing it as an unverified device, and it can receive your encryption keys."
            : "This account has no verification keys yet. Set them up here, no other session needed: this session becomes your first verified one.";
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            if root.account.session-verified == 2: Text { text: "✓ This session is verified"; color: Theme.ok; font-weight: 700; vertical-alignment: center; }
            if root.account.session-verified == 1: Text { text: "⚠ This session isn't verified yet"; color: Theme.danger; font-weight: 700; vertical-alignment: center; }
            if root.account.session-id != "": Text { text: "Session " + root.account.session-id; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        }
        if root.account.session-verified == 1 && root.account.has-identity: VerticalLayout {
            spacing: 8px;
            HorizontalLayout { alignment: start; Btn { text: "Verify with another session"; clicked => { root.profile-edit("verify-self", root.account.id, ""); } } }
            Text { text: "No other session? Enter your recovery key under \"Read older encrypted messages\" below: that verifies this session too."; wrap: word-wrap; font-size: 12px; color: Theme.muted; }
        }
        if root.account.session-verified == 1 && !root.account.has-identity: VerticalLayout {
            spacing: 8px;
            pw := Input { password: true; placeholder: "Account password"; }
            HorizontalLayout { alignment: start; Btn { text: "Set up verification"; primary: true; enabled: pw.text != ""; clicked => { root.profile-edit("secure", root.account.id, pw.text); pw.text = ""; } } }
        }
    }
    if root.account.session-verified == 2: Card {
        title: "Recovery key";
        subtitle: "Lets a new login verify itself and read your older messages when no other session is around. Whisker backs your message keys up to your server, locked with it.";
        if root.account.recovery-key != "": VerticalLayout {
            spacing: 8px;
            Text { text: "Write this down and keep it safe. It isn't shown again."; color: Theme.danger; font-weight: 700; wrap: word-wrap; }
            Input { text: root.account.recovery-key; read-only: true; }
        }
        if root.account.recovery-key == "" && root.account.recovery-on: Text { text: "✓ Set up"; color: Theme.ok; font-weight: 700; }
        if root.account.recovery-key == "" && !root.account.recovery-on: HorizontalLayout {
            alignment: start;
            Btn { text: "Make a recovery key"; clicked => { root.profile-edit("make-recovery", root.account.id, ""); } }
        }
    }
    if root.account.session-verified == 1 && root.account.has-identity: Card {
        title: "Lost every other session and your recovery key?";
        subtitle: "Start over with new verification keys made here. Your other sessions and anyone who verified you will need to verify again, and the key backup on your server is deleted, so older messages you have no keys for stay unreadable.";
        rpw := Input { password: true; placeholder: "Account password"; }
        HorizontalLayout { alignment: start; Btn { text: "Reset verification"; enabled: rpw.text != ""; clicked => { root.profile-edit("reset-identity", root.account.id, rpw.text); rpw.text = ""; } } }
    }
    Card {
        title: "Read older encrypted messages";
        subtitle: "A new login has no keys for messages sent before it. Enter the recovery key (or security phrase) from another client to restore them from your server-side key backup.";
        key := Input { password: true; placeholder: "Recovery key"; }
        HorizontalLayout { alignment: start; Btn { text: "Restore keys"; enabled: key.text != ""; clicked => { root.recover(key.text); key.text = ""; } } }
    }
    Card {
        title: "Export or import room keys";
        subtitle: "Saves the keys for your encrypted messages to a file, locked with a passphrase, so another client (Element and others) or a new Whisker login can read them. Import reads such a file. Anyone with the file and its passphrase can read your messages.";
        keypass := Input { password: true; placeholder: "File passphrase"; }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Btn { text: "Export keys…"; enabled: keypass.text != ""; clicked => { root.profile-edit("export-keys", root.account.id, keypass.text); keypass.text = ""; } }
            Btn { text: "Import keys…"; enabled: keypass.text != ""; clicked => { root.profile-edit("import-keys", root.account.id, keypass.text); keypass.text = ""; } }
        }
    }
    Card {
        title: root.account.is-agent ? "AI" : "Use as an AI";
        subtitle: root.account.is-agent
            ? "This account is run by an AI. Its API, key and behaviour are under AI on the left. Turning it back stops the AI; its settings are kept."
            : "Lets an AI chat as this account. You then pick the API service (OpenAI, Anthropic, Venice…), key and model under AI on the left. Best on an account made for the bot.";
        HorizontalLayout {
            alignment: start;
            if !root.account.is-agent: Btn { text: "Use this account as an AI"; clicked => { root.profile-edit("make-ai", root.account.id, ""); } }
            if root.account.is-agent: Btn { text: "Turn back into a normal account"; clicked => { root.profile-edit("make-human", root.account.id, ""); } }
        }
    }
    Card {
        title: "Log out";
        subtitle: "Signs this device out on the server and deletes its local data.";
        HorizontalLayout { alignment: start; Btn { text: "Log out of " + root.account.user-id; danger: true; clicked => { root.logout(root.account.id); } } }
    }
}

// Says whether a model can see pictures, from the service's model list:
// 0 unknown, 1 yes, 2 no. `revision` is there to ask again when the list
// changes.
export global ModelInfo {
    pure callback sees(string, int) -> int;
}

/// A dropdown of model names with a search box. `models` is what the
/// search leaves (the app narrows it on `search`). Typing a name that isn't
/// listed and pressing Enter picks it too.
component ModelPicker inherits Rectangle {
    in property <[string]> models;
    in-out property <string> value;
    in property <string> placeholder;
    // Shown in the dropdown when nothing is listed.
    in property <string> empty-text: "No models listed. Type a name and press Enter.";
    // Lets the value be cleared (for "none").
    in property <string> none-text;
    callback search(string);
    callback picked(string);
    height: 38px;
    border-radius: 10px;
    background: pta.has-hover ? Theme.hover : Theme.raised;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.value != "" ? root.value : root.placeholder;
            color: root.value != "" ? Theme.text : Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text { text: "▾"; color: Theme.muted; vertical-alignment: center; }
    }
    pta := TouchArea { mouse-cursor: pointer; clicked => { root.search(""); popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(380px, 56px + (root.none-text != "" ? 32px : 0px) + max(1, root.models.length) * 32px + 8px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                sb := Input {
                    placeholder: "Search, or type a name and press Enter";
                    init => { self.take-focus(); }
                    edited(t) => { root.search(t); }
                    accepted(t) => {
                        if t != "" {
                            root.value = t;
                            root.picked(t);
                            popup.close();
                        }
                    }
                }
                if root.none-text != "": Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: nta.has-hover ? Theme.hover : transparent;
                    Text { x: 10px; text: root.none-text; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                    nta := TouchArea { mouse-cursor: pointer; clicked => { root.value = ""; root.picked(""); popup.close(); } }
                }
                if root.models.length == 0: Text { text: root.empty-text; color: Theme.muted; font-size: 12px; wrap: word-wrap; height: 32px; vertical-alignment: center; }
                if root.models.length > 0: ListView {
                    vertical-stretch: 1;
                    for name in root.models: Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: name == root.value ? Theme.accent-soft : mta.has-hover ? Theme.hover : transparent;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: name;
                            color: name == root.value ? Theme.accent : Theme.text;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        mta := TouchArea { mouse-cursor: pointer; clicked => { root.value = name; root.picked(name); popup.close(); } }
                    }
                }
            }
        }
    }
}

component AgentPage inherits VerticalLayout {
    in property <AgentForm> agent;
    in property <[string]> models;
    in property <string> detect-status;
    in property <string> test-status;
    callback detect-api(string, string);
    callback save-agent(AgentForm);
    callback test-agent(AgentForm);
    callback remove-agent();
    callback filter-models(string);
    // Models that can see pictures, for the picture model.
    in property <[string]> image-models;
    callback filter-image-models(string);
    // The service's recommended models, filled in when nothing is picked.
    in property <string> default-model;
    in property <string> default-image-model;
    in property <image> card-picture;
    callback card-action(string, AgentForm);

    property <bool> a-enabled: agent.enabled;
    property <bool> a-greet: agent.greet;
    // Card fields follow the form whenever Rust replaces it (an import),
    // even after being edited.
    property <bool> a-has-card: agent.has-card;
    property <string> c-name: agent.card-name;
    property <string> c-nickname: agent.card-nickname;
    property <string> c-description: agent.card-description;
    property <string> c-personality: agent.card-personality;
    property <string> c-scenario: agent.card-scenario;
    property <string> c-first: agent.card-first-mes;
    property <string> c-greetings: agent.card-greetings;
    property <string> c-examples: agent.card-examples;
    property <string> c-system: agent.card-system;
    property <string> c-post: agent.card-post;
    property <string> c-tags: agent.card-tags;
    property <string> c-creator: agent.card-creator;
    property <string> c-notes: agent.card-notes;
    changed agent => {
        root.a-has-card = root.agent.has-card;
        root.c-name = root.agent.card-name;
        root.c-nickname = root.agent.card-nickname;
        root.c-description = root.agent.card-description;
        root.c-personality = root.agent.card-personality;
        root.c-scenario = root.agent.card-scenario;
        root.c-first = root.agent.card-first-mes;
        root.c-greetings = root.agent.card-greetings;
        root.c-examples = root.agent.card-examples;
        root.c-system = root.agent.card-system;
        root.c-post = root.agent.card-post;
        root.c-tags = root.agent.card-tags;
        root.c-creator = root.agent.card-creator;
        root.c-notes = root.agent.card-notes;
    }
    property <string> a-url: agent.url;
    property <string> a-key;
    property <string> a-model: agent.model;
    property <int> a-max-tokens: agent.max-tokens;
    property <string> a-extra: agent.extra-json;
    property <int> a-trigger: agent.trigger;
    property <string> a-prompt: agent.system-prompt;
    property <string> a-rooms: agent.rooms;
    property <int> a-history: agent.history;
    property <bool> a-summarize: agent.summarize;
    property <string> a-summary-model: agent.summary-model;
    property <int> a-context: agent.context-tokens;
    property <int> a-yield: agent.yield-secs;
    property <int> a-rapid: agent.max-rapid;
    property <bool> a-venice-prompt: agent.venice-system-prompt;
    property <bool> a-venice-search: agent.venice-web-search;
    property <bool> a-see-images: agent.see-images;
    property <string> a-image-model: agent.image-model;
    property <int> a-reply-chars: agent.reply-chars;
    property <int> a-cooldown: agent.cooldown;
    property <int> a-steps: agent.max-steps;
    property <bool> a-reply: agent.g-reply;
    property <bool> a-redact: agent.g-redact;
    property <bool> a-kick: agent.g-kick;
    property <bool> a-ban: agent.g-ban;
    property <bool> a-unban: agent.g-unban;
    property <bool> a-invite: agent.g-invite;
    property <bool> a-power: agent.g-power;
    property <string> a-commanders: agent.commanders;
    property <int> a-min-level: agent.min-level;
    property <bool> a-autonomous: agent.autonomous;
    property <int> a-max-grant: agent.max-grant;
    property <string> a-protected: agent.protected;
    property <string> a-audit: agent.audit-room;
    function fill-defaults() {
        if root.a-model == "" && root.default-model != "" {
            root.a-model = root.default-model;
        }
        if root.a-image-model == "" && root.default-image-model != "" && ModelInfo.sees(root.a-model, root.image-models.length) == 2 {
            root.a-image-model = root.default-image-model;
        }
    }
    init => { root.fill-defaults(); }
    changed default-model => { root.fill-defaults(); }
    changed default-image-model => { root.fill-defaults(); }

    function form() -> AgentForm {
        return {
            account: root.agent.account, exists: root.agent.exists, enabled: root.a-enabled, name: root.agent.name,
            url: root.a-url, api-key-set: root.agent.api-key-set, api-key: root.a-key, model: root.a-model,
            service: root.agent.service, max-tokens: root.a-max-tokens, extra-json: root.a-extra,
            trigger: root.a-trigger, system-prompt: root.a-prompt, rooms: root.a-rooms, history: root.a-history,
            summarize: root.a-summarize, summary-model: root.a-summary-model, context-tokens: root.a-context,
            cooldown: root.a-cooldown, max-steps: root.a-steps, yield-secs: root.a-yield, max-rapid: root.a-rapid,
            venice-system-prompt: root.a-venice-prompt, venice-web-search: root.a-venice-search,
            see-images: root.a-see-images, image-model: root.a-image-model, reply-chars: root.a-reply-chars,
            g-reply: root.a-reply, g-redact: root.a-redact, g-kick: root.a-kick, g-ban: root.a-ban,
            g-unban: root.a-unban, g-invite: root.a-invite, g-power: root.a-power,
            commanders: root.a-commanders, min-level: root.a-min-level, autonomous: root.a-autonomous,
            max-grant: root.a-max-grant, protected: root.a-protected, audit-room: root.a-audit,
            has-card: root.a-has-card, greet: root.a-greet, card-name: root.c-name, card-nickname: root.c-nickname,
            card-description: root.c-description, card-personality: root.c-personality, card-scenario: root.c-scenario,
            card-first-mes: root.c-first, card-greetings: root.c-greetings, card-examples: root.c-examples,
            card-system: root.c-system, card-post: root.c-post, card-tags: root.c-tags, card-creator: root.c-creator,
            card-notes: root.c-notes, card-lore: root.agent.card-lore,
        };
    }

    spacing: 14px;

    Card {
        title: root.agent.name;
        subtitle: root.agent.exists ? "Changes take effect when you save; the AI restarts with them." : "This AI account has no model yet. Connect one below and save.";
        Toggle { text: "Running"; hint: "Turn off to keep the account logged in but silent."; checked <=> root.a-enabled; }
    }

    Card {
        title: "AI API";
        subtitle: "Paste the address of any AI API: OpenAI-style (Venice at api.venice.ai, OpenRouter, Groq, Mistral, DeepSeek, Gemini, LM Studio, llama.cpp, vLLM…), Anthropic-style, or Ollama. Whisker works out which kind it is.";
        Field { label: "API address"; Input { text <=> root.a-url; placeholder: "e.g. openrouter.ai/api   or   localhost:11434"; } }
        Field {
            label: "API key";
            hint: root.agent.api-key-set ? "A key is saved. Leave empty to keep it." : "Leave empty for local servers that don't need one.";
            Input { text <=> root.a-key; password: true; placeholder: root.agent.api-key-set ? "••••••••  (saved)" : "Key"; }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Btn { text: "Connect"; enabled: root.a-url != ""; clicked => { root.detect-api(root.a-url, root.a-key); } }
            Text { text: root.detect-status; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
        Field {
            label: "Model";
            hint: root.models.length == 0 ? "Press Connect to list the service's models, or type a name in the box." : "";
            ModelPicker {
                models: root.models;
                value <=> root.a-model;
                placeholder: "Pick a model";
                search(q) => { root.filter-models(q); }
            }
            if root.default-model != "" && root.a-model != root.default-model: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Recommended: " + root.default-model;
                    font-size: 11px; color: Theme.muted; vertical-alignment: center;
                }
                Btn { text: "Use it"; clicked => { root.a-model = root.default-model; } }
            }
        }
        Number { text: "Longest reply (tokens)"; minimum: 64; maximum: 32000; value <=> root.a-max-tokens; }
        Number { text: "Longest reply posted (characters, 0 = no limit)"; minimum: 0; maximum: 20000; value <=> root.a-reply-chars; }
        Toggle { text: "Let the AI see pictures posted in the room"; checked <=> root.a-see-images; }
        Text {
            text: "Sends recent pictures (shrunk) to the AI service with each reply, and a picture someone replies to.";
            font-size: 11px; color: Theme.muted; wrap: word-wrap;
        }
        if root.a-see-images: Field {
            label: "Picture model";
            hint: ModelInfo.sees(root.a-model, root.image-models.length) == 1
                ? "✓ " + root.a-model + " can see pictures itself, so this can stay on \"None\". Pick one only to have a different model describe pictures for it."
                : ModelInfo.sees(root.a-model, root.image-models.length) == 2
                ? "⚠ " + root.a-model + " can't see pictures. Pick a model here that can: it describes each picture in words for the chat model."
                : "A model that can see pictures describes each one in words for the chat model. Not needed if the chat model can see.";
            ModelPicker {
                models: root.image-models;
                value <=> root.a-image-model;
                placeholder: "None: the chat model looks itself";
                none-text: "None: the chat model looks itself";
                empty-text: root.models.length == 0 ? "Press Connect above to list the service's models." : "None of this service's models say they can see pictures. Type a name and press Enter.";
                search(q) => { root.filter-image-models(q); }
            }
            if root.default-image-model != "" && root.a-image-model != root.default-image-model
                && ModelInfo.sees(root.a-model, root.image-models.length) == 2: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Recommended: " + root.default-image-model;
                    font-size: 11px; color: Theme.muted; vertical-alignment: center;
                }
                Btn { text: "Use it"; clicked => { root.a-image-model = root.default-image-model; } }
            }
        }
        Text {
            text: "Venice only (api.venice.ai). Both stay off unless you turn them on.";
            font-size: 11px; color: Theme.muted; wrap: word-wrap;
        }
        Toggle { text: "Venice: add Venice's own system prompt"; checked <=> root.a-venice-prompt; }
        Toggle { text: "Venice: web search (sends chat messages to a third-party search engine)"; checked <=> root.a-venice-search; }
        Field {
            label: "Extra request settings (JSON, optional)";
            hint: "Merged into every request, for whatever this API supports, e.g. {\"temperature\": 0.7}";
            TextEdit { text <=> root.a-extra; height: 60px; font-size: 12px; }
        }
    }

    Card {
        title: "Character card";
        subtitle: root.a-has-card
            ? "The AI plays this character. Its system prompt can include your instructions below with {{original}}; {{char}} and {{user}} are filled in."
            : "Import a character card (.png or .json; Tavern / SillyTavern cards, versions 1 to 3) to have the AI play that character.";
        if root.a-has-card: HorizontalLayout {
            spacing: 14px;
            if root.card-picture.width > 0: Rectangle {
                width: 96px;
                height: 128px;
                border-radius: 10px;
                clip: true;
                background: Theme.raised;
                Image { source: root.card-picture; width: parent.width; height: parent.height; image-fit: cover; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: root.c-name; font-size: 18px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                if root.c-creator != "": Text { text: "by " + root.c-creator; font-size: 12px; color: Theme.muted; }
                if root.c-tags != "": Text { text: root.c-tags; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                if root.agent.card-lore != "": Text { text: root.agent.card-lore; font-size: 11px; color: Theme.muted; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn { text: root.a-has-card ? "Import another…" : "Import card…"; primary: !root.a-has-card; clicked => { root.card-action("import", root.form()); } }
            if root.a-has-card: Btn { text: "Export .png"; clicked => { root.card-action("export-png", root.form()); } }
            if root.a-has-card: Btn { text: "Export .json"; clicked => { root.card-action("export-json", root.form()); } }
            if root.a-has-card: Btn { text: "Remove"; danger: true; clicked => { root.card-action("remove", root.form()); } }
        }
        if root.a-has-card: Btn {
            text: "Use the card's name and picture for this account";
            clicked => { root.card-action("use-profile", root.form()); }
        }
        if root.a-has-card: Toggle { text: "Greet with the first message when joining a room"; checked <=> root.a-greet; }
        if root.a-has-card: Field { label: "Name"; Input { text <=> root.c-name; } }
        if root.a-has-card: Field { label: "Nickname (optional, used for {{char}})"; Input { text <=> root.c-nickname; } }
        if root.a-has-card: Field { label: "Description"; TextEdit { text <=> root.c-description; height: 120px; wrap: word-wrap; } }
        if root.a-has-card: Field { label: "Personality"; TextEdit { text <=> root.c-personality; height: 60px; wrap: word-wrap; } }
        if root.a-has-card: Field { label: "Scenario"; TextEdit { text <=> root.c-scenario; height: 60px; wrap: word-wrap; } }
        if root.a-has-card: Field { label: "First message"; TextEdit { text <=> root.c-first; height: 80px; wrap: word-wrap; } }
        if root.a-has-card: Field {
            label: "Other greetings";
            hint: "Kept with the card. Separate them with a line holding just ---";
            TextEdit { text <=> root.c-greetings; height: 60px; wrap: word-wrap; }
        }
        if root.a-has-card: Field { label: "Example messages"; TextEdit { text <=> root.c-examples; height: 80px; wrap: word-wrap; } }
        if root.a-has-card: Field { label: "Card system prompt (optional)"; hint: "Replaces your instructions below; put {{original}} where they should go."; TextEdit { text <=> root.c-system; height: 60px; wrap: word-wrap; } }
        if root.a-has-card: Field { label: "Instructions after the chat (optional)"; TextEdit { text <=> root.c-post; height: 50px; wrap: word-wrap; } }
        if root.a-has-card: Field { label: "Tags"; Input { text <=> root.c-tags; placeholder: "comma separated"; } }
        if root.a-has-card: Field { label: "Creator"; Input { text <=> root.c-creator; } }
        if root.a-has-card: Field { label: "Creator's notes (not sent to the AI)"; TextEdit { text <=> root.c-notes; height: 50px; wrap: word-wrap; } }
    }

    Card {
        title: "Behaviour";
        Field { label: "Personality and instructions"; TextEdit { text <=> root.a-prompt; height: 100px; wrap: word-wrap; } }
        Field {
            label: "When it answers";
            ComboBox { model: ["When mentioned, and in DMs", "Reads every message", "Only in DMs"]; current-index <=> root.a-trigger; }
        }
        Field { label: "Only in these rooms"; hint: "Room ids, comma separated. Empty means every room it's in."; Input { text <=> root.a-rooms; placeholder: "All rooms"; } }
        Number { text: "Seconds between replies"; hint: "Per room, to stop it flooding."; minimum: 0; maximum: 3600; value <=> root.a-cooldown; }
        Number { text: "Actions per message"; hint: "How many tool steps it may take before answering. If it runs out mid-action, it posts nothing."; minimum: 1; maximum: 20; value <=> root.a-steps; }
    }

    Card {
        title: "Memory";
        subtitle: "What it remembers of each room, saved in this vault so restarts don't wipe it.";
        Number { text: "Messages kept word for word"; hint: "Per room. Older ones are folded into the summary (or dropped)."; minimum: 2; maximum: 200; value <=> root.a-history; }
        Toggle { text: "Summarise older messages"; checked <=> root.a-summarize; }
        Field { label: "Model for summaries"; hint: "Same API. Leave empty to use the chat model; a cheaper one works well."; Input { text <=> root.a-summary-model; placeholder: "Same as the chat model"; } }
        Number { text: "Prompt budget (tokens)"; hint: "Roughly how much summary and transcript it sends each time; newest messages win."; minimum: 500; maximum: 200000; value <=> root.a-context; }
    }

    Card {
        title: "Bot loops";
        subtitle: "It never answers your other AI accounts or bot notices. Against other bots, it drops out of rapid back-and-forth until the room goes quiet.";
        Number { text: "Quiet gap (seconds)"; hint: "Messages closer together than this count as a rapid exchange."; minimum: 1; maximum: 600; value <=> root.a-yield; }
        Number { text: "Rapid replies before waiting"; hint: "How many quick replies in a row before it waits for a quiet gap."; minimum: 1; maximum: 50; value <=> root.a-rapid; }
    }

    Card {
        title: "Permissions";
        subtitle: "Moderation actions are only offered to the AI when a commander asks, unless autonomous mode is on. It can never act against your own accounts.";
        Toggle { text: "Post replies"; checked <=> root.a-reply; }
        Toggle { text: "Delete messages"; checked <=> root.a-redact; }
        Toggle { text: "Kick"; checked <=> root.a-kick; }
        Toggle { text: "Ban"; checked <=> root.a-ban; }
        Toggle { text: "Unban"; checked <=> root.a-unban; }
        Toggle { text: "Invite"; checked <=> root.a-invite; }
        Toggle { text: "Change power levels"; checked <=> root.a-power; }
        if root.a-power: Number { text: "Highest level it may give"; value <=> root.a-max-grant; }
    }

    Card {
        title: "Who can give it orders";
        Number { text: "Room members at or above power level"; value <=> root.a-min-level; }
        Field { label: "Plus these users"; Input { text <=> root.a-commanders; placeholder: "e.g. @you:anoncat.org"; } }
        Toggle { text: "Autonomous moderation"; hint: "Lets it use its permissions on its own judgement, e.g. against spam."; checked <=> root.a-autonomous; }
        Field { label: "Never act against"; Input { text <=> root.a-protected; placeholder: "e.g. @friend:anoncat.org"; } }
        Field { label: "Audit room"; hint: "Every moderation action is posted here."; Input { text <=> root.a-audit; placeholder: "None, e.g. !abc:anoncat.org"; } }
    }

    if root.test-status != "": Rectangle {
        background: Theme.raised;
        border-radius: 10px;
        HorizontalLayout { padding: 12px; Text { text: root.test-status; wrap: word-wrap; color: Theme.text; } }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Btn { text: root.agent.exists ? "Save" : "Save and start"; primary: true; clicked => { root.save-agent(root.form()); root.a-key = ""; } }
        Btn { text: "Test"; clicked => { root.test-agent(root.form()); } }
        if root.agent.exists: Btn { text: "Remove AI setup"; danger: true; clicked => { root.remove-agent(); } }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> narrow;
    in-out property <int> theme;
    in-out property <int> auto-lock;
    in property <[NavItem]> nav;
    in-out property <string> selected;
    in property <AccountForm> account;
    in property <AgentForm> agent;
    in property <[string]> models;
    in-out property <string> message;
    in-out property <string> detect-status;
    in-out property <string> test-status;
    in property <string> encryption-summary;

    callback close();
    callback navigate(string);
    callback set-theme(int);
    callback set-auto-lock(int);
    callback set-rich-text(bool);
    callback set-show-events(bool);
    callback set-notify-level(int);
    callback set-send-typing(bool);
    callback set-clear-command(string);
    callback set-autocorrect(bool);
    callback set-spell-check(bool);
    callback set-link-posters(bool);
    callback set-ask-file-servers(bool);
    callback set-ask-room-servers(bool);
    // An upload setting changed: (key, value; switches are 0 or 1).
    callback set-upload(string, int);
    callback set-menu-entry(string, bool);
    callback save-account(AccountForm);
    callback profile-edit(string, string, string);
    callback recover(string);
    callback logout(string);
    callback new-ai();
    callback detect-api(string, string);
    callback save-agent(AgentForm);
    callback test-agent(AgentForm);
    callback remove-agent();
    in property <image> card-picture;
    callback card-action(string, AgentForm);
    callback filter-models(string);
    // Models that can see pictures, for the picture model.
    in property <string> default-model;
    in property <string> default-image-model;
    in property <[string]> image-models;
    callback filter-image-models(string);
    callback change-passphrase(string, string);
    callback unlock-hidden(string);
    callback create-hidden(string);

    // On phones the sidebar and the page take turns.
    property <bool> show-nav: !narrow || selected == "";
    property <bool> show-page: !narrow || selected != "";

    background: Theme.bg;

    HorizontalLayout {
        if root.show-nav: Rectangle {
            width: root.narrow ? root.width : 250px;
            background: Theme.panel;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    height: 44px;
                    IconBtn { icon: "‹"; clicked => { root.close(); } }
                    Text { text: "Settings"; font-size: 18px; font-weight: 800; vertical-alignment: center; color: Theme.text; }
                }
                for n[i] in root.nav: VerticalLayout {
                    if i == 0 || root.nav[i - 1].section != n.section: Text {
                        text: n.section == "" ? "" : n.section;
                        height: n.section == "" ? 0px : 28px;
                        vertical-alignment: bottom;
                        font-size: 10px; font-weight: 800; color: Theme.muted; letter-spacing: 1px;
                    }
                    NavRow { item: n; selected: n.id == root.selected; clicked => { root.navigate(n.id); } }
                }
                Rectangle { height: 6px; }
                Btn { text: "+ Add an AI"; clicked => { root.new-ai(); } }
                Rectangle { vertical-stretch: 1; }
            }
        }
        if root.show-nav && root.show-page: Rectangle { width: 1px; background: Theme.border; }
        if root.show-page: VerticalLayout {
            horizontal-stretch: 1;
            if root.narrow: HorizontalLayout {
                padding: 8px;
                IconBtn { icon: "‹"; clicked => { root.selected = ""; } }
            }
            if root.message != "": Rectangle {
                background: Theme.accent-soft;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 16px;
                    Text { text: root.message; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
                    IconBtn { icon: "✕"; size: 24px; clicked => { root.message = ""; } }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(640px, root.width - (root.narrow ? 24px : 290px));
                        padding-top: 18px;
                        padding-bottom: 40px;
                        if root.selected == "general" || root.selected == "": GeneralPage {
                            theme <=> root.theme;
                            auto-lock <=> root.auto-lock;
                            encryption-summary: root.encryption-summary;
                            set-theme(t) => { root.set-theme(t); }
                            set-auto-lock(i) => { root.set-auto-lock(i); }
                            set-rich-text(b) => { root.set-rich-text(b); }
                            set-show-events(b) => { root.set-show-events(b); }
                            set-notify-level(i) => { root.set-notify-level(i); }
                            set-send-typing(b) => { root.set-send-typing(b); }
                            set-clear-command(t) => { root.set-clear-command(t); }
                            set-autocorrect(b) => { root.set-autocorrect(b); }
                            set-spell-check(b) => { root.set-spell-check(b); }
                            set-link-posters(b) => { root.set-link-posters(b); }
                            set-ask-file-servers(b) => { root.set-ask-file-servers(b); }
                            set-ask-room-servers(b) => { root.set-ask-room-servers(b); }
                            set-upload(k, v) => { root.set-upload(k, v); }
                            set-menu-entry(k, b) => { root.set-menu-entry(k, b); }
                            change-passphrase(o, n) => { root.change-passphrase(o, n); }
                            unlock-hidden(p) => { root.unlock-hidden(p); }
                            create-hidden(p) => { root.create-hidden(p); }
                            new-ai => { root.new-ai(); }
                        }
                        if root.selected != "" && root.account.id != "" && root.selected == "account:" + root.account.id: AccountPage {
                            account: root.account;
                            save-account(f) => { root.save-account(f); }
                            profile-edit(a, id, v) => { root.profile-edit(a, id, v); }
                            recover(k) => { root.recover(k); }
                            logout(id) => { root.logout(id); }
                        }
                        if root.selected != "" && root.agent.account != "" && root.selected == "ai:" + root.agent.account: AgentPage {
                            agent: root.agent;
                            models: root.models;
                            image-models: root.image-models;
                            default-model: root.default-model;
                            default-image-model: root.default-image-model;
                            detect-status: root.detect-status;
                            test-status: root.test-status;
                            detect-api(u, k) => { root.detect-api(u, k); }
                            save-agent(f) => { root.save-agent(f); }
                            test-agent(f) => { root.test-agent(f); }
                            remove-agent => { root.remove-agent(); }
                            card-picture: root.card-picture;
                            card-action(a, f) => { root.card-action(a, f); }
                            filter-models(q) => { root.filter-models(q); }
                            filter-image-models(q) => { root.filter-image-models(q); }
                        }
                    }
                }
            }
        }
    }
}
