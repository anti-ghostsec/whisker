[Desktop Entry]
Type=Application
Name=Whisker
GenericName=Matrix chat
Comment=Chat on Matrix with all your accounts at once
Exec=whisker %F
Icon=whisker
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=matrix;chat;messages;
# Files and text from the Share box: Whisker asks which account and room.
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/svg+xml;image/avif;image/heic;image/tiff;video/mp4;video/webm;video/quicktime;video/x-matroska;video/x-msvideo;audio/mpeg;audio/ogg;audio/opus;audio/flac;audio/x-wav;audio/mp4;application/pdf;application/zip;text/plain;text/markdown;text/html;text/csv;application/octet-stream;
StartupNotify=true
